+{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor p in ['src/ovcaq/tui/panels.py','tests/tui/test_rework_activity.py','docs/driver-protocol.md']:\n a=Path(p).read_text().splitlines(); print('FILE '+p);print('\\\\n'.join(a if p.endswith('.py') else a[318:350]))\nPY\"","aggregated_output":"FILE src/ovcaq/tui/panels.py\n\"\"\"Render project views as literal, bounded Rich renderables.\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\nfrom typing import TYPE_CHECKING\n\nfrom ovcaq.tui.discovery import FleetView\nfrom ovcaq.tui.model import ProjectView, UsageView, display_text\n\n# Rich loads lazily so the module imports without its runtime dependencies.\nif TYPE_CHECKING:\n    from rich.console import Group\n    from rich.panel import Panel\n    from rich.table import Table\n\n\ndef _known(value: object) -> str:\n    return \"unknown\" if value is None else display_text(str(value))\n\n\ndef _panel(title: str, lines: list[str]) -> Panel:\n    from rich.panel import Panel\n    from rich.text import Text\n\n    # Text keeps dynamic values literal; Rich markup is never parsed.\n    return Panel(Text(\"\\n\".join(lines)), title=title)\n\n\ndef _usage(usage: UsageView | None) -> str:\n    if usage is None:\n        return \"unknown\"\n    text = (\n        f\"in {_known(usage.input_tokens)}, out {_known(usage.output_tokens)}, \"\n        f\"cache write {_known(usage.cache_creation_input_tokens)}, \"\n        f\"cache read {_known(usage.cache_read_input_tokens)}, \"\n        f\"tools {_known(usage.tool_uses)}, cost {_known(usage.cost_usd)}\"\n    )\n    return (\n        text\n        + (\" (estimated)\" if usage.estimated else \"\")\n        + (\" (partial)\" if usage.partial else \"\")\n    )\n\n\ndef fleet_table(view: FleetView) -> Table:\n    from rich.table import Table\n    from rich.text import Text\n\n    table = Table(title=\"Fleet\")\n    for column in (\"run\", \"agent\", \"root\", \"started\", \"pid\"):\n        table.add_column(column)\n    for run in view.runs:\n        values = (run.run_id, run.agent, str(run.root), run.started_at, str(run.pid))\n        table.add_row(*(Text(display_text(value)) for value in values))\n    return table\n\n\ndef workflow_panel(view: ProjectView) -> Panel:\n    duration = view.duration_seconds\n    return _panel(\n        \"Workflow\",\n        [\n            f\"status: {display_text(view.status)}\",\n            f\"phase: {_known(view.phase)} -> {_known(view.next_phase)}\",\n            f\"prd: {_known(view.prd)}\",\n            f\"revision: {_known(view.revision)}\",\n            f\"agent: {display_text(view.run.agent)}\",\n            f\"provider: {display_text(view.provider)}\",\n            f\"duration: {'unknown' if duration is None else f'{duration:.0f}s'}\",\n            f\"usage: {_usage(view.usage)}\",\n            f\"telemetry: {display_text(view.telemetry)}\",\n        ],\n    )\n\n\ndef tasks_panel(view: ProjectView) -> Panel:\n    completed, total = _known(view.tasks_completed), _known(view.tasks_total)\n    return _panel(\"Tasks\", [f\"{completed} / {total} completed\"])\n\n\ndef review_panel(view: ProjectView) -> Panel:\n    return _panel(\"Review\", [f\"cycle: {_known(view.review_cycle)}\"])\n\n\ndef activity_panel(view: ProjectView) -> Panel:\n    lines = [\n        display_text(item.label)\n        + (\"\" if item.status is None else f\": {display_text(item.status)}\")\n        + (\"\" if item.detail is None else f\" - {display_text(item.detail)}\")\n        for item in reversed(view.activity[-20:])\n    ]\n    lines.extend(\n        [\n            f\"{display_text(lane.label)}: {display_text(lane.status)}\"\n            + (\"\" if lane.detail is None else f\" - {display_text(lane.detail)}\")\n            for lane in view.lanes[:20]\n        ]\n        or [\"no lanes observed\"]\n    )\n    if len(view.activity) > 20:\n        lines.append(f\"{len(view.activity) - 20} activity entries omitted\")\n    if len(view.lanes) > 20:\n        lines.append(f\"{len(view.lanes) - 20} lanes omitted\")\n    return _panel(\"Activity\", lines)\n\n\ndef capability_panel(view: ProjectView) -> Panel:\n    lines = []\n    for capability in view.capabilities:\n        need = \"required\" if capability.required else \"optional\"\n        lines.append(\n            f\"{display_text(capability.name)}: {capability.status}, {need}\"\n            + (\n                \"\"\n                if capability.detail is None\n                else f\" - {display_text(capability.detail)}\"\n            )\n        )\n        if capability.evidence_path is not None:\n            lines.append(f\"  evidence: {display_text(str(capability.evidence_path))}\")\n        if capability.retry_command is not None:\n            command = shlex.join(\n                display_text(part) for part in capability.retry_command\n            )\n            lines.append(f\"  retry: {command}\")\n    return _panel(\"Capabilities\", lines or [\"none\"])\n\n\ndef plain_frame(view: ProjectView) -> Group:\n    from rich.console import Group\n    from rich.text import Text\n\n    header = [f\"status: {display_text(view.status)}\"]\n    if view.attention is not None:\n        site = display_text(view.attention[\"site\"])\n        header.append(f\"attention: {site}: {display_text(view.attention['detail'])}\")\n    header.extend(f\"gap: {display_text(gap)}\" for gap in view.gaps)\n    return Group(\n        Text(\"\\n\".join(header)),\n        workflow_panel(view),\n        tasks_panel(view),\n        review_panel(view),\n        activity_panel(view),\n        capability_panel(view),\n    )\nFILE tests/tui/test_rework_activity.py\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import replace\nfrom datetime import UTC, datetime\nfrom io import StringIO\nfrom pathlib import Path\n\nimport pytest\nfrom rich.console import Console\n\nfrom ovcaq.config import AgentSettings\nfrom ovcaq.drivers.claude import ClaudeDriver\nfrom ovcaq.drivers.codex import CodexDriver\nfrom ovcaq.events.model import Observation, ObservationType\nfrom ovcaq.events.tail import TailBatch\nfrom ovcaq.tui.panels import activity_panel\n\nfrom . import test_model\nfrom .model_support import Projection\n\nprojection = test_model.projection\nFIXTURES = Path(__file__).parents[1] / \"fixtures\"\n\n\ndef _decoder(provider: str) -> ClaudeDriver | CodexDriver:\n    settings = AgentSettings(\n        name=provider,\n        command=(\"unused\",),\n        tiers={\"standard\": \"fixture-model\"},\n        environment={},\n        options={\"permission_mode\": \"auto\"} if provider == \"claude\" else {},\n    )\n    driver = ClaudeDriver if provider == \"claude\" else CodexDriver\n    return driver(settings, run_id=\"run-1\")\n\n\ndef _decoded_tools(\n    decoder: ClaudeDriver | CodexDriver, frame: dict[str, object]\n) -> tuple[Observation, ...]:\n    return tuple(\n        replace(event, session_id=\"session-1\", lane_id=None)\n        for event in decoder.decode(json.dumps(frame))\n        if event.type.value.startswith(\"tool.\")\n    )\n\n\ndef _event(\n    provider: str,\n    kind: str,\n    payload: dict[str, object],\n    *,\n    session: str = \"session-1\",\n    lane: str | None = None,\n) -> Observation:\n    return Observation(\n        protocol_version=1,\n        timestamp=datetime(2026, 10, 3, 10, tzinfo=UTC),\n        provider=provider,\n        run_id=\"run-1\",\n        session_id=session,\n        lane_id=lane,\n        type=ObservationType(kind),\n        payload=payload,\n    )\n\n\ndef _render(projection: Projection, *events: Observation) -> str:\n    projection.batches.append(TailBatch(events, (), False, False, True))\n    stream = StringIO()\n    Console(file=stream, width=240, color_system=None, force_terminal=False).print(\n        activity_panel(projection.poll())\n    )\n    return stream.getvalue()\n\n\n@pytest.mark.parametrize(\n    \"started_line,terminal_line\",\n    [(2, 3), (2, 4), (6, 7), (6, 8), (9, 10), (9, 11), (12, 13)],\n    ids=[\n        \"command-completed\",\n        \"command-failed\",\n        \"file-completed\",\n        \"file-failed\",\n        \"remote-completed\",\n        \"remote-failed\",\n        \"web-completed\",\n    ],\n)\ndef test_activity_displays_decoded_codex_tools_without_lanes(\n    projection: Projection, started_line: int, terminal_line: int\n) -> None:\n    lines = (FIXTURES / \"codex\" / \"v1\" / \"tool-active.jsonl\").read_text().splitlines()\n    start_frame = json.loads(lines[started_line])\n    start_frame[\"type\"] = \"item.started\"\n    terminal_frame = json.loads(lines[terminal_line])\n    terminal_frame[\"item\"][\"id\"] = start_frame[\"item\"][\"id\"]\n    decoder = _decoder(\"codex\")\n    (started,) = _decoded_tools(decoder, start_frame)\n    rendered = _render(projection, started)\n    assert str(started.payload[\"name\"]) in rendered\n    assert started.type == ObservationType.TOOL_STARTED\n    assert projection.poll().activity[0].status == \"started\"\n    assert \"started\" in rendered\n    if started_line == 2:\n        assert projection.poll().activity[0].detail == \"printf example\"\n        assert \"printf example\" in rendered\n        assert \"\\n\" not in projection.poll().activity[0].detail\n    elif started.payload.get(\"detail\"):\n        assert projection.poll().activity[0].detail == started.payload[\"detail\"]\n        assert str(started.payload[\"detail\"]) in rendered\n    (terminal,) = _decoded_tools(decoder, terminal_frame)\n\n    rendered = _render(projection, terminal)\n\n    assert str(started.payload[\"name\"]) in rendered\n    assert terminal.type.value.removeprefix(\"tool.\") in rendered\n    assert len(projection.poll().activity) == 1\n    if terminal.payload.get(\"detail\"):\n        detail = projection.poll().activity[0].detail\n        if started_line == 2:\n            assert detail == \"printf exampleexample\"\n            assert \"printf exampleexample\" in rendered\n            assert \"\\n\" not in detail\n        else:\n            assert detail == terminal.payload[\"detail\"]\n        for line in str(terminal.payload[\"detail\"]).splitlines():\n            assert line in rendered\n\n\ndef test_decoded_terminal_tool_name_replaces_previous_name_for_same_id(\n    projection: Projection,\n) -> None:\n    lines = (FIXTURES / \"codex\" / \"v1\" / \"tool-active.jsonl\").read_text().splitlines()\n    start_frame = json.loads(lines[2])\n    terminal_frame = json.loads(lines[13])\n    terminal_frame[\"item\"][\"id\"] = start_frame[\"item\"][\"id\"]\n    decoder = _decoder(\"codex\")\n    (started,) = _decoded_tools(decoder, start_frame)\n    (terminal,) = _decoded_tools(decoder, terminal_frame)\n    assert started.payload[\"name\"] != terminal.payload[\"name\"]\n    _render(projection, started)\n\n    rendered = _render(projection, terminal)\n\n    activity = projection.poll().activity\n    assert len(activity) == 1\n    assert activity[0].label == terminal.payload[\"name\"]\n    assert activity[0].status == \"completed\"\n    assert str(terminal.payload[\"name\"]) in rendered\n\n\n@pytest.mark.parametrize(\"is_error\", [False, True])\ndef test_activity_displays_decoded_claude_tools_without_inventing_input(\n    projection: Projection, is_error: bool\n) -> None:\n    lines = (FIXTURES / \"claude\" / \"v1\" / \"healthy.jsonl\").read_text().splitlines()\n    decoder = _decoder(\"claude\")\n    (started,) = _decoded_tools(decoder, json.loads(lines[1]))\n\n    rendered = _render(projection, started)\n\n    assert \"Read\" in rendered\n    assert projection.poll().activity[0].status == \"started\"\n    assert \"started\" in rendered\n    assert \"/sanitized/example\" not in rendered\n    assert projection.poll().activity[0].detail is None\n    terminal_frame = json.loads(lines[2])\n    terminal_frame[\"message\"][\"content\"][0][\"is_error\"] = is_error\n    (terminal,) = _decoded_tools(decoder, terminal_frame)\n\n    rendered = _render(projection, terminal)\n\n    assert \"Read\" in rendered\n    assert \"Fixture tool completed.\" in rendered\n    assert (\"failed\" if is_error else \"completed\") in rendered\n    assert len(projection.poll().activity) == 1\n\n\n@pytest.mark.parametrize(\"provider\", [\"codex\", \"claude\"])\n@pytest.mark.parametrize(\"kind\", [\"text\", \"thinking\", \"error\"])\ndef test_activity_displays_literal_messages_without_lanes(\n    projection: Projection, provider: str, kind: str\n) -> None:\n    text = f\"{kind} [bold]literal fixture[/bold]\"\n    event = _event(\n        provider,\n        \"activity.message\",\n        {\"kind\": kind, \"text\": text, \"message_id\": \"message-1\"},\n    )\n\n    rendered = _render(projection, event)\n\n    assert text in rendered\n    assert projection.poll().activity[0].label == kind\n\n\ndef test_activity_displays_decoded_codex_plan_updates_without_lanes(\n    projection: Projection,\n) -> None:\n    lines = (FIXTURES / \"codex\" / \"v1\" / \"tool-active.jsonl\").read_text().splitlines()\n    decoder = _decoder(\"codex\")\n    pending_frame = json.loads(lines[20])\n    completed_frame = json.loads(lines[21])\n    pending_frame[\"item\"][\"items\"].extend(\n        [\n            {\"text\": \"Verify additional fixture\", \"completed\": False},\n            {\"text\": \"Finish final fixture\", \"completed\": False},\n        ]\n    )\n    completed_frame[\"item\"][\"items\"].extend(\n        [\n            {\"text\": \"Verify additional fixture\", \"completed\": True},\n            {\"text\": \"Finish final fixture\", \"completed\": False},\n        ]\n    )\n    pending = tuple(\n        replace(event, session_id=\"session-1\")\n        for event in decoder.decode(json.dumps(pending_frame))\n    )\n    completed = tuple(\n        replace(event, session_id=\"session-1\")\n        for event in decoder.decode(json.dumps(completed_frame))\n    )\n\n    assert \"pending: Inspect example\" in _render(projection, *pending)\n    rendered = _render(projection, *completed)\n    expected = \"done: Inspect example / done: Verify additional fixture / pending: Finish final fixture\"\n    assert expected in rendered\n    assert projection.poll().activity[0].detail == expected\n    assert projection.poll().activity[0].label == \"plan\"\n    assert len(projection.poll().activity) == 1\n\n\n@pytest.mark.parametrize(\"provider\", [\"codex\", \"claude\"])\ndef test_activity_displays_plan_steps_without_lanes(\n    projection: Projection, provider: str\n) -> None:\n    event = _event(\n        provider,\n        \"activity.message\",\n        {\n            \"kind\": \"plan\",\n            \"message_id\": \"plan-1\",\n            \"items\": [\n                {\"text\": \"Inspect [bold]literal[/bold] fixture\", \"completed\": True},\n                {\"text\": \"Verify remaining fixture\", \"completed\": False},\n            ],\n        },\n    )\n\n    rendered = _render(projection, event)\n\n    assert \"Inspect [bold]literal[/bold] fixture\" in rendered\n    assert \"Verify remaining fixture\" in rendered\n    assert projection.poll().activity[0].label == \"plan\"\n\n\n@pytest.mark.parametrize(\"provider\", [\"codex\", \"claude\"])\ndef test_activity_keeps_lanes_and_excludes_other_session_activity(\n    projection: Projection, provider: str\n) -> None:\n    lane = _event(\n        provider,\n        \"lane.started\",\n        {\"label\": \"Receiver\", \"detail\": \"checking\"},\n        lane=\"child-1\",\n    )\n    selected = _event(\n        provider,\n        \"activity.message\",\n        {\"kind\": \"text\", \"text\": \"selected fixture\", \"message_id\": \"selected\"},\n    )\n    other = _event(\n        provider,\n        \"activity.message\",\n        {\"kind\": \"text\", \"text\": \"unselected fixture\", \"message_id\": \"other\"},\n        session=\"session-2\",\n    )\n\n    rendered = _render(projection, lane, selected, other)\n\n    assert \"Receiver: running\" in rendered\n    assert \"checking\" in rendered\n    assert \"selected fixture\" in rendered\n    assert \"unselected fixture\" not in rendered\n\n\n@pytest.mark.parametrize(\"provider\", [\"codex\", \"claude\"])\ndef test_activity_bounds_large_literal_message_details(\n    projection: Projection, provider: str\n) -> None:\n    text = \"[bold]literal fixture[/bold] \" + \"x\" * 200_000\n    event = _event(\n        provider,\n        \"activity.message\",\n        {\"kind\": \"text\", \"text\": text, \"message_id\": \"large\"},\n    )\n\n    rendered = _render(projection, event)\n\n    assert \"[bold]literal fixture[/bold]\" in rendered\n    assert len(rendered) < len(text)\nFILE docs/driver-protocol.md\nworkflow command, then exit the session. Never edit state.json directly. Do not\nstart a second phase in this session. Completion is determined by committed\nstate, not your final message. Do not install, upgrade, or modify launcher\nplugins or marketplace content.\n```\n\nThe external skill must expose the native name `run-autopilot`. A different\ninstalled name requires an explicit verified phase prompt override.\n`AgentSettings.prompts` are literal supervisor overrides subject to the same\nhandoff contract; the driver does not embed skill files or open plugin caches.\nState transitions determine successful handoff and phase completion. One\nlaunched session performs one phase and exits after one successful committed\nhandoff, with no second-phase work in that session.\n\n`ProjectObserver` and panels consume normalized observations and metrics to\nshow provider identity, attributed lanes and exact/estimated usage. Normalized\ntool lifecycles and text, thinking, error, warning and plan activity render\nalongside lanes. Tool names persist through terminal events that omit them;\ntool details come from normalized `detail`. Messages prefer non-null `text`\n(including an empty string), falling back to `detail` only when `text` is absent\nor null. Plans display up to 256 steps with `done:`/`pending:` markers. Activity\nis restricted to the selected run and session and retains at most 256 identities;\nmessage updates use their full IDs, while messages without IDs remain distinct.\nThe panel shows the newest 20 activity entries newest-first, then at most the\nfirst 20 lanes, with separate omission counts. Details remain bounded literal\ntext without interpreting markup.\nUnavailable cost is unknown or omitted. Unsupported fields and\nnormalization gaps retain raw-only visibility; out-of-order lane progress can\nremain unknown.\nNative receiver IDs do not establish OVCAQ task correlation. The TUI adds no\nprovider parser, model names or lifecycle policy.\n\n","exit_code":0,"status":"completed"}}
