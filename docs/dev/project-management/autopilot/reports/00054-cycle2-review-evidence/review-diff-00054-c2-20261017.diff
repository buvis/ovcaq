n58: \n59: def implementation_snapshot(state: dict) -> dict:\n60:     \"\"\"Keep only provenance inputs, independent of later review annotations.\"\"\"\n61:     data = {key: state.get(key) for key in (\"prd\", \"cycle\", \"work_start_sha\")}\n62:     data[\"tasks\"] = [\n63:         {\n64:             \"id\": task[\"id\"],\n65:             \"attempts\": [\n66:                 {\n67:                     key: attempt.get(key)\n68:                     for key in (\n69:                         \"attempt\",\n70:                         \"actual_model\",\n71:                         \"actual_provider\",\n72:                         \"implementor\",\n73:                         \"outcome\",\n74:                     )\n75:                 }\n76:                 for attempt in task.get(\"attempts\", [])\n77:             ],\n78:         }\n79:         for task in state.get(\"tasks\", [])\n80:     ]\n81:     return data\n82: \n83: \n84: def implementation_fingerprint(state: dict) -> str:\n85:     return hashlib.sha256(\n86:         json.dumps(implementation_snapshot(state), sort_keys=True).encode()\n87:     ).hexdigest()\n88: \n89: \n90: def audited_review_providers(state: dict, cwd: Path) -> list[str]:\n91:     \"\"\"Check the coordinator's log audit; never mine arbitrary prose for models.\"\"\"\n92:     path = (\n93:         cwd\n94:         / \"docs/dev/project-management/autopilot/reports\"\n95:         / f\"{Path(state['prd']).stem}-implementation-models.json\"\n96:     )\n97:     audit = json.loads(path.read_text())\n98:     if audit.get(\"fingerprint\") != implementation_fingerprint(state):\n99:         raise ValueError(\"stale implementation model audit; inspect current attempt logs\")\n100:     providers = set(review_providers(state))\n101:     covered = set()\n102:     entries = audit.get(\"evidence\") or []\n103:     for entry in entries:\n104:         if entry.get(\"role\") != \"implementation\":\n105:             raise ValueError(\n106:                 \"reviewer/