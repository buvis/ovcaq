h, observations, detail)\\n\\n\\n@pytest.mark.parametrize(\\\"kind\\\", [\\\"error\\\", \\\"turn.failed\\\"])\\n@pytest.mark.parametrize(\\\"seconds\\\", [30, 21600, -1, 21601])\\ndef test_native_rate_limit_uses_full_text_for_reset_and_saves_bounded_redaction(\\n    driver: CodexDriver, tmp_path: Path, kind: str, seconds: int\\n) -> None:\\n    detail = CAP_REPRODUCER + f\\\" HTTP 429; retry after {seconds} seconds\\\"\\n    observations = decode_failure(driver, kind, detail)\\n    if kind == \\\"error\\\":\\n        assert [value.type for value in observations] == [\\\"activity.message\\\"]\\n        failure = rate = observations[0]\\n        assert failure.payload[\\\"kind\\\"] == \\\"error\\\"\\n    else:\\n        assert sorted(value.type for value in observations) == [\\n            \\\"rate_limit.started\\\",\\n            \\\"session.failed\\\",\\n        ]\\n        failure = next(\\n            value for value in observations if value.type == \\\"session.failed\\\"\\n        )\\n        rate = next(\\n            value for value in observations if value.type == \\\"rate_limit.started\\\"\\n        )\\n        assert rate.payload[\\\"window\\\"] is None\\n    assert failure.payload[\\\"failure_class\\\"] == \\\"rate_limit\\\"\\n    reset_at = rate.payload[\\\"reset_at\\\"]\\n    if 0 <= seconds <= 21600:\\n        assert isinstance(reset_at, str)\\n        actual = datetime.fromisoformat(reset_at)\\n        assert actual.utcoffset() == timedelta(0)\\n        expected_reset = rate.timestamp + timedelta(seconds=seconds)\\n        assert abs((actual - expected_reset).total_seconds()) < 1\\n    else:\\n        assert reset_at is None\\n    expected_detail = (\\n        \\\"x\\\" * 4080 + \\\" [REDACTED]\\\" + f\\\" HTTP 429; retry after {seconds} seconds\\\"\\n    )[:4096]\\n    assert_safe_details(tmp_path, observations, expected_detail)\\n\\n\\n@pytest.mark.parametrize(\\\"kind\\\", [\\\"error\\\", \\\"turn.failed\\\"])\\n@pytest.mark.parametrize(\\n    (\\\"native_suffix\\\", \\\"expected_class\\\"),\\n    [\\n        (\\n            \\\"Unauthorized: HTTP 401; HTTP 429; retry after 30 seconds\\\",\\n            \\\"authentication\\\",\\n        ),\\n        (\\\"Sandbox denied: HTTP 403\\\", \\\"permission\\\"),\\n        (\\\"Connection reset: HTTP 503\\\", \\\"connectivity\\\"),\\n        (\\\"Request timed out\\\", \\\"timeout\\\"),\\n        (\\\"Unau\\\\x1b[0mthorized\\\", \\\"unknown\\\"),\\n    ],\\n)\\ndef test_native_failure_preserves_full_original_classification_before_cleaning(\\n    driver: CodexDriver, kind: str, native_suffix: str, expected_class: str\\n) -> None:\\n    detail = \\\"x\\\" * 4096 + \\\" \\\" + native_suffix\\n    observations = decode_failure(driver, kind, detail)\\n    failure = next(\\n        value\\n        for value in observations\\n        if value.type == (\\\"activity.message\\\" if kind == \\\"error\\\" else \\\"session.failed\\\")\\n    )\\n    assert failure.payload[\\\"failure_class\\\"] == expected_class\\n    assert failure.payload[\\\"detail\\\"] == \\\"x\\\" * 4096\\n\\n\\n@pytest.mark.parametrize((\\\"detail\\\", \\\"expected\\\"), SPLIT_DETAILS)\\ndef test_receiver_lane_redacts_message_payload_and_saved_jsonl(\\n    driver: CodexDriver, tmp_path: Path, detail: str, expected: str\\n) -> None:\\n    driver.decode(json.dumps({\\\"type\\\": \\\"thread.started\\\", \\\"thread_id\\\": \\\"parent\\\"}))\\n    observations = driver.decode(\\n        json.dumps(\\n            {\\n                \\\"type\\\": \\\"item.started\\\",\\n                \\\"item\\\": {\\n                    \\\"id\\\": \\\"collab-1\\\",\\n                    \\\"type\\\": \\\"collab_tool_call\\\",\\n                    \\\"tool\\\": \\\"spawn_agent\\\",\\n                    \\\"sender_thread_id\\\": \\\"parent\\\",\\n                    \\\"receiver_thread_ids\\\": [\\\"child-1\\\"],\\n                    \\\"prompt\\\": \\\"Inspect receiver\\\",\\n                    \\\"agents_states\\\": {\\n                        \\\"child-1\\\": {\\\"status\\\": \\\"running\\\", \\\"message\\\": detail}\\n                    },\\n                    \\\"status\\\": \\\"in_progress\\\",\\n                },\\n            }\\n        )\\n    )\\n    lanes = tuple(value for value in observations if value.lane_id == \\\"child-1\\\")\\n    assert len(lanes) == 1\\n    assert lanes[0].type == \\\"lane.started\\\"\\n    lane_detail = lanes[0].payload[\\\"detail\\\"]\\n    assert isinstance(lane_detail, str)\\n    assert \\\"\\\\x1b\\\" not in lane_detail\\n    assert \\\"\\\\x00\\\" not in lane_detail\\n    if detail != CAP_REPRODUCER:\\n        assert expected in lane_detail\\n    assert_safe_details(tmp_path, lanes, lane_detail)\\n\\n/Users/bob/git/src/github.com/buvis/ovcaq/tests/events/test_unicode_frames.py\\n\\\"\\\"\\\"Raw-first rejection of native frames containing invalid Unicode scalars.\\\"\\\"\\\"\\n\\nimport copy\\nimport errno\\nimport hashlib\\nimport json\\nimport os\\nfrom collections.abc import Iterator\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport pytest\\n\\nfrom ovcaq.config import AgentSettings\\nfrom ovcaq.drivers.codex import CodexDriver\\nfrom ovcaq.events import (\\n    Observation,\\n    ObservationType,\\n    observation_from_record,\\n    summary_record,\\n)\\nfrom ovcaq.events.tail import NormalizedEventWriter, RawFirstDecoder\\nfrom ovcaq.runtime.session import SessionEvidenceWriter\\n\\n\\ndef native_unicode_driver() -> CodexDriver:\\n    return CodexDriver(\\n        AgentSettings(\\n            name=\\\"codex\\\",\\n            command=(\\\"fixture-wrapper\\\",),\\n            tiers={\\\"standard\\\": \\\"fixture-model\\\"},\\n            environment={},\\n            options={},\\n        ),\\n        run_id=\\\"unicode-run\\\",\\n    )\\n\\n\\ndef native_unicode_record(kind: str) -> dict[str, Any]:\\n    return {\\n        \\\"startup\\\": {\\\"type\\\": \\\"thread.started\\\", \\\"thread_id\\\": \\\"poisoned-parent\\\"},\\n        \\\"completion\\\": {\\n            \\\"type\\\": \\\"turn.completed\\\",\\n            \\\"usage\\\": {\\n                \\\"input_tokens\\\": 99,\\n                \\\"cached_input_tokens\\\": 9,\\n                \\\"output_tokens\\\": 88,\\n            },\\n        },\\n        \\\"collaboration\\\": {\\n            \\\"type\\\": \\\"item.started\\\",\\n            \\\"item\\\": {\\n                \\\"id\\\": \\\"collab-1\\\",\\n                \\\"type\\\": \\\"collab_tool_call\\\",\\n                \\\"tool\\\": \\\"spawn_agent\\\",\\n                \\\"sender_thread_id\\\": \\\"healthy-parent\\\",\\n                \\\"receiver_thread_ids\\\": [\\\"child-1\\\"],\\n                \\\"prompt\\\": \\\"Inspect receiver\\\",\\n                \\\"agents_states\\\": {\\n                    \\\"child-1\\\": {\\\"status\\\": \\\"running\\\", \\\"message\\\": \\\"Receiver evidence\\\"}\\n                },\\n                \\\"status\\\": \\\"in_progress\\\",\\n            },\\n        },\\n    }[kind]\\n\\n\\ndef unicode_adapter_state(driver: CodexDriver) -> tuple[Any, ...]:\\n    return copy.deepcopy(\\n        tuple(\\n            getattr(driver, field)\\n            for field in (\\\"_session_id\\\", \\\"_usage\\\", \\\"_thread_conflict\\\", \\\"_identities\\\")\\n        )\\n    )\\n\\n\\ndef unicode_normalized(path: Path) -> tuple[Observation, ...]:\\n    return tuple(\\n        observation_from_record(json.loads(line))\\n        for line in path.read_bytes().splitlines()\\n    )\\n\\n\\n@pytest.fixture\\ndef unicode_tail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[Any]:\\n    raw_path = tmp_path / \\\"raw.jsonl\\\"\\n    normalized_path = tmp_path / \\\"normalized.jsonl\\\"\\n    raw = SessionEvidenceWriter(raw_path, max_bytes=1 << 20, min_free_bytes=0)\\n    normalized = NormalizedEventWriter(\\n        normalized_path, max_bytes=1 << 20, min_free_bytes=0\\n    )\\n    raw_information = raw_path.stat()\\n    durable: list[bytes] = []\\n    real_fsync = os.fsync\\n\\n    def sync(descriptor: int) -> None:\\n        real_fsync(descriptor)\\n        if os.path.samestat(raw_information, os.fstat(descriptor)):\\n            durable.append(raw_path.read_bytes())\\n\\n    monkeypatch.setattr(os, \\\"fsync\\\", sync)\\n    driver = native_unicode_driver()\\n    decoder = RawFirstDecoder(\\n        raw=raw,\\n        normalized=normalized,\\n        driver=driver,\\n        run_id=\\\"unicode-run\\\",\\n        session_id=\\\"owned-session\\\",\\n    )\\n    try:\\n        yield driver, decoder, raw_path, normalized_path, durable\\n    finally:\\n        normalized.close()\\n        raw.close()\\n\\n\\ndef assert_unicode_gap(observations: tuple[Observation, ...], frame: bytes) -> None:\\n    assert len(observations) == 1\\n    gap = observations[0]\\n    assert gap.type is ObservationType.RAW_UNKNOWN\\n    assert gap.run_id == \\\"unicode-run\\\"\\n    assert gap.session_id == \\\"owned-session\\\"\\n    assert set(gap.payload) == {\\\"reason\\\", \\\"raw_sha256\\\", \\\"preview\\\"}\\n    assert gap.payload[\\\"reason\\\"] == \\\"frame contains invalid Unicode scalar value\\\"\\n    assert gap.payload[\\\"raw_sha256\\\"] == hashlib.sha256(frame).hexdigest()\\n    preview = gap.payload[\\\"preview\\\"]\\n    assert isinstance(preview, str) and len(preview) <= 512\\n    assert \\\"native-marker\\\" in preview\\n    assert \\\"synthetic-hidden\\\" not in preview\\n    assert \\\"[REDACTED]\\\" in preview\\n    assert \\\"\\\\x1b\\\" not in preview\\n    preview.encode(\\\"utf-8\\\", errors=\\\"strict\\\")\\n\\n\\ndef poisoned_unicode_frame(kind: str, location: str, scalar: str) -> bytes:\\n    record = native_unicode_record(kind)\\n    record = {\\n        \\\"note\\\": \\\"native-marker token=synthetic-hidden\\\\x1b[31m\\\",\\n        \\\"padding\\\": \\\"x\\\" * 700,\\n        **record,\\n    }\\n    if location == \\\"native\\\":\\n        if kind == \\\"startup\\\":\\n            record[\\\"thread_id\\\"] = \\\"poisoned-parent\\\" + scalar\\n        elif kind == \\\"completion\\\":\\n            record[\\\"usage\\\"][\\\"ignored\\\"] = scalar\\n        else:\\n            record[\\\"item\\\"][\\\"agents_states\\\"][\\\"child-1\\\"][\\\"message\\\"] = scalar\\n    elif location == \\\"ignored-value\\\":\\n        record[\\\"ignored\\\"] = scalar\\n    elif location == \\\"nested-value\\\":\\n        record[\\\"ignored\\\"] = [{\\\"deeper\\\": [None, scalar]}]\\n    elif location == \\\"nested-key\\\":\\n        record[\\\"ignored\\\"] = [{\\\"deeper\\\": [{scalar: \\\"ignored\\\"}]}]\\n    else:\\n        record[\\\"password\\\"] = scalar\\n    return json.dumps(record, ensure_ascii=True).encode()\\n\\n\\n@pytest.mark.parametrize(\\\"scalar\\\", [chr(0xD800), chr(0xDFFF)], ids=[\\\"high\\\", \\\"low\\\"])\\n@pytest.mark.parametrize(\\\"kind\\\", [\\\"startup\\\", \\\"completion\\\", \\\"collaboration\\\"])\\n@pytest.mark.parametrize(\\n    \\\"location\\\",\\n    [\\\"native\\\", \\\"ignored-value\\\", \\\"nested-value\\\", \\\"nested-key\\\", \\\"secret\\\"],\\n)\\n@pytest.mark.parametrize(\\\"initialized\\\", [False, True])\\n@pytest.mark.parametrize(\\n    (\\\"framing\\\", \\\"digest_suffix\\\"),\\n    [(b\\\"\\\\n\\\", b\\\"\\\"), (b\\\"\\\\r\\\\n\\\", b\\\"\\\"), (b\\\"\\\", b\\\"\\\"), (b\\\"\\\\r\\\\r\\\\n\\\", b\\\"\\\\r\\\")],\\n    ids=[\\\"newline\\\", \\\"crlf\\\", \\\"unterminated\\\", \\\"one-framing-cr\\\"],\\n)\\ndef test_unsafe_native_frame_is_one_durable_gap_without_adapter_mutation(\\n    unicode_tail: Any,\\n    scalar: str,\\n    kind: str,\\n    location: str,\\n    initialized: bool,\\n    framing: bytes,\\n    digest_suffix: bytes,\\n) -> None:\\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\\n    emitted: tuple[Observation, ...] = ()\\n    if initialized:\\n        startup = {\\\"type\\\": \\\"thread.started\\\", \\\"thread_id\\\": \\\"healthy-parent\\\"}\\n        emitted += decoder.feed(json.dumps(startup).encode() + b\\\"\\\\n\\\")\\n        emitted += decoder.feed(\\n            json.dumps(native_unicode_record(\\\"collaboration\\\")).encode() + b\\\"\\\\n\\\"\\n        )\\n    before = unicode_adapter_state(driver)\\n    previous = raw_path.read_bytes()\\n    frame = poisoned_unicode_frame(kind, location, scalar)\\n    wire = frame + framing\\n    assert decoder.feed(wire[:17]) == ()\\n    assert unicode_adapter_state(driver) == before\\n    rejected = decoder.feed(wire[17:]) + decoder.finish()\\n    assert_unicode_gap(rejected, frame +…1002 tokens truncated… unicode_adapter_state(driver) == before\\n    assert raw_path.read_bytes() == durable[-1] == frame + b\\\"\\\\n\\\"\\n    assert unicode_normalized(normalized_path) == observations\\n\\n\\ndef test_deep_json_recursion_preserves_native_gap_and_durable_evidence(\\n    unicode_tail: Any,\\n) -> None:\\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\\n    driver.decode(json.dumps({\\\"type\\\": \\\"thread.started\\\", \\\"thread_id\\\": \\\"healthy-parent\\\"}))\\n    driver.decode(json.dumps(native_unicode_record(\\\"completion\\\")))\\n    depth = 100_000\\n    frame = (\\n        b'{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"poisoned-parent\\\",\\\"ignored\\\":'\\n        + b\\\"[\\\" * depth\\n        + b\\\"0\\\"\\n        + b\\\"]\\\" * depth\\n        + b\\\"}\\\"\\n    )\\n    with pytest.raises(RecursionError):\\n        json.loads(frame)\\n    expected = native_unicode_driver().decode(frame.decode())\\n    assert len(expected) == 1\\n    assert expected[0].type is ObservationType.RAW_UNKNOWN\\n    before = unicode_adapter_state(driver)\\n    observations = decoder.feed(frame + b\\\"\\\\n\\\") + decoder.finish()\\n    assert len(observations) == 1\\n    gap = observations[0]\\n    assert gap.type is ObservationType.RAW_UNKNOWN\\n    assert gap.run_id == \\\"unicode-run\\\"\\n    assert gap.session_id == \\\"owned-session\\\"\\n    assert dict(gap.payload) == dict(expected[0].payload)\\n    assert gap.payload[\\\"reason\\\"] != \\\"frame contains invalid Unicode scalar value\\\"\\n    assert gap.payload[\\\"raw_sha256\\\"] == hashlib.sha256(frame).hexdigest()\\n    assert unicode_adapter_state(driver) == before\\n    assert raw_path.read_bytes() == durable[-1] == frame + b\\\"\\\\n\\\"\\n    assert unicode_normalized(normalized_path) == observations\\n\\n\\n@pytest.mark.parametrize(\\\"stage\\\", [\\\"raw\\\", \\\"normalized\\\"])\\n@pytest.mark.parametrize(\\\"error_number\\\", [errno.ENOSPC, errno.EIO])\\ndef test_real_writer_failures_propagate_from_unsafe_native_frames(\\n    unicode_tail: Any,\\n    monkeypatch: pytest.MonkeyPatch,\\n    stage: str,\\n    error_number: int,\\n) -> None:\\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\\n    target = raw_path if stage == \\\"raw\\\" else normalized_path\\n    information = target.stat()\\n    failure = OSError(error_number, \\\"injected evidence write failure\\\")\\n    real_write = os.write\\n\\n    def failing_write(descriptor: int, payload: bytes) -> int:\\n        if os.path.samestat(information, os.fstat(descriptor)):\\n            raise failure\\n        return real_write(descriptor, payload)\\n\\n    before = unicode_adapter_state(driver)\\n    frame = poisoned_unicode_frame(\\\"startup\\\", \\\"ignored-value\\\", \\\"\\\\ud800\\\")\\n    with monkeypatch.context() as patch:\\n        patch.setattr(os, \\\"write\\\", failing_write)\\n        with pytest.raises(OSError) as caught:\\n            decoder.feed(frame + b\\\"\\\\n\\\")\\n    assert caught.value is failure\\n    assert unicode_adapter_state(driver) == before\\n    assert normalized_path.read_bytes() == b\\\"\\\"\\n    assert raw_path.read_bytes() == (b\\\"\\\" if stage == \\\"raw\\\" else frame + b\\\"\\\\n\\\")\\n    if stage == \\\"normalized\\\":\\n        assert durable[-1] == frame + b\\\"\\\\n\\\"\\n\\n\\n## Architecture context\\n\\n# AGENTS.md — OVCAQ\\n\\nOVCAQ means **Orchestration, Visibility, and Control for Agent Queues**. It is\\nan installable Python CLI/TUI that supervises a PRD-driven workflow through\\nClaude Code, Codex, or another headless coding agent.\\n\\nThe global `AGENTS.md` remains in force. This file adds project-specific rules.\\n\\n## Current state\\n\\nThe repository is in planning/bootstrap. Until an implementation PRD replaces\\nit, `docs/dev/project-management/plans/implementation-plan.md` is the architecture and sequencing\\nauthority. Do not create production modules opportunistically outside that\\nsequence.\\n\\n## Product boundary\\n\\nOVCAQ core owns state, lifecycle commands, process supervision, agent adapters,\\nnormalized events, observability, the TUI, and launcher provisioning checks.\\n\\nOVCAQ core does **not** contain launcher-specific skills, agents, hooks, or\\nplugins. Those live in external marketplaces. Core may carry declarative\\nidentifiers and version requirements needed to reconcile them.\\n\\n## Architecture invariants\\n\\n1. **One state writer.** Every durable `state.json` mutation goes through the\\n   state store. Agents mutate state only through `ovcaq state` or a higher-level\\n   OVCAQ command. Never instruct an agent to edit `state.json` directly.\\n2. **State decides; prose does not.** Session completion, phase handoff, pause,\\n   drain, retry, and failure decisions derive from committed state plus a\\n   normalized session result. A final agent message is never authoritative.\\n3. **Provider code stays at the edge.** Claude/Codex argv, environment variables,\\n   event formats, model names, rate-limit parsing, and connectivity checks live\\n   under their adapter. Shared runtime and UI code must not parse provider-native\\n   events.\\n4. **Raw evidence survives normalization.** Preserve each session's raw output.\\n   Normalizers are tolerant and must degrade to an unknown/raw observation\\n   instead of crashing the supervisor.\\n5. **The TUI observes shared models.** It reads state, registry, metrics, and\\n   normalized observations. It does not implement lifecycle policy or maintain a\\n   second liveness algorithm.\\n6. **External capabilities stay external.** Provisioning invokes a launcher's\\n   supported marketplace/plugin CLI and verifies the result. It does not copy\\n   plugin contents into this package or hand-edit launcher caches.\\n7. **No shell evaluation of configured commands.** Store agent commands as argv\\n   arrays and spawn them without `shell=True`.\\n\\n## Target layout\\n\\n```text\\nsrc/ovcaq/\\n  state/        # schema, transactions, compound mutations\\n  workflow/     # PRD selection, transitions, records, policy\\n  runtime/      # supervisor, decisions, registry, process ownership\\n  drivers/      # Claude, Codex, and generic command adapters\\n  events/       # normalized event model and session reduction\\n  tui/          # discovery and Textual/Rich presentation\\n  provision/    # marketplace/plugin reconciliation\\ntests/          # mirrors package boundaries; provider JSONL fixtures\\ndocs/           # tracked architecture and operator documentation\\n```\\n\\n## Toolchain\\n\\n- Python 3.12+ managed through `mise`.\\n- `uv` for environments, locking, build, and command execution.\\n- `pytest` for tests; `ruff` for formatting/linting; `mypy` for package types.\\n- Keep the runtime dependency set small. Textual/Rich are justified by the TUI;\\n  prefer the standard library for state, locking, configuration, and subprocesses.\\n\\nPlanned verification commands once the scaffold lands:\\n\\n```bash\\nuv sync --all-groups\\nuv run pytest\\nuv run ruff check .\\nuv run ruff format --check .\\nuv run mypy src/ovcaq\\nuv build\\n```\\n\\n## Development rules\\n\\n- Characterize current behavior before moving it from `~/.claude`.\\n- Extract state first, then pure workflow logic, runtime, adapters, TUI, and\\n  provisioning in that order.\\n- Sanitized Claude and Codex JSONL fixtures belong in `tests/fixtures/`; tests\\n  never read live files from `~/.claude` or `~/.codex`.\\n- Test process-group, lock, and signal behavior with real subprocesses in\\n  addition to unit tests.\\n- Documentation for commands comes from the same command registry/parser as the\\n  implementation; do not maintain a second hand-written verb inventory.\\n- Keep provider-neutral modules free of the strings `claude`, `anthropic`,\\n  `codex`, and provider model identifiers except in tests that enforce this rule.\\n- Use conventional commits. No compatibility shim, dual writer, or rollback\\n  framework is required for the initial cutover.\\n\\n## Migration stance\\n\\nThis is a one-way early-stage extraction. Start a fresh OVCAQ batch/state tree;\\ndo not build an importer for the current `docs/dev/project-management/autopilot/state.json` unless\\na later requirement explicitly needs it. Temporary delegation during a local\\ncanary is acceptable, but do not ship `autoclaude`, `autopilot`, `tracon`, or\\n`statectl` aliases as permanent public APIs.\\n\\nBounded task 6 work mandate:\\nSource review: docs/dev/project-management/reviews/00051-triage-a-single-valid-codex-record-can-crash-th-v1-review-1.md\\n\\nDisposition and bounded acceptance:\\nReview-cycle correction: the transmitted original strip-first recipe lost original regex word boundaries. This is a specification gap, not a capability failure. Preserve original-token redaction AND redact reconstructed tokens after removing the unchanged recognized controls, then cap to 4096. A bounded candidate is sanitize original detail, remove the existing controls, sanitize the full cleaned result, then truncate. Preserve classification/reset extraction from untouched full native text, all existing cap/control/Unicode regressions, and public signatures. Amend the design with a review-1 contract correction citing R5; retain its historical recipe/review evidence rather than erase it. Independently test C0/DEL/lone-ESC boundary destruction for bare tokens and Bearer values through helper and actual native normalized payloads/JSONL, plus original R2 control-split cap cases. Never weaken shared sanitizer boundaries or expand recognized control forms.\\n\\nR4 scan optimization must preserve original full-container scalar validation before redaction, valid non-BMP scalars and subclass handling. Avoid bypassing sanitize_json in a caller not already fully checked. A precompiled surrogate regex is sufficient if eliminating repeated validation risks the contract.\\n\\nR7 needs an independent native-parser reason/adapter-state assertion for a bounded deeply nested JSON frame that raises RecursionError in the preflight. R8 must preserve tolerant validation/decode handling and fatal publication boundaries; helper extraction inside the current catch is acceptable, literal hoisting that widens escaping failures is not.\\n\\nAcceptance: every quoted finding is resolved without scope expansion, all original source R7/R2 regressions remain pinned, and focused events/detail tests pass. Do not add cyclic-container guards or TUI changes. Keep the witnessed out-of-scope limitations in the review ledger.\\n\\n### Findings (verbatim)\\n- ⚪ src/ovcaq/events/model.py:224: Hot-path scan cost. `_payload` scans the whole payload at line 224, then `sanitize_json` scans it again at line 252, and `_usage_payload` scans again through `sanitize_json`. Each scan uses a per-character Python generator: about 22 ms per MiB, against about 2.5 ms for a precompiled `re.compile(\\\"[\\\\ud800-\\\\udfff]\\\").search`. Every frame also gets re-validated by `replace()` in `_bind_observations` and by `observation_record` in the writer. Behavior-preserving fix: use the regex in the predicate, and call `_sanitize_json` inside `_payload` and `_usage_payload` once the up-front check has passed (found by: ALICE, BOB)\\n- 🟠 src/ovcaq/drivers/codex_events.py:64: Removing controls before redaction now leaks tokens that the old order caught. When a bare C0 control, DEL or lone ESC sits between a word character and a token, removal glues them together: `\\\"x\\\\x00sk-\\\" + \\\"a\\\"*30` becomes `xsk-aaaa…` and `\\\"auth\\\\x00Bearer \\\" + \\\"a\\\"*26` becomes `authBearer …`. `_LIKELY_SECRET` needs `\\\\b` before `sk-`/`Bearer`, so neither `bounded_detail` nor the Observation's second sanitizer redacts them. The old order redacted both, because the control supplied the word boundary. Confirmed by tracing the regex by hand; not executed (read-only sandbox) (found by: BOB)\\n- 🟡 src/ovcaq/events/tail.py:119: The preflight's `except (ValueError, RecursionError)` branch, which hands the frame to the driver, has no test. No RawFirstDecoder test feeds a deeply nested frame. Narrowing it to `except ValueError` would still pass the suite: deep frames would then get \\\"driver failed to decode frame\\\" instead of the driver's own native gap, against the contract's \\\"ValueError or RecursionError → delegate unchanged\\\" (found by: BOB)\\n- 🟡 src/ovcaq/events/tail.py:116: The preflight parse and scan sit inside the tolerant driver catch, so the try blocks nest 4 levels deep (the limit). Hoist the `json.loads` try and the scalar check above it and wrap only `tuple(self._driver.decode(frame))` in `except Exception`. This also matches the contract's \\\"consume decode under the existing tolerant catch\\\" (found by: BOB)\\n\\nREADING BUDGET: events/model.py lines 20–110 and 185–280; events/tail.py lines 90–180; codex_events.py lines 1–80. Design Interfaces & contracts and append correction citing review-1 R5; retain historical recipe and review log. CHANGELOG Unreleased only. Order: fix detail redaction; optimize scalar predicate; simplify preflight within tolerant catch; append contract correction; changelog. Tests listed below are read-only, never modify. Run only the named test files -q --tb=line. Do not commit or mutate state. No cyclic or TUI expansion. Avoid unnecessary repeated validation where already fully scanned, retaining subclass semantics. Source recipe is superseded by task correction.\\n\\n\\n## Files you may read and modify\\n\\n/Users/bob/git/src/github.com/buvis/ovcaq/src/ovcaq/events/model.py\\n/Users/bob/git/src/github.com/buvis/ovcaq/src/ovcaq/events/tail.py\\n/Users/bob/git/src/github.com/buvis/ovcaq/src/ovcaq/drivers/codex_events.py\\n/Users/bob/git/src/github.com/buvis/ovcaq/docs/dev/project-management/designs/00051-triage-a-single-valid-codex-record-can-crash-th-v1-design.md\\n/Users/bob/git/src/github.com/buvis/ovcaq/CHANGELOG.md\\n\\nRead only the files listed above. If a file or symbol you need is not\\nlisted, stop and report it as a blocker — do not run broad `rg` sweeps to\\ndiscover scope.\\n\\n\\n\\n### Code quality rules (mandatory)\\n\\nFollow these four rules. They override any instinct to \\\"improve\\\" the code\\nbeyond what the failing tests require.\\n\\n**1. Think before coding.** Re-read the task and the failing tests. If scope,\\ndata shape, target file, or success criteria are ambiguous - more than one\\nreasonable implementation would pass the tests differently - STOP and report\\nthe ambiguity as a blocker. Do not guess and proceed.\\n\\n**2. Simplicity.** Write the simplest code that makes the failing tests pass.\\n\\n- No abstractions, helpers, or interfaces built for a single caller.\\n- No error handling, fallbacks, or validation for inputs the tests never\\n  exercise. Validate at real system boundaries only.\\n- No features, options, or configuration the task did not ask for.\\n- If your draft runs long and the same behavior fits in far fewer lines,\\n  rewrite it before returning.\\n\\n**3. Surgical changes.** Touch only what the task requires.\\n\\n- Do not refactor, reformat, or \\\"improve\\\" code outside the change.\\n- Match the surrounding style even if you would write it differently.\\n- Remove imports, variables, and functions that YOUR change orphaned. Do not\\n  delete pre-existing dead code - mention it instead.\\n- Every changed line must trace to the task or a failing test.\\n\\n**4. Goal-driven.** The failing tests are the spec. Make them pass - do not\\nmodify them, do not weaken them, do not add tests. If a test looks wrong,\\nreport it as a blocker rather than changing it.\\n\\nAbort and report if you read more than 100K of total input. Return the\\npartial result and an abort_reason: context_overrun field.\\n\\nRead every file before your first Edit to it. Never call bash `head`,\\n`tail`, `cat`, `grep`, or `find` - a hook blocks them. Use the Read tool\\n(offset/limit), `rg`, or `rg --files` instead. Never combine an inspection\\n(read, list, search, diff) with a test, lint or build invocation in one Bash\\ncall - run them as two calls, because a combined command has two ways to hang\\nand one exit code. Pass an explicit `timeout` on every Bash call: 60000 ms for\\nan inspection, 300000 ms for a lint run or a narrow test run, 600000 ms for a\\nfull suite or a full build.\\n\\nRun only the test files this task names (the tests you wrote, or the\\nfailing tests in your prompt), with `-q --tb=line`. Never run a whole test\\ndirectory or `dev/bin/release-checks`: the orchestrator runs the full suite\\nonce, after every task. Read the pass count and exit code from that one\\nrun; never re-run a suite to recover a number.\\n\\nEnd your report with `ASSUMPTIONS:` - one line per assumption you made\\nwhere the task, tests, or listed files were silent (guessed interface, data\\nshape, resolved ambiguity, unstated behavior). Write `ASSUMPTIONS: none` if\\nyou made none.\\n\\nAlso end your report with `FILES_TOUCHED:` - one line per file you created\\nor modified, path relative to the repo root. Write `FILES_TOUCHED: none` if\\nyou changed no files.\\n\"}\n{\"chunk_id\":\"589e33\",\"wall_time_seconds\":0.000001541,\"exit_code\":0,\"original_token_count\":771,\"output\":\"---\\nname: python-patterns\\ndescription: Use when writing, reviewing, or refactoring Python code. Covers idioms, naming, traps, toolchain, and security. Triggers on Python file edits, \\\"pythonic\\\", \\\"PEP 8\\\", \\\"python best practices\\\", \\\"python idioms\\\", \\\"bandit\\\".\\ncompatibility: \\\"Portable standalone compatibility copy of the strunk plugin skill for agents without that plugin; Claude Code uses the namespaced plugin skill.\\\"\\n---\\n\\n# Python Patterns\\n\\nPick a side. These are the rulings, not a tutorial.\\n\\n## Idioms that earn their place\\n\\n| Rule | Why |\\n|------|-----|\\n| `X \\\\| Y`, not `Union[X, Y]` | 3.10+ runtime syntax; clearer. On 3.9 it parses only under `from __future__ import annotations` and still breaks `get_type_hints`/`isinstance` — keep `Optional`/`Union` if you support 3.9. |\\n| `Protocol`, not `ABC`, for duck typing | Structural typing; no inheritance you don't control. |\\n| `@dataclass(frozen=True)` for immutable records, plain `dataclass` only when you must mutate, `NamedTuple` for lightweight immutable rows | Pydantic only when you need validation. |\\n| `raise New(...) from e` | Marks the explicit cause. A bare `raise New()` still chains implicitly (\\\"During handling...\\\"); use `from None` to suppress. |\\n| `@functools.wraps` on every decorator | Without it the wrapper loses `__name__`, `__doc__`, signature. |\\n| `pathlib.Path`, not `os.path` | One object, no string surgery. |\\n\\n## Naming (PEP 8)\\n\\n`snake_case` for modules, functions, variables. `CapWords` for classes. `UPPER_SNAKE_CASE` for constants. Leading `_` for internal names.\\n\\n**Never name a `.py` file in kebab-case.** `my-script.py` is not importable (`import my-script` is a `SyntaxError`). Kebab-case belongs only in the `pyproject.toml` distribution name and the CLI command, both of which map to a `snake_case` module.\\n\\n## Traps\\n\\n```python\\n# Mutable default argument — shared across calls\\ndef bad(items=[]): ...\\ndef good(items=None):\\n    items = [] if items is None else items\\n\\n# Bare except — swallows SystemExit, KeyboardInterrupt\\ntry: ...\\nexcept Exception as e: ...        # name the exception\\n\\n# __slots__ kills __dict__ and dynamic attributes — use only on fixed,\\n# memory-sensitive classes you won't extend.\\n\\n# __double_leading is name-mangled to _Class__double_leading.\\n# Surprises you in subclasses, pickling, and monkey-patching.\\n\\nif value is None: ...             # never == None\\n```\\n\\nAvoid `from module import *`. Use `isinstance`, never `type(x) ==`.\\n\\n## Toolchain\\n\\n**black** to format, **isort** for imports, **ruff** to lint. Type annotations on every function signature — no exceptions for \\\"obvious\\\" returns.\\n\\n## Resources and laziness\\n\\nContext managers (`with`) for anything holding a resource. Generators for lazy iteration over anything you would otherwise materialize into a list.\\n\\n## Security\\n\\n- Read secrets with `os.environ[\\\"API_KEY\\\"]`, never `.get()` — a missing secret must raise `KeyError` at startup, not surface as `None` at request time.\\n- `python-dotenv` loads a local `.env` in development only. Never commit one.\\n- `bandit -r src/` for static security analysis.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12534-33ee-76e0-b69a-85acfb8ebabe","create_time":1791625545.004021}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
