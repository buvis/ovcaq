+import os
+import subprocess
+import sys
+from pathlib import Path
+
+name, budget = sys.argv[1:3]
+args = sys.argv[3:]
+result = subprocess.run(args, env=dict(os.environ, UV_CACHE_DIR='/private/tmp/ovcaq-rework-uv-cache'), capture_output=True, text=True, timeout=int(budget))
