+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0166qycZKLkj6VCfe6HQhc2A","type":"tool_result","content":"1\t\"\"\"Raw-first rejection of native frames containing invalid Unicode scalars.\"\"\"\n2\t\n3\timport copy\n4\timport errno\n5\timport hashlib\n6\timport json\n7\timport os\n8\tfrom collections.abc import Iterator\n9\tfrom pathlib import Path\n10\tfrom typing import Any\n11\t\n12\timport pytest\n13\t\n14\tfrom ovcaq.config import AgentSettings\n15\tfrom ovcaq.drivers.codex import CodexDriver\n16\tfrom ovcaq.events import (\n17\t    Observation,\n18\t    ObservationType,\n19\t    observation_from_record,\n20\t    summary_record,\n21\t)\n22\tfrom ovcaq.events.tail import NormalizedEventWriter, RawFirstDecoder\n23\tfrom ovcaq.runtime.session import SessionEvidenceWriter\n24\t\n25\t\n26\tdef native_unicode_driver() -> CodexDriver:\n27\t    return CodexDriver(\n28\t        AgentSettings(\n29\t            name=\"codex\",\n30\t            command=(\"fixture-wrapper\",),\n31\t            tiers={\"standard\": \"fixture-model\"},\n32\t            environment={},\n33\t            options={},\n34\t        ),\n35\t        run_id=\"unicode-run\",\n36\t    )\n37\t\n38\t\n39\tdef native_unicode_record(kind: str) -> dict[str, Any]:\n40\t    return {\n41\t        \"startup\": {\"type\": \"thread.started\", \"thread_id\": \"poisoned-parent\"},\n42\t        \"completion\": {\n43\t            \"type\": \"turn.completed\",\n44\t            \"usage\": {\n45\t                \"input_tokens\": 99,\n46\t                \"cached_input_tokens\": 9,\n47\t                \"output_tokens\": 88,\n48\t            },\n49\t        },\n50\t        \"collaboration\": {\n51\t            \"type\": \"item.started\",\n52\t            \"item\": {\n53\t                \"id\": \"collab-1\",\n54\t                \"type\": \"collab_tool_call\",\n55\t                \"tool\": \"spawn_agent\",\n56\t                \"sender_thread_id\": \"healthy-parent\",\n57\t                \"receiver_thread_ids\": [\"child-1\"],\n58\t                \"prompt\": \"Inspect receiver\",\n59\t                \"agents_states\": {\n60\t                    \"child-1\": {\"status\": \"running\", \"message\": \"Receiver evidence\"}\n61\t                },\n62\t                \"status\": \"in_progress\",\n63\t            },\n64\t        },\n65\t    }[kind]\n66\t\n67\t\n68\tdef unicode_adapter_state(driver: CodexDriver) -> tuple[Any, ...]:\n69\t    return copy.deepcopy(\n70\t        tuple(\n71\t            getattr(driver, field)\n72\t            for field in (\"_session_id\", \"_usage\", \"_thread_conflict\", \"_identities\")\n73\t        )\n74\t    )\n75\t\n76\t\n77\tdef unicode_normalized(path: Path) -> tuple[Observation, ...]:\n78\t    return tuple(\n79\t        observation_from_record(json.loads(line))\n80\t        for line in path.read_bytes().splitlines()\n81\t    )\n82\t\n83\t\n84\t@pytest.fixture\n85\tdef unicode_tail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[Any]:\n86\t    raw_path = tmp_path / \"raw.jsonl\"\n87\t    normalized_path = tmp_path / \"normalized.jsonl\"\n88\t    raw = SessionEvidenceWriter(raw_path, max_bytes=1 << 20, min_free_bytes=0)\n89\t    normalized = NormalizedEventWriter(\n90\t        normalized_path, max_bytes=1 << 20, min_free_bytes=0\n91\t    )\n92\t    raw_information = raw_path.stat()\n93\t    durable: list[bytes] = []\n94\t    real_fsync = os.fsync\n95\t\n96\t    def sync(descriptor: int) -> None:\n97\t        real_fsync(descriptor)\n98\t        if os.path.samestat(raw_information, os.fstat(descriptor)):\n99\t            durable.append(raw_path.read_bytes())\n100\t\n101\t    monkeypatch.setattr(os, \"fsync\", sync)\n102\t    driver = native_unicode_driver()\n103\t    decoder = RawFirstDecoder(\n104\t        raw=raw,\n105\t        normalized=normalized,\n106\t        driver=driver,\n107\t        run_id=\"unicode-run\",\n108\t        session_id=\"owned-session\",\n109\t    )\n110\t    try:\n111\t        yield driver, decoder, raw_path, normalized_path, durable\n112\t    finally:\n113\t        normalized.close()\n114\t        raw.close()\n115\t\n116\t\n117\tdef assert_unicode_gap(observations: tuple[Observation, ...], frame: bytes) -> None:\n118\t    assert len(observations) == 1\n119\t    gap = observations[0]\n120\t    assert gap.type is ObservationType.RAW_UNKNOWN\n121\t    assert gap.run_id == \"unicode-run\"\n122\t    assert gap.session_id == \"owned-session\"\n123\t    assert set(gap.payload) == {\"reason\", \"raw_sha256\", \"preview\"}\n124\t    assert gap.payload[\"reason\"] == \"frame contains invalid Unicode scalar value\"\n125\t    assert gap.payload[\"raw_sha256\"] == hashlib.sha256(frame).hexdigest()\n126\t    preview = gap.payload[\"preview\"]\n127\t    assert isinstance(preview, str) and len(preview) <= 512\n128\t    assert \"native-marker\" in preview\n129\t    assert \"synthetic-hidden\" not in preview\n130\t    assert \"[REDACTED]\" in preview\n131\t    assert \"\\x1b\" not in preview\n132\t    preview.encode(\"utf-8\", errors=\"strict\")\n133\t\n134\t\n135\tdef poisoned_unicode_frame(kind: str, location: str, scalar: str) -> bytes:\n136\t    record = native_unicode_record(kind)\n137\t    record = {\n138\t        \"note\": \"native-marker token=synthetic-hidden\\x1b[31m\",\n139\t        \"padding\": \"x\" * 700,\n140\t        **record,\n141\t    }\n142\t    if location == \"native\":\n143\t        if kind == \"startup\":\n144\t            record[\"thread_id\"] = \"poisoned-parent\" + scalar\n145\t        elif kind == \"completion\":\n146\t            record[\"usage\"][\"ignored\"] = scalar\n147\t        else:\n148\t            record[\"item\"][\"agents_states\"][\"child-1\"][\"message\"] = scalar\n149\t    elif location == \"ignored-value\":\n150\t        record[\"ignored\"] = scalar\n151\t    elif location == \"nested-value\":\n152\t        record[\"ignored\"] = [{\"deeper\": [None, scalar]}]\n153\t    elif location == \"nested-key\":\n154\t        record[\"ignored\"] = [{\"deeper\": [{scalar: \"ignored\"}]}]\n155\t    else:\n156\t        record[\"password\"] = scalar\n157\t    return json.dumps(record, ensure_ascii=True).encode()\n158\t\n159\t\n160\t@pytest.mark.parametrize(\"scalar\", [chr(0xD800), chr(0xDFFF)], ids=[\"high\", \"low\"])\n161\t@pytest.mark.parametrize(\"kind\", [\"startup\", \"completion\", \"collaboration\"])\n162\t@pytest.mark.parametrize(\n163\t    \"location\",\n164\t    [\"native\", \"ignored-value\", \"nested-value\", \"nested-key\", \"secret\"],\n165\t)\n166\t@pytest.mark.parametrize(\"initialized\", [False, True])\n167\t@pytest.mark.parametrize(\n168\t    (\"framing\", \"digest_suffix\"),\n169\t    [(b\"\\n\", b\"\"), (b\"\\r\\n\", b\"\"), (b\"\", b\"\"), (b\"\\r\\r\\n\", b\"\\r\")],\n170\t    ids=[\"newline\", \"crlf\", \"unterminated\", \"one-framing-cr\"],\n171\t)\n172\tdef test_unsafe_native_frame_is_one_durable_gap_without_adapter_mutation(\n173\t    unicode_tail: Any,\n174\t    scalar: str,\n175\t    kind: str,\n176\t    location: str,\n177\t    initialized: bool,\n178\t    framing: bytes,\n179\t    digest_suffix: bytes,\n180\t) -> None:\n181\t    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n182\t    emitted: tuple[Observation, ...] = ()\n183\t    if initialized:\n184\t        startup = {\"type\": \"thread.started\", \"thread_id\": \"healthy-parent\"}\n185\t        emitted += decoder.feed(json.dumps(startup).encode() + b\"\\n\")\n186\t        emitted += decoder.feed(\n187\t            json.dumps(native_unicode_record(\"collaboration\")).encode() + b\"\\n\"\n188\t        )\n189\t    before = unicode_adapter_state(driver)\n190\t    previous = raw_path.read_bytes()\n191\t    frame = poisoned_unicode_frame(kind, location, scalar)\n192\t    wire = frame + framing\n193\t    assert decoder.feed(wire[:17]) == ()\n194\t    assert unicode_adapter_state(driver) == before\n195\t    rejected = decoder.feed(wire[17:]) + decoder.finish()\n196\t    assert_unicode_gap(rejected, frame + digest_suffix)\n197\t    assert unicode_adapter_state(driver) == before\n198\t    assert raw_path.read_bytes() == previous + wire\n199\t    assert durable[-1] == previous + wire\n200\t    assert unicode_normalized(normalized_path) == emitted + rejected\n201\t\n202\t\n203\t@pytest.mark.parametrize(\"kind\", [\"startup\", \"completion\", \"collaboration\"])\n204\tdef test_rejected_native_frame_preserves_later_healthy_identity_usage_and_terminal(\n205\t    unicode_tail: Any,\n206\t    kind: str,\n207\t) -> None:\n208\t    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n209\t    frame = poisoned_unicode_frame(kind, \"nested-key\", \"\\udc00\")\n210\t    rejected = decoder.feed(frame + b\"\\n\")\n211\t    assert_unicode_gap(rejected, frame)\n212\t    startup = {\"type\": \"thread.started\", \"thread_id\": \"healthy-parent\"}\n213\t    collaboration = native_unicode_record(\"collaboration\")\n214\t    completion = {\n215\t        \"type\": \"turn.completed\",\n216\t        \"usage\": {\n217\t            \"input_tokens\": 3,\n218\t            \"cached_input_tokens\": 0,\n219\t            \"cache_write_input_tokens\": 0,\n220\t            \"output_tokens\": 2,\n221\t        },\n222\t    }\n223\t    healthy_wire = b\"\".join(\n224\t        json.dumps(record).encode() + b\"\\n\"\n225\t        for record in (startup, collaboration, completion)\n226\t    )\n227\t    healthy = decoder.feed(healthy_wire) + decoder.finish()\n228\t    assert all(value.type is not ObservationType.RAW_UNKNOWN for value in healthy)\n229\t    assert {value.type for value in healthy} >= {\n230\t        ObservationType.SESSION_STARTED,\n231\t        ObservationType.LANE_STARTED,\n232\t        ObservationType.USAGE_UPDATED,\n233\t        ObservationType.SESSION_COMPLETED,\n234\t    }\n235\t    assert all(value.session_id == \"owned-session\" for value in healthy)\n236\t    assert driver._session_id == \"healthy-parent\"\n237\t    summary = driver.summarize((*rejected, *healthy), 0