+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EkK5mjRMYHGhgmZp4MrGMg","type":"tool_result","content":"1\t\"\"\"Real-child continuity and publication failures at the Unicode gap boundary.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport errno\n6\timport json\n7\timport os\n8\timport signal\n9\tfrom pathlib import Path\n10\t\n11\timport pytest\n12\tfrom tests.runtime.test_supervisor_process import Step, harness, stopped\n13\t\n14\tfrom ovcaq.events import (\n15\t    Observation,\n16\t    ObservationType,\n17\t    observation_from_record,\n18\t    summary_record,\n19\t)\n20\tfrom ovcaq.events.tail import NormalizedEventWriter\n21\tfrom ovcaq.runtime.process import OwnedProcess\n22\t\n23\t\n24\tdef continuity_wires() -> tuple[bytes, bytes]:\n25\t    unsafe_records = (\n26\t        {\n27\t            \"type\": \"thread.started\",\n28\t            \"thread_id\": \"poisoned-parent\",\n29\t            \"vendor\": {\"value\": \"\\ud800\"},\n30\t        },\n31\t        {\n32\t            \"type\": \"turn.completed\",\n33\t            \"usage\": {\n34\t                \"input_tokens\": 99,\n35\t                \"cached_input_tokens\": 9,\n36\t                \"output_tokens\": 88,\n37\t            },\n38\t            \"vendor\": {\"\\udc00\": \"unsafe key\"},\n39\t        },\n40\t        {\n41\t            \"type\": \"item.started\",\n42\t            \"item\": {\n43\t                \"id\": \"collab-1\",\n44\t                \"type\": \"collab_tool_call\",\n45\t                \"tool\": \"spawn_agent\",\n46\t                \"sender_thread_id\": \"poisoned-parent\",\n47\t                \"receiver_thread_ids\": [\"child-1\"],\n48\t                \"agents_states\": {\n49\t                    \"child-1\": {\"status\": \"running\", \"message\": \"\\ud800\"}\n50\t                },\n51\t                \"status\": \"in_progress\",\n52\t            },\n53\t        },\n54\t    )\n55\t    healthy_records = (\n56\t        {\"type\": \"thread.started\", \"thread_id\": \"healthy-parent\"},\n57\t        {\n58\t            \"type\": \"turn.completed\",\n59\t            \"usage\": {\n60\t                \"input_tokens\": 3,\n61\t                \"cached_input_tokens\": 0,\n62\t                \"cache_write_input_tokens\": 0,\n63\t                \"output_tokens\": 2,\n64\t            },\n65\t        },\n66\t    )\n67\t    unsafe_wire = b\"\".join(\n68\t        json.dumps(record).encode() + b\"\\n\" for record in unsafe_records\n69\t    )\n70\t    healthy_wire = b\"\".join(\n71\t        json.dumps(record).encode() + b\"\\n\" for record in healthy_records\n72\t    )\n73\t    return unsafe_wire, healthy_wire\n74\t\n75\t\n76\tdef assert_continuity_records(session_dir: Path) -> None:\n77\t    observations = tuple(\n78\t        observation_from_record(json.loads(line))\n79\t        for line in (session_dir / \"normalized.jsonl\").read_bytes().splitlines()\n80\t    )\n81\t    assert [item.type for item in observations[:3]] == [ObservationType.RAW_UNKNOWN] * 3\n82\t    assert {item.type for item in observations[3:]} >= {\n83\t        ObservationType.SESSION_STARTED,\n84\t        ObservationType.USAGE_UPDATED,\n85\t        ObservationType.SESSION_COMPLETED,\n86\t    }\n87\t    assert all(\n88\t        item.type is not ObservationType.RAW_UNKNOWN for item in observations[3:]\n89\t    )\n90\t    assert all(item.session_id == session_dir.name for item in observations)\n91\t    summary = json.loads((session_dir / \"summary.json\").read_bytes())\n92\t    assert summary[\"returncode\"] == 0\n93\t    assert summary[\"signal\"] is None\n94\t    assert summary[\"timed_out\"] is False\n95\t    assert summary[\"detail\"] is None\n96\t\n97\t\n98\tdef test_real_child_completes_after_unsafe_native_unicode_records(\n99\t    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n100\t) -> None:\n101\t    h = harness(tmp_path, monkeypatch, \"codex\")\n102\t    sentinel = tmp_path / \"normal-exit\"\n103\t    pid_file = tmp_path / \"chi