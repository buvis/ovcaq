e-sonnet/scripts/sonnet-run.sh:65:    echo \"  -t, --tools LIST       Pass --tools=LIST to claude (prompt mode); -t \\\"\\\" grants none\"\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:81:    case $1 in\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:90:        -a|--allow-edits|--allow-tools)\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:91:            # --allow-tools kept as a deprecated spelling of -a; it now grants\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:116:        -t|--tools)\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:120:                echo \"ERROR: -t/--tools requires a value (use -t \\\"\\\" for no tools)\" >&2\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:124:            # `--tools=LIST` as ONE token, never the two-token `--tools LIST`:\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:125:            # claude's flag is variadic (`--tools <tools...>`), so the separate\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:129:            TOOLS=(\"--tools=$2\")\n/Users/bob/.claude/plugins/cache/buvis-plugins/autopilot/0.9.0/skills/use-sonnet/scripts/sonnet-run.sh:203:case $MODE in\n","exit_code":0,"status":"completed"}}
