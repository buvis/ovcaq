n369:    valid_record[\"payload\"] = payload\n370:    decoded = invalid_native_record(valid_record, scalar)\n371:    with pytest.raises(ValueError, match=SCALAR_ERROR):\n372:        observation_from_record(decoded)\n373:\n374:\n375:@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n376:@pytest.mark.parametrize(\n377:    \"interface\",\n378:    [\n379:        \"root\",\n380:        \"value\",\n381:        \"key\",\n382:        \"secret_key\",\n383:        \"provider\",\n384:        \"run_id\",\n385:        \"session_id\",\n386:        \"lane_id\",\n387:        \"summary_session_id\",\n388:        \"failure_detail\",\n389:        \"payload_value\",\n390:        \"payload_key\",\n391:    ],\n392:)\n393:def test_text_subclasses_reject_invalid_scalars(interface: str, scalar: str) -> None:\n394:    text = ScalarText(scalar)\n395:    values = {\n396:        \"root\": text,\n397:        \"value\": {\"value\": text},\n398:        \"key\": {text: \"valid\"},\n399:        \"secret_key\": {ScalarText(f\"password{scalar}\"): \"valid\"},\n400:    }\n401:    with pytest.raises(ValueError, match=SCALAR_ERROR):\n402:        if interface in values:\n403:            sanitize_json(values[interface])\n404:        elif interface == \"summary_session_id\":\n405:            make_summary(session_id=text)\n406:        elif interface == \"failure_detail\":\n407:            make_summary(failure_detail=text)\n408:        elif interface == \"payload_value\":\n409:            make_observation(payload={\"message\": text})\n410:        elif interface == \"payload_key\":\n411:            make_observation(payload={\"message\": {text: \"valid\"}})\n412:        else:\n413:            make_observation(**{interface: text})\n414:\n415:\n416:@pytest.mark.parametrize(\"text\", [text for text in VALID_SCALARS if text])\n417:@pytest.mark.parametrize(\n418:    \"event_type\", [ObservationType.USAGE_UPDATED, ObservationType.SESSION_COMPLETED]\n419:)\n420:def test_usage_and_completion_preserve_valid_unicode_scalars(\n421:    event_type: ObservationType, text: str\n422:) -> None:\n423:    payload = (\n424:        {\"usage\": USAGE_DATA, \"identity\": text}\n425:        if event_type is ObservationType.USAGE_UPDATED\n426:        else {\"usage\": USAGE_DATA, \"message\": text, \"extra\": {text: text}}\n427:    )\n428:    observation = make_observation(type=event_type, payload=payload)\n429:    record = observation_record(observation)\n430:    restored = observation_from_record(\n431:        json.loads(json.dumps(record, ensure_ascii=True))\n432:    )\n433:\n434:    assert record[\"payload\"] == payload\n435:    assert restored.type is event_type\n436:    assert observation_record(restored)[\"payload\"] == payload\n437:\n438:\n439:@pytest.mark.parametrize(\"text\", VALID_SCALARS)\n440:def test_shared_models_and_serializers_preserve_valid_unicode_scalars(\n441:    text: str,\n442:) -> None:\n443:    payload = {\"message\": [text, {text: text}, None]}\n444:    observation = make_observation(\n445:        provider=text or \"test-driver\",\n446:        run_id=text or \"run-1\",\n447:        session_id=text or None,\n448:        lane_id=text or None,\n449:        payload=payload,\n450:    )\n451:    summary = make_summary(session_id=text or None, failure_detail=text)\n452:\n453:    assert sanitize_json(payload) == payload\n454:    assert sanitize_json(None) is None\n455:    assert sanitize_json(text) == text\n456:    record = observation_record(observation)\n457:    assert record[\"payload\"] == payload\n458:    for field in (\"provider\", \"run_id\", \"session_id\", \"lane_id\"):\n459:        assert record[field] == getattr(observation, field)\n460:    restored = observation_from_record(\n461:        json.loads(json.dumps(record, ensure_ascii=False))\n462:    )\n463:    assert observation_record(restored)[\"payload\"] == payload\n464:    assert restored.session_id == observation.session_id\n465:    assert restored == observation\n466:    assert summary.failure_detail == text\n467:    assert summary_record(summary)[\"session_id\"] == (text or None)\n468:    assert summary_record(summary)[\"failure_detail\"] == text\n469:    assert_scalar_json(record)\n470:    assert_scalar_json(summary_record(summary))\n471:\n472:\n473:def test_valid_escaped_surrogate_pair_decodes_to_supported_scalar() -> None:\n474:    scalar = json.loads(r'\"\\ud83d\\ude80\"')\n475:    assert scalar == \"\\U0001f680\"\n476:    observation = make_observation(\n477:        provider=scalar,\n478:        run_id=scalar,\n479:        session_id=scalar,\n480:        lane_id=scalar,\n481:        payload={\"message\": [scalar, {scalar: scalar}]},\n482:    )\n483:    summary = make_summary(session_id=scalar, failure_detail=scalar)\n484:\n485:    assert sanitize_json({scalar: scalar}) == {scalar: scalar}\n486:    record = observation_record(observation)\n487:    restored = observation_from_record(\n488:        json.loads(json.dumps(record, ensure_ascii=True))\n489:    )\n490:    assert restored == observation\n491:    assert restored.provider == scalar\n492:    assert observation_record(restored)[\"payload\"] == {\n493:        \"message\": [scalar, {scalar: scalar}]\n494:    }\n495:    assert summary.session_id == scalar\n496:    assert summary.failure_detail == scalar\n497:    assert summary_record(summary)[\"session_id\"] == scalar\n498:    assert summary_record(summary)[\"failure_detail\"] == scalar\n499:    assert_scalar_json(record)\n500:    assert_scalar_json(summary_record(summary))\n","exit_code":0,"duration":{"secs":0,"nanos":2209},"formatted_output":"1:\"\"\"Unicode scalar contracts for shared observations, independent of drivers.\"\"\"\n2:\n3:import json\n4:from datetime import UTC, datetime\n5:from typing import Any\n6:\n7:import pytest\n8:\n9:from ovcaq.events import (\n10:    FailureClass,\n11:    Observation,\n12:    ObservationType,\n13:    SessionSummary,\n14:    observation_from_record,\n15:    observation_record,\n16:    sanitize_json,\n17:    summary_record,\n18:)\n19:\n20:NOW = datetime(2026, 9, 26, 12, 30, 15, 123456, tzinfo=UTC)\n21:INVALID_SCALARS = (\n22:    \"\\ud800\",\n23:    \"\\ud801\",\n24:    \"\\udbff\",\n25:    \"\\udc00\",\n26:    \"\\udc01\",\n27:    \"\\udfff\",\n28:    \"\\ud83d\\ude80\",\n29:)\n30:SCALAR_IDS = [\n31:    \"high-start\",\n32:    \"high-interior\",\n33:    \"high-end\",\n34:    \"low-start\",\n35:    \"low-interior\",\n36:    \"low-end\",\n37:    \"uncombined-pair\",\n38:]\n39:VALID_SCALARS = (\n40:    \"\",\n41:    \"Žluťoučký 日本語\",\n42:    \"é\",\n43:    \"العربية हिन्दी 한국어\",\n44:    \"e\\u0301\",\n45:    \"\\x00\\t\\n\\x1f\\x7f\",\n46:    \"\\ud7ff\\ue000\",\n47:    \"\\U00010000\\U0010ffff\",\n48:    \"\\U0001f680\",\n49:)\n50:SCALAR_ERROR = r\"^Strings must contain only Unicode scalar values$\"\n51:USAGE_DATA = {\n52:    \"input_tokens\": 1,\n53:    \"output_tokens\": 2,\n54:    \"cache_creation_input_tokens\": None,\n55:    \"cache_read_input_tokens\": None,\n56:    \"tool_uses\": None,\n57:    \"cost_usd\": None,\n58:    \"estimated\": False,\n59:}\n60:\n61:\n62:def make_observation(**changes: Any) -> Observation:\n63:    fields = {\n64:        \"protocol_version\": 1,\n65:        \"timestamp\": NOW,\n66:        \"provider\": \"test-driver\",\n67:        \"run_id\": \"run-1\",\n68:        \"session_id\": \"session-1\",\n69:        \"lane_id\": \"lane-1\",\n70:        \"type\": ObservationType.ACTIVITY_MESSAGE,\n71:        \"payload\": {\"message\": \"working\"},\n72:    }\n73:    fields.update(changes)\n74:    return Observation(**fields)\n75:\n76:\n77:def make_summary(**changes: Any) -> SessionSummary:\n78:    fields = {\n79:        \"success\": False,\n80:        \"session_id\": \"session-1\",\n81:        \"failure_class\": FailureClass.AGENT,\n82:        \"failure_detail\": \"request failed\",\n83:        \"rate_limit_reset_at\": None,\n84:        \"usage\": None,\n85:    }\n86:    fields.update(changes)\n87:    return SessionSummary(**fields)\n88:\n89:\n90:def assert_scalar_json(value: object) -> None:\n91:    if isinstance(value, dict):\n92:        for key, child in value.items():\n93:            key.encode(\"utf-8\", errors=\"strict\")\n94:            assert_scalar_json(child)\n95:    elif isinstance(value, list):\n96:        for child in value:\n97:            assert_scalar_json(child)\n98:    elif isinstance(value, str):\n99:        value.encode(\"utf-8\", errors=\"strict\")\n100:\n101:\n102:def replace_record_string(value: Any, original: str, replacement: str) -> Any:\n103:    if isinstance(value, dict):\n104:        return {\n105:            replacement if key == original else key: replace_record_string(\n106:                child, original, replacement\n107:            )\n108:            for key, child in value.items()\n109:        }\n110:    if isinstance(value, list):\n111:        return [replace_record_string(child, original, replacement) for child in value]\n112:    return replacement if value == original else value\n113:\n114:\n115:def positioned_scalar(scalar: str, position: str) -> str:\n116:    if position == \"middle\":\n117:        return f\"prefix{scalar}suffix\"\n118:    if position == \"long_prefix\":\n119:        return f\"{'a' * 96}{scalar}suffix\"\n120:    return scalar\n121:\n122:\n123:def invalid_native_record(record: dict[str, Any], scalar: str) -> dict[str, Any]:\n124:    # JSON decoding combines adjacent high/low escapes into a valid scalar.\n125:    # A caller-supplied Python record still must reject uncombined code units.\n126:    if scalar == \"\\ud83d\\ude80\":\n127:        return record\n128:    return json.loads(json.dumps(record, ensure_ascii=True))\n129:\n130:\n131:def nested_json(value: Any, depth: int) -> Any:\n132:    for index in range(depth):\n133:        if index % 3 == 0:\n134:            value = {\"nested\": value}\n135:        elif index % 3 == 1:\n136:            value = [value]\n137:        else:\n138:            value = (value,)\n139:    return value\n140:\n141:\n142:def payload_for_type(event_type: ObservationType) -> dict[str, Any]:\n143:    if event_type is ObservationType.USAGE_UPDATED:\n144:        return {\"usage\": USAGE_DATA, \"identity\": \"valid\"}\n145:    if event_type is ObservationType.SESSION_COMPLETED:\n146:        return {\"usage\": USAGE_DATA, \"message\": \"valid\"}\n147:    if event_type is ObservationType.SESSION_FAILED:\n148:        return {\"failure_class\": FailureClass.AGENT.value, \"detail\": \"valid\"}\n149:    if event_type is ObservationType.RATE_LIMIT_STARTED:\n150:        return {\"reset_at\": None, \"window\": None, \"detail\": \"valid\"}\n151:    if event_type is ObservationType.RAW_UNKNOWN:\n152:        return {\"reason\": \"valid\", \"raw_sha256\": \"0\" * 64, \"preview\": \"valid\"}\n153:    return {\"message\": \"valid\", \"total_tokens\": 0}\n154:\n155:\n156:class ScalarText(str):\n157:    \"\"\"An ordinary string subclass accepted by the public text interfaces.\"\"\"\n158:\n159:\n160:@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n161:@pytest.mark.parametrize(\"field\", [\"provider\", \"run_id\", \"session_id\", \"lane_id\"])\n162:@pytest.mark.parametrize(\"position\", [\"start\", \"middle\", \"long_prefix\"])\n163:def test_observation_rejects_invalid_scalar_identifiers(\n164:    field: str, scalar: str, position: str\n165:) -> None:\n166:    with pytest.raises(ValueError, match=SCALAR_ERROR):\n167:        make_observation(**{field: positioned_scalar(scalar, position)})\n168:\n169:\n170:@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n171:@pytest.mark.parametrize(\n172:    \"location\",\n173:    [\n174:        \"value\",\n175:        \"nested_value\",\n176:        \"nested_key\",\n177:        \"tuple\",\n178:        \"tuple_key\",\n179:        \"secret\",\n180:        \"secret_key\",\n181:        \"deep_value\",\n182:        \"deep_key\",\n183:    ],\n184:)\n185:@pytest.mark.parametrize(\"position\", [\"start\", \"middle\", \"long_prefix\"])\n186:def t