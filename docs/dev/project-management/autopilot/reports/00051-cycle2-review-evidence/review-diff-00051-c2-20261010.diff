+{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c 'from pathlib import Path; print(Path(\\\"tests/drivers/test_codex_detail_safety.py\\\").read_text()); print(Path(\\\"tests/events/test_unicode_frames.py\\\").read_text())' \"","aggregated_output":"import json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\n\nimport pytest\n\nfrom ovcaq.config import AgentSettings\nfrom ovcaq.drivers.codex import CodexDriver\nfrom ovcaq.drivers.codex_events import bounded_detail\nfrom ovcaq.events.model import Observation\nfrom ovcaq.events.tail import NormalizedEventWriter\n\nTOKEN = \"sk-\" + \"abcdefghijklmnopqrstuvwxyz0123456789ABCDEF\"\nCAP_REPRODUCER = \"x\" * 4080 + \" sk-abc\\x1b[0mdefghijklmnopqrstuvwxyz0123456789ABCDEF\"\nSPLIT_DETAILS = [\n    pytest.param(CAP_REPRODUCER, \"x\" * 4080 + \" [REDACTED]\", id=\"exact-cap\"),\n    pytest.param(\n        \"Diagnostic sk-abc\\x1b[31mdefghijklmnopqrstuvwxyz0123456789ABCDEF\",\n        \"Diagnostic [REDACTED]\",\n        id=\"ansi-split\",\n    ),\n    pytest.param(\n        \"Diagnostic sk-abc\\x00defghijklmnopqrstuvwxyz0123456789ABCDEF\",\n        \"Diagnostic [REDACTED]\",\n        id=\"nul-split\",\n    ),\n    pytest.param(\n        \"Bearer \" + TOKEN,\n        \"Bearer [REDACTED]\",\n        id=\"bearer\",\n    ),\n    pytest.param(\n        \"Diagnostic \\x1b]0;\" + TOKEN + \"\\x07 After\",\n        \"Diagnostic ]0;[REDACTED] After\",\n        id=\"osc-controls\",\n    ),\n    *[\n        pytest.param(\n            \"Before \" + token[:6] + control + token[6:] + \" After\",\n            \"Before [REDACTED] After\",\n            id=f\"alternate-{index}-{control_id}\",\n        )\n        for index, token in enumerate([\"sk-\" + \"Q7\" * 20, \"sk-\" + \"4bcD\" * 12])\n        for control_id, control in [\n            (\"plain\", \"\"),\n            (\"ansi\", \"\\x1b[0m\"),\n            (\"nul\", \"\\x00\"),\n        ]\n    ],\n]\n\n\n@pytest.fixture\ndef driver() -> CodexDriver:\n    return CodexDriver(\n        AgentSettings(\n            name=\"codex\",\n            command=(\"fixture-wrapper\",),\n            tiers={\"standard\": \"fixture-model\"},\n            environment={},\n            options={},\n        ),\n        run_id=\"detail-safety-run\",\n    )\n\n\ndef decode_failure(\n    driver: CodexDriver, kind: str, detail: str\n) -> tuple[Observation, ...]:\n    record = (\n        {\"type\": \"error\", \"message\": detail}\n        if kind == \"error\"\n        else {\"type\": \"turn.failed\", \"error\": {\"message\": detail}}\n    )\n    return driver.decode(json.dumps(record))\n\n\ndef assert_safe_details(\n    tmp_path: Path, observations: tuple[Observation, ...], expected: str\n) -> None:\n    assert observations\n    for observation in observations:\n        assert observation.payload[\"detail\"] == expected\n        assert len(observation.payload[\"detail\"]) <= 4096\n        assert \"\\x1b\" not in observation.payload[\"detail\"]\n        assert \"\\x00\" not in observation.payload[\"detail\"]\n        assert TOKEN not in expected\n        assert \"sk-abcdefghijkl\" not in expected\n    path = tmp_path / \"normalized.jsonl\"\n    writer = NormalizedEventWriter(path, max_bytes=1 << 20, min_free_bytes=0)\n    try:\n        for observation in observations:\n            writer.write(observation)\n        writer.flush()\n    finally:\n        writer.close()\n    saved = path.read_bytes()\n    assert TOKEN.encode() not in saved\n    assert b\"sk-abcdefghijkl\" not in saved\n    assert b\"\\\\u001b\" not in saved\n    assert b\"\\\\u0000\" not in saved\n    records = [json.loads(line) for line in saved.splitlines()]\n    assert len(records) == len(observations)\n    assert all(record[\"payload\"][\"detail\"] == expected for record in records)\n\n\n@pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\ndef test_bounded_detail_redacts_reconstructed_tokens_before_capping(\n    detail: str, expected: str\n) -> None:\n    actual = bounded_detail(detail)\n    assert actual == expected\n    assert len(actual) <= 4096\n    assert TOKEN not in actual\n    assert \"sk-abcdefghijkl\" not in actual\n    assert \"\\x1b\" not in actual\n    assert \"\\x00\" not in actual\n\n\n@pytest.mark.parametrize(\n    (\"detail\", \"expected\"),\n    [\n        (\"\", \"\"),\n        (\"x\" * 4095, \"x\" * 4095),\n        (\"x\" * 4096, \"x\" * 4096),\n        (\"x\" * 4097, \"x\" * 4096),\n        (\"y\" * 4095, \"y\" * 4095),\n        (\"y\" * 4096, \"y\" * 4096),\n        (\"y\" * 4097, \"y\" * 4096),\n        (\"Diagnostic \" * 500, (\"Diagnostic \" * 500)[:4096]),\n        (\"OK\", \"OK\"),\n        (\"Warning!\", \"Warning!\"),\n        (\"First\\nSecond\", \"First\\nSecond\"),\n        (\"First\\tSecond\", \"First\\tSecond\"),\n        (\n            \"A\\x1b[31mB\\x1b[0m\\x00\\x08\\x0b\\x0c\\x0e\\x1f\\x7f\\t\\nC\",\n            \"AB\\t\\nC\",\n        ),\n        (\"\\x00\" * 4096 + \"Visible\", \"Visible\"),\n    ],\n)\ndef test_bounded_detail_preserves_printable_text_and_caps_after_control_removal(\n    detail: str, expected: str\n) -> None:\n    actual = bounded_detail(detail)\n    assert actual == expected\n    assert len(actual) <= 4096\n\n\n@pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n@pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\ndef test_native_failure_redacts_diagnostic_payload_and_saved_jsonl(\n    driver: CodexDriver,\n    tmp_path: Path,\n    kind: str,\n    detail: str,\n    expected: str,\n) -> None:\n    observations = decode_failure(driver, kind, detail)\n    assert [value.type for value in observations] == [\n        \"activity.message\" if kind == \"error\" else \"session.failed\"\n    ]\n    assert observations[0].payload[\"failure_class\"] == \"unknown\"\n    if kind == \"error\":\n        assert observations[0].payload[\"kind\"] == \"error\"\n        assert observations[0].payload[\"reset_at\"] is None\n    assert_safe_details(tmp_path, observations, expected)\n\n\n@pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n@pytest.mark.parametrize(\"detail\", [\"OK\", \"Warning!\", \"First\\nSecond\", \"First\\tSecond\"])\ndef test_native_failure_preserves_short_and_formatted_saved_details(\n    driver: CodexDriver, tmp_path: Path, kind: str, detail: str\n) -> None:\n    observations = decode_failure(driver, kind, detail)\n    assert [value.type for value in observations] == [\n        \"activity.message\" if kind == \"error\" else \"session.failed\"\n    ]\n    assert observations[0].payload[\"failure_class\"] == \"unknown\"\n    assert_safe_details(tmp_path, observations, detail)\n\n\n@pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n@pytest.mark.parametrize(\"seconds\", [30, 21600, -1, 21601])\ndef test_native_rate_limit_uses_full_text_for_reset_and_saves_bounded_redaction(\n    driver: CodexDriver, tmp_path: Path, kind: str, seconds: int\n) -> None:\n    detail = CAP_REPRODUCER + f\" HTTP 429; retry after {seconds} seconds\"\n    observations = decode_failure(driver, kind, detail)\n    if kind == \"error\":\n        assert [value.type for value in observations] == [\"activity.message\"]\n        failure = rate = observations[0]\n        assert failure.payload[\"kind\"] == \"error\"\n    else:\n        assert sorted(value.type for value in observations) == [\n            \"rate_limit.started\",\n            \"session.failed\",\n        ]\n        failure = next(\n            value for value in observations if value.type == \"session.failed\"\n        )\n        rate = next(\n            value for value in observations if value.type == \"rate_limit.started\"\n        )\n        assert rate.payload[\"window\"] is None\n    assert failure.payload[\"failure_class\"] == \"rate_limit\"\n    reset_at = rate.payload[\"reset_at\"]\n    if 0 <= seconds <= 21600:\n        assert isinstance(reset_at, str)\n        actual = datetime.fromisoformat(reset_at)\n        assert actual.utcoffset() == timedelta(0)\n        expected_reset = rate.timestamp + timedelta(seconds=seconds)\n        assert abs((actual - expected_reset).total_seconds()) < 1\n    else:\n        assert reset_at is None\n    expected_detail = (\n        \"x\" * 4080 + \" [REDACTED]\" + f\" HTTP 429; retry after {seconds} seconds\"\n    )[:4096]\n    assert_safe_details(tmp_path, observations, expected_detail)\n\n\n@pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n@pytest.mark.parametrize(\n    (\"native_suffix\", \"expected_class\"),\n    [\n        (\n            \"Unauthorized: HTTP 401; HTTP 429; retry after 30 seconds\",\n            \"authentication\",\n        ),\n        (\"Sandbox denied: HTTP 403\", \"permission\"),\n        (\"Connection reset: HTTP 503\", \"connectivity\"),\n        (\"Request timed out\", \"timeout\"),\n        (\"Unau\\x1b[0mthorized\", \"unknown\"),\n    ],\n)\ndef test_native_failure_preserves_full_original_classification_before_cleaning(\n    driver: CodexDriver, kind: str, native_suffix: str, expected_class: str\n) -> None:\n    detail = \"x\" * 4096 + \" \" + native_suffix\n    observations = decode_failure(driver, kind, detail)\n    failure = next(\n        value\n        for value in observations\n        if value.type == (\"activity.message\" if kind == \"error\" else \"session.failed\")\n    )\n    assert failure.payload[\"failure_class\"] == expected_class\n    assert failure.payload[\"detail\"] == \"x\" * 4096\n\n\n@pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\ndef test_receiver_lane_redacts_message_payload_and_saved_jsonl(\n    driver: CodexDriver, tmp_path: Path, detail: str, expected: str\n) -> None:\n    driver.decode(json.dumps({\"type\": \"thread.started\", \"thread_id\": \"parent\"}))\n    observations = driver.decode(\n        json.dumps(\n            {\n                \"type\": \"item.started\",\n                \"item\": {\n                    \"id\": \"collab-1\",\n                    \"type\": \"collab_tool_call\",\n                    \"tool\": \"spawn_agent\",\n                    \"sender_thread_id\": \"parent\",\n                    \"receiver_thread_ids\": [\"child-1\"],\n                    \"prompt\": \"Inspect receiver\",\n                    \"agents_states\": {\n                        \"child-1\": {\"status\": \"running\", \"message\": detail}\n                    },\n                    \"status\": \"in_progress\",\n                },\n            }\n        )\n    )\n    lanes = tuple(value for value in observations if value.lane_id == \"child-1\")\n    assert len(lanes) == 1\n    assert lanes[0].type == \"lane.started\"\n    lane_detail = lanes[0].payload[\"detail\"]\n    assert isinstance(lane_detail, str)\n    assert \"\\x1b\" not in lane_detail\n    assert \"\\x00\" not in lane_detail\n    if detail != CAP_REPRODUCER:\n        assert expected in lane_detail\n    assert_safe_details(tmp_path, lanes, lane_detail)\n\n\"\"\"Raw-first rejection of native frames containing invalid Unicode scalars.\"\"\"\n\nimport copy\nimport errno\nimport hashlib\nimport json\nimport os\nfrom collections.abc import Iterator\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom ovcaq.config import AgentSettings\nfrom ovcaq.drivers.codex import CodexDriver\nfrom ovcaq.events import (\n    Observation,\n    ObservationType,\n    observation_from_record,\n    summary_record,\n)\nfrom ovcaq.events.tail import NormalizedEventWriter, RawFirstDecoder\nfrom ovcaq.runtime.session import SessionEvidenceWriter\n\n\ndef native_unicode_driver() -> CodexDriver:\n    return CodexDriver(\n        AgentSettings(\n            name=\"codex\",\n            command=(\"fixture-wrapper\",),\n            tiers={\"standard\": \"fixture-model\"},\n            environment={},\n            options={},\n        ),\n        run_id=\"unicode-run\",\n    )\n\n\ndef native_unicode_record(kind: str) -> dict[str, Any]:\n    return {\n        \"startup\": {\"type\": \"thread.started\", \"thread_id\": \"poisoned-parent\"},\n        \"completion\": {\n            \"type\": \"turn.completed\",\n            \"usage\": {\n                \"input_tokens\": 99,\n                \"cached_input_tokens\": 9,\n                \"output_tokens\": 88,\n            },\n        },\n        \"collaboration\": {\n            \"type\": \"item.started\",\n            \"item\": {\n                \"id\": \"collab-1\",\n                \"type\": \"collab_tool_call\",\n                \"tool\": \"spawn_agent\",\n                \"sender_thread_id\": \"healthy-parent\",\n                \"receiver_thread_ids\": [\"child-1\"],\n                \"prompt\": \"Inspect receiver\",\n                \"agents_states\": {\n                    \"child-1\": {\"status\": \"running\", \"message\": \"Receiver evidence\"}\n                },\n                \"status\": \"in_progress\",\n            },\n        },\n    }[kind]\n\n\ndef unicode_adapter_state(driver: CodexDriver) -> tuple[Any, ...]:\n    return copy.deepcopy(\n        tuple(\n            getattr(driver, field)\n            for field in (\"_session_id\", \"_usage\", \"_thread_conflict\", \"_identities\")\n        )\n    )\n\n\ndef unicode_normalized(path: Path) -> tuple[Observation, ...]:\n    return tuple(\n        observation_from_record(json.loads(line))\n        for line in path.read_bytes().splitlines()\n    )\n\n\n@pytest.fixture\ndef unicode_tail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[Any]:\n    raw_path = tmp_path / \"raw.jsonl\"\n    normalized_path = tmp_path / \"normalized.jsonl\"\n    raw = SessionEvidenceWriter(raw_path, max_bytes=1 << 20, min_free_bytes=0)\n    normalized = NormalizedEventWriter(\n        normalized_path, max_bytes=1 << 20, min_free_bytes=0\n    )\n    raw_information = raw_path.stat()\n    durable: list[bytes] = []\n    real_fsync = os.fsync\n\n    def sync(descriptor: int) -> None:\n        real_fsync(descriptor)\n        if os.path.samestat(raw_information, os.fstat(descriptor)):\n            durable.append(raw_path.read_bytes())\n\n    monkeypatch.setattr(os, \"fsync\", sync)\n    driver = native_unicode_driver()\n    decoder = RawFirstDecoder(\n        raw=raw,\n        normalized=normalized,\n        driver=driver,\n        run_id=\"unicode-run\",\n        session_id=\"owned-session\",\n    )\n    try:\n        yield driver, decoder, raw_path, normalized_path, durable\n    finally:\n        normalized.close()\n        raw.close()\n\n\ndef assert_unicode_gap(observations: tuple[Observation, ...], frame: bytes) -> None:\n    assert len(observations) == 1\n    gap = observations[0]\n    assert gap.type is ObservationType.RAW_UNKNOWN\n    assert gap.run_id == \"unicode-run\"\n    assert gap.session_id == \"owned-session\"\n    assert set(gap.payload) == {\"reason\", \"raw_sha256\", \"preview\"}\n    assert gap.payload[\"reason\"] == \"frame contains invalid Unicode scalar value\"\n    assert gap.payload[\"raw_sha256\"] == hashlib.sha256(frame).hexdigest()\n    preview = gap.payload[\"preview\"]\n    assert isinstance(preview, str) and len(preview) <= 512\n    assert \"native-marker\" in preview\n    assert \"synthetic-hidden\" not in preview\n    assert \"[REDACTED]\" in preview\n    assert \"\\x1b\" not in preview\n    preview.encode(\"utf-8\", errors=\"strict\")\n\n\ndef poisoned_unicode_frame(kind: str, location: str, scalar: str) -> bytes:\n    record = native_unicode_record(kind)\n    record = {\n        \"note\": \"native-marker token=synthetic-hidden\\x1b[31m\",\n        \"padding\": \"x\" * 700,\n        **record,\n    }\n    if location == \"native\":\n        if kind == \"startup\":\n            record[\"thread_id\"] = \"poisoned-parent\" + scalar\n        elif kind == \"completion\":\n            record[\"usage\"][\"ignored\"] = scalar\n        else:\n            record[\"item\"][\"agents_states\"][\"child-1\"][\"message\"] = scalar\n    elif location == \"ignored-value\":\n        record[\"ignored\"] = scalar\n    elif location == \"nested-value\":\n        record[\"ignored\"] = [{\"deeper\": [None, scalar]}]\n    elif location == \"nested-key\":\n        record[\"ignored\"] = [{\"deeper\": [{scalar: \"ignored\"}]}]\n    else:\n        record[\"password\"] = scalar\n    return json.dumps(record, ensure_ascii=True).encode()\n\n\n@pytest.mark.parametrize(\"scalar\", [chr(0xD800), chr(0xDFFF)], ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\"kind\", [\"startup\", \"completion\", \"collaboration\"])\n@pytest.mark.parametrize(\n    \"location\",\n    [\"native\", \"ignored-value\", \"nested-value\", \"nested-key\", \"secret\"],\n)\n@pytest.mark.parametrize(\"initialized\", [False, True])\n@pytest.mark.parametrize(\n    (\"framing\", \"digest_suffix\"),\n    [(b\"\\n\", b\"\"), (b\"\\r\\n\", b\"\"), (b\"\", b\"\"), (b\"\\r\\r\\n\", b\"\\r\")],\n    ids=[\"newline\", \"crlf\", \"unterminated\", \"one-framing-cr\"],\n)\ndef test_unsafe_native_frame_is_one_durable_gap_without_adapter_mutation(\n    unicode_tail: Any,\n    scalar: str,\n    kind: str,\n    location: str,\n    initialized: bool,\n    framing: bytes,\n    digest_suffix: bytes,\n) -> None:\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n    emitted: tuple[Observation, ...] = ()\n    if initialized:\n        startup = {\"type\": \"thread.started\", \"thread_id\": \"healthy-parent\"}\n        emitted += decoder.feed(json.dumps(startup).encode() + b\"\\n\")\n        emitted += decoder.feed(\n            json.dumps(native_unicode_record(\"collaboration\")).encode() + b\"\\n\"\n        )\n    before = unicode_adapter_state(driver)\n    previous = raw_path.read_bytes()\n    frame = poisoned_unicode_frame(kind, location, scalar)\n    wire = frame + framing\n    assert decoder.feed(wire[:17]) == ()\n    assert unicode_adapter_state(driver) == before\n    rejected = decoder.feed(wire[17:]) + decoder.finish()\n    assert_unicode_gap(rejected, frame + digest_suffix)\n    assert unicode_adapter_state(driver) == before\n    assert raw_path.read_bytes() == previous + wire\n    assert durable[-1] == previous + wire\n    assert unicode_normalized(normalized_path) == emitted + rejected\n\n\n@pytest.mark.parametrize(\"kind\", [\"startup\", \"completion\", \"collaboration\"])\ndef test_rejected_native_frame_preserves_later_healthy_identity_usage_and_terminal(\n    unicode_tail: Any,\n    kind: str,\n) -> None:\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n    frame = poisoned_unicode_frame(kind, \"nested-key\", \"\\udc00\")\n    rejected = decoder.feed(frame + b\"\\n\")\n    assert_unicode_gap(rejected, frame)\n    startup = {\"type\": \"thread.started\", \"thread_id\": \"healthy-parent\"}\n    collaboration = native_unicode_record(\"collaboration\")\n    completion = {\n        \"type\": \"turn.completed\",\n        \"usage\": {\n            \"input_tokens\": 3,\n            \"cached_input_tokens\": 0,\n            \"cache_write_input_tokens\": 0,\n            \"output_tokens\": 2,\n        },\n    }\n    healthy_wire = b\"\".join(\n        json.dumps(record).encode() + b\"\\n\"\n        for record in (startup, collaboration, completion)\n    )\n    healthy = decoder.feed(healthy_wire) + decoder.finish()\n    assert all(value.type is not ObservationType.RAW_UNKNOWN for value in healthy)\n    assert {value.type for value in healthy} >= {\n        ObservationType.SESSION_STARTED,\n        ObservationType.LANE_STARTED,\n        ObservationType.USAGE_UPDATED,\n        ObservationType.SESSION_COMPLETED,\n    }\n    assert all(value.session_id == \"owned-session\" for value in healthy)\n    assert driver._session_id == \"healthy-parent\"\n    summary = driver.summarize((*rejected, *healthy), 0)\n    assert summary.success and summary.session_id == \"owned-session\"\n    usage = summary_record(summary)[\"usage\"]\n    assert usage[\"input_tokens\"] == 3 and usage[\"output_tokens\"] == 2\n    assert raw_path.read_bytes() == durable[-1] == frame + b\"\\n\" + healthy_wire\n    assert unicode_normalized(normalized_path) == rejected + healthy\n\n\ndef test_valid_escaped_pair_remains_a_native_startup_record(unicode_tail: Any) -> None:\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n    identity = \"healthy-\\U0001f680\"\n    frame = json.dumps(\n        {\n            \"type\": \"thread.started\",\n            \"thread_id\": identity,\n            \"ignored\": {\"\\U0001f680\": [\"\\U0001f680\"]},\n        },\n        ensure_ascii=True,\n    ).encode()\n    assert b\"\\\\ud83d\\\\ude80\" in frame\n    observations = decoder.feed(frame + b\"\\r\\n\") + decoder.finish()\n    assert len(observations) == 1\n    assert observations[0].type is ObservationType.SESSION_STARTED\n    assert observations[0].payload[\"source_session_id\"] == identity\n    assert observations[0].session_id == \"owned-session\"\n    assert driver._session_id == identity\n    assert raw_path.read_bytes() == durable[-1] == frame + b\"\\r\\n\"\n    assert unicode_normalized(normalized_path) == observations\n\n\n@pytest.mark.parametrize(\n    \"frame\", [b\"not JSON \\\\ud800\", rb'{\"type\":\"thread.started\",\"ignored\":\"\\ud800\"']\n)\ndef test_malformed_and_non_json_frames_keep_native_delegation(\n    unicode_tail: Any,\n    frame: bytes,\n) -> None:\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n    expected = native_unicode_driver().decode(frame.decode())\n    before = unicode_adapter_state(driver)\n    observations = decoder.feed(frame + b\"\\n\") + decoder.finish()\n    assert [(value.type, dict(value.payload)) for value in observations] == [\n        (value.type, dict(value.payload)) for value in expected\n    ]\n    assert all(value.session_id == \"owned-session\" for value in observations)\n    assert all(\n        value.payload[\"reason\"] != \"frame contains invalid Unicode scalar value\"\n        for value in observations\n    )\n    assert unicode_adapter_state(driver) == before\n    assert raw_path.read_bytes() == durable[-1] == frame + b\"\\n\"\n    assert unicode_normalized(normalized_path) == observations\n\n\n@pytest.mark.parametrize(\"stage\", [\"raw\", \"normalized\"])\n@pytest.mark.parametrize(\"error_number\", [errno.ENOSPC, errno.EIO])\ndef test_real_writer_failures_propagate_from_unsafe_native_frames(\n    unicode_tail: Any,\n    monkeypatch: pytest.MonkeyPatch,\n    stage: str,\n    error_number: int,\n) -> None:\n    driver, decoder, raw_path, normalized_path, durable = unicode_tail\n    target = raw_path if stage == \"raw\" else normalized_path\n    information = target.stat()\n    failure = OSError(error_number, \"injected evidence write failure\")\n    real_write = os.write\n\n    def failing_write(descriptor: int, payload: bytes) -> int:\n        if os.path.samestat(information, os.fstat(descriptor)):\n            raise failure\n        return real_write(descriptor, payload)\n\n    before = unicode_adapter_state(driver)\n    frame = poisoned_unicode_frame(\"startup\", \"ignored-value\", \"\\ud800\")\n    with monkeypatch.context() as patch:\n        patch.setattr(os, \"write\", failing_write)\n        with pytest.raises(OSError) as caught:\n            decoder.feed(frame + b\"\\n\")\n    assert caught.value is failure\n    assert unicode_adapter_state(driver) == before\n    assert normalized_path.read_bytes() == b\"\"\n    assert raw_path.read_bytes() == (b\"\" if stage == \"raw\" else frame + b\"\\n\")\n    if stage == \"normalized\":\n        assert durable[-1] == frame + b\"\\n\"\n\n","exit_code":0,"status":"completed"}}
