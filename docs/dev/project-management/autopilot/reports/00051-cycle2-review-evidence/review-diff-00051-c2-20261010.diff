ironment={},\n61:             options={},\n62:         ),\n63:         run_id=\"detail-safety-run\",\n64:     )\n65: \n66: \n67: def decode_failure(\n68:     driver: CodexDriver, kind: str, detail: str\n69: ) -> tuple[Observation, ...]:\n70:     record = (\n71:         {\"type\": \"error\", \"message\": detail}\n72:         if kind == \"error\"\n73:         else {\"type\": \"turn.failed\", \"error\": {\"message\": detail}}\n74:     )\n75:     return driver.decode(json.dumps(record))\n76: \n77: \n78: def assert_safe_details(\n79:     tmp_path: Path, observations: tuple[Observation, ...], expected: str\n80: ) -> None:\n81:     assert observations\n82:     for observation in observations:\n83:         assert observation.payload[\"detail\"] == expected\n84:         assert len(observation.payload[\"detail\"]) <= 4096\n85:         assert \"\\x1b\" not in observation.payload[\"detail\"]\n86:         assert \"\\x00\" not in observation.payload[\"detail\"]\n87:         assert TOKEN not in expected\n88:         assert \"sk-abcdefghijkl\" not in expected\n89:     path = tmp_path / \"normalized.jsonl\"\n90:     writer = NormalizedEventWriter(path, max_bytes=1 << 20, min_free_bytes=0)\n91:     try:\n92:         for observation in observations:\n93:             writer.write(observation)\n94:         writer.flush()\n95:     finally:\n96:         writer.close()\n97:     saved = path.read_bytes()\n98:     assert TOKEN.encode() not in saved\n99:     assert b\"sk-abcdefghijkl\" not in saved\n100:     assert b\"\\\\u001b\" not in saved\n101:     assert b\"\\\\u0000\" not in saved\n102:     records = [json.loads(line) for line in saved.splitlines()]\n103:     assert len(records) == len(observations)\n104:     assert all(record[\"payload\"][\"detail\"] == expected for record in records)\n105: \n106: \n107: @pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\n108: def test_bounded_detail_redacts_reconstructed_tokens_before_capping(\n109:     detail: str, expected: str\n110: ) -> None:\n145:     actual = bounded_detail(detail)\n146:     assert actual == expected\n147:     assert len(actual) <= 4096\n148: \n149: \n150: @pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n151: @pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\n152: def test_native_failure_redacts_diagnostic_payload_and_saved_jsonl(\n153:     driver: CodexDriver,\n154:     tmp_path: Path,\n155:     kind: str,\n156:     detail: str,\n157:     expected: str,\n158: ) -> None:\n159:     observations = decode_failure(driver, kind, detail)\n160:     assert [value.type for value in observations] == [\n161:         \"activity.message\" if kind == \"error\" else \"session.failed\"\n162:     ]\n163:     assert observations[0].payload[\"failure_class\"] == \"unknown\"\n164:     if kind == \"error\":\n165:         assert observations[0].payload[\"kind\"] == \"error\"\n166:         assert observations[0].payload[\"reset_at\"] is None\n167:     assert_safe_details(tmp_path, observations, expected)\n168: \n169: \n170: @pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n171: @pytest.mark.parametrize(\"detail\", [\"OK\", \"Warning!\", \"First\\nSecond\", \"First\\tSecond\"])\n172: def test_native_failure_preserves_short_and_formatted_saved_details(\n173:     driver: CodexDriver, tmp_path: Path, kind: str, detail: str\n174: ) -> None:\n175:     observations = decode_failure(driver, kind, detail)\n176:     assert [value.type for value in observations] == [\n177:         \"activity.message\" if kind == \"error\" else \"session.failed\"\n178:     ]\n179:     assert observations[0].payload[\"failure_class\"] == \"unknown\"\n180:     assert_safe_details(tmp_path, observations, detail)\n181: \n182: \n183: @pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n184: @pytest.mark.parametrize(\"seconds\", [30, 21600, -1, 21601])\n185: def test_native_rate_limit_uses_full_text_for_reset_and_saves_bounded_redaction(\n186:     driver: CodexDriver, tmp_path: Path, kind: str, seconds: int\n187: ) -> None:\n188:     detail = CAP_REPRODUCER + f\" HTTP 429; retry after {seconds} seconds\"\n189:     observations = decode_failure(driver, kind, detail)\n190:     if kind == \"error\":\n191:         assert [value.type for value in observations] == [\"activity.message\"]\n192:         failure = rate = observations[0]\n193:         assert failure.payload[\"kind\"] == \"error\"\n194:     else:\n195:         assert sorted(value.type for value in observations) == [\n196:             \"rate_limit.started\",\n197:             \"session.failed\",\n198:         ]\n199:         failure = next(\n200:             value for value in observations if value.type == \"session.failed\"\n201:         )\n202:         rate = next(\n203:             value for value in observations if value.type == \"rate_limit.started\"\n204:         )\n205:         assert rate.payload[\"window\"] is None\n206:     assert failure.payload[\"failure_class\"] == \"rate_limit\"\n207:     reset_at = rate.payload[\"reset_at\"]\n208:     if 0 <= seconds <= 21600:\n209:         assert isinstance(reset_at, str)\n210:         actual = datetime.fromisoformat(reset_at)\n211:         assert actual.utcoffset() == timedelta(0)\n212:         expected_reset = rate.timestamp + timedelta(seconds=seconds)\n213:         assert abs((actual - expected_reset).total_seconds()) < 1\n214:     else:\n215:         assert reset_at is None\n216:     expected_detail = (\n217:         \"x\" * 4080 + \" [REDACTED]\" + f\" HTTP 429; retry after {seconds} seconds\"\n218:     )[:4096]\n219:     assert_safe_details(tmp_path, observations, expected_detail)\n220: \n221: \n222: @pytest.mark.parametrize(\"kind\", [\"error\", \"turn.failed\"])\n223: @pytest.mark.parametrize(\n224:     (\"native_suffix\", \"expected_class\"),\n225:     [\n226:         (\n227:             \"Unauthorized: HTTP 401; HTTP 429; retry after 30 seconds\",\n228:             \"authentication\",\n229:         ),\n230:         (\"Sandbox denied: HTTP 403\", \"permission\"),\n231:         (\"Connection reset: HTTP 503\", \"connectivity\"),\n232:         (\"Request timed out\", \"timeout\"),\n233:         (\"Unau\\x1b[0mthorized\", \"unknown\"),\n234:     ],\n235: )\n236: def test_native_failure_preserves_full_original_classification_before_cleaning(\n237:     driver: CodexDriver, kind: str, native_suffix: str, expected_class: str\n238: ) -> None:\n239:     detail = \"x\" * 4096 + \" \" + native_suffix\n240:     observations = decode_failure(driver, kind, detail)\n241:     failure = next(\n242:         value\n243:         for value in observations\n244:         if value.type == (\"activity.message\" if kind == \"error\" else \"session.failed\")\n245:     )\n246:     assert failure.payload[\"failure_class\"] == expected_class\n247:     assert failure.payload[\"detail\"] == \"x\" * 4096\n248: \n249: \n250: @pytest.mark.parametrize((\"detail\", \"expected\"), SPLIT_DETAILS)\n251: def test_receiver_lane_redacts_message_payload_and_saved_jsonl(\n252:     driver: CodexDriver, tmp_path: Path, detail: str, expected: str\n253: ) -> None:\n254:     driver.decode(json.dumps({\"type\": \"thread.started\", \"thread_id\": \"parent\"}))\n255:     observations = driver.decode(\n256:         json.dumps(\n257:             {\n258:                 \"type\": \"item.started\",\n259:                 \"item\": {\n260:                     \"id\": \"collab-1\",\n261:                     \"type\": \"collab_tool_call\",\n262:                     \"tool\": \"spawn_agent\",\n263:                     \"sender_thread_id\": \"parent\",\n264:                     \"receiver_thread_ids\": [\"child-1\"],\n265:                     \"prompt\": \"Inspect receiver\",\n266:                     \"agents_states\": {\n267:                         \"child-1\": {\"status\": \"running\", \"message\": detail}\n268:                     },\n269:                     \"status\": \"in_progress\",\n270:                 },\n271:             }\n272:         )\n273:     )\n274:     lanes = tuple(value for value in observations if value.lane_id == \"child-1\")\n275:     assert len(lanes) == 1\n276:     assert lanes[0].type == \"lane.started\"\n277:     lane_detail = lanes[0].payload[\"detail\"]\n278:     assert isinstance(lane_detail, str)\n279:     assert \"\\x1b\" not in lane_detail\n280:     assert \"\\x00\" not in lane_detail\n281:     if detail != CAP_REPRODUCER:\n282:         assert expected in lane_detail\n283:     assert_safe_details(tmp_path, lanes, lane_detail)\nFILE tests/events/test_unicode_frames.py\n1: \"\"\"Raw-first rejection of native frames containing invalid Unicode scalars.\"\"\"\n2: \n3: import copy\n4: import errno\n5: import hashlib\n6: import json\n7: import os\n8: from collections.abc import Iterator\n9: from pathlib import Path\n10: from typing import Any\n11: \n12: import pytest\n13: \n14: from ovcaq.config import AgentSettings\n15: from ovcaq.drivers.codex import CodexDriver\n16: from ovcaq.events import (\n17:     Observation,\n18:     ObservationType,\n19:     observation_from_record,\n20:     summary_record,\n21: )\n22: from ovcaq.events.tail import NormalizedEventWriter, RawFirstDecoder\n23: from ovcaq.runtime.session import SessionEvidenceWriter\n24: \n25: \n26: def native_unicode_driver() -> CodexDriver:\n27:     return CodexDriver(\n28:         AgentSettings(\n29:             name=\"codex\",\n30:             command=(\"fixture-wrapper\",),\n31:             tiers={\"standard\": \"fixture-model\"},\n32:             environment={},\n33:             options={},\n34:         ),\n35:         run_id=\"unicode-run\",\n36:     )\n37: \n38: \n39: def native_unicode_record(kind: str) -> dict[str, Any]:\n40:     return {\n41:         \"startup\": {\"type\": \"thread.started\", \"thread_id\": \"poisoned-parent\"},\n42:         \"completion\": {\n43:             \"type\": \"turn.completed\",\n44:             \"usage\": {\n45:                 \"input_tokens\": 99,\n46:                 \"cached_input_tokens\": 9,\n47:                 \"output_tokens\": 88,\n48:             },\n49:         },\n50:         \"collaboration\": {\n51:             \"type\": \"item.started\",\n52:             \"item\": {\n53:                 \"id\": \"collab-1\",\n54:                 \"type\": \"collab_tool_call\",\n55:                 \"tool\": \"spawn_agent\",\n56:                 \"sender_thread_id\": \"healthy-parent\",\n57:                 \"receiver_thread_ids\": [\"child-1\"],\n58:                 \"prompt\": \"Inspect receiver\",\n59:                 \"agents_states\": {\n60:                     \"child-1\": {\"status\": \"running\", \"message\": \"Receiver evidence\"}\n61:                 },\n62:                 \"status\": \"in_progress\",\n63:             },\n64:         },\n65:     }[kind]\n66: \n67: \n68: def unicode_adapter_state(driver: CodexDriver) -> tuple[Any, ...]:\n69:     return copy.deepcopy(\n70:         tuple(\n71:             getattr(driver, field)\n72:             for field in (\"_session_id\", \"_usage\", \"_thread_conflict\", \"_identities\")\n73:         )\n74:     )\n75: \n76: \n77: def unicode_normalized(path: Path) -> tuple[Observation, ...]:\n78:     return tuple(\n79:         observation_from_record(json.loads(line))\n80:         for line in path.read_bytes().splitlines()\n81:     )\n82: \n83: \n84: @pytest.fixture\n85: def unicode_tail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[Any]:\n86:     raw_path = tmp_path / \"raw.jsonl\"\n87:     normalized_path = tmp_path / \"normalized.jsonl\"\n88:     raw = SessionEvidenceWriter(raw_path, max_bytes=1 << 20, min_free_bytes=0)\n89:     normalized = NormalizedEventWriter(\n90:         normalized_path, max_bytes=1 << 20, min_free_bytes=0\n91:     )\n92:     raw_information = raw_path.stat()\n93:     durable: list[bytes] = []\n94:     real_fsync = os.fsync\n95: \n96:     def sync(descriptor: int) -> None:\n97:         real_fsync(descriptor)\n98:         if os.path.samestat(raw_information, os.fstat(descriptor)):\n99:             durable.append(raw_path.read_bytes())\n100: \n101:     monkeypatch.setattr(os, \"fsync\", sync)\n102:     driver = native_unicode_driver()\n103:     decoder = RawFirstDecoder(\n104:         raw=raw,\n105:         normalized=normalized,\n106:         driver=driver,\n107:         run_id=\"unicode-run\",\n108:         session_id=\"owned-session\",\n109:     )\n110:     try:\n111:         yield driver, decoder, raw_path, normalized_path, durable\n112:     finally:\n113:         normalized.close()\n114:         raw.close()\n115: \n116: \n117: def assert_unicode_gap(observations: tuple[Observation, ...], frame: bytes) -> None:\n118:     assert len(observations) == 1\n119:     gap = observations[0]\n120:     assert gap.type is ObservationType.RAW_UNKNOWN\n121:     assert gap.run_id == \"unicode-run\"\n122:     assert gap.session_id == \"owned-session\"\n123:     assert set(gap.payload) == {\"reason\", \"raw_sha256\", \"preview\"}\n124:     assert gap.payload[\"reason\"] == \"frame contains invalid Unicode scalar value\"\n125:     assert gap.payload[\"raw_sha256\"] == hashlib.sha256(frame).hexdigest()\n275:     expected = native_unicode_driver().decode(frame.decode())\n276:     before = unicode_adapter_state(driver)\n277:     observations = decoder.feed(frame + b\"\\n\") + decoder.finish()\n278:     assert [(value.type, dict(value.payload)) for value in observations] == [\n279:         (value.type, dict(value.payload)) for value in expected\n280:     ]\n281:     assert all(value.session_id == \"owned-session\" for value in observations)\n282:     assert all(\n283:         value.payload[\"reason\"] != \"frame contains invalid Unicode scalar value\"\n284:         for value in observations\n285:     )\n286:     assert unicode_adapter_state(driver) == before\n287:     assert raw_path.read_bytes() == durable[-1] == frame + b\"\\n\"\n288:     assert unicode_normalized(normalized_path) == observations\n289: \n290: \n291: @pytest.mark.parametrize(\"stage\", [\"raw\", \"normalized\"])\n292: @pytest.mark.parametrize(\"error_number\", [errno.ENOSPC, errno.EIO])\n293: def test_real_writer_failures_propagate_from_unsafe_native_frames(\n294:     unicode_tail: Any,\n295:     monkeypatch: pytest.MonkeyPatch,\n296:     stage: str,\n297:     error_number: int,\n298: ) -> None:\n299:     driver, decoder, raw_path, normalized_path, durable = unicode_tail\n300:     target = raw_path if stage == \"raw\" else normalized_path\n301:     information = target.stat()\n302:     failure = OSError(error_number, \"injected evidence write failure\")\n303:     real_write = os.write\n304: \n305:     def failing_write(descriptor: int, payload: bytes) -> int:\n306:         if os.path.samestat(information, os.fstat(descriptor)):\n307:             raise failure\n308:         return real_write(descriptor, payload)\n309: \n310:     before = unicode_adapter_state(driver)\n311:     frame = poisoned_unicode_frame(\"startup\", \"ignored-value\", \"\\ud800\")\n312:     with monkeypatch.context() as patch:\n313:         patch.setattr(os, \"write\", failing_write)\n314:         with pytest.raises(OSError) as caught:\n315:             decoder.feed(frame + b\"\\n\")\n316:     assert caught.value is failure\n317:     assert unicode_adapter_state(driver) == before\n318:     assert normalized_path.read_bytes() == b\"\"\n319:     assert raw_path.read_bytes() == (b\"\" if stage == \"raw\" else frame + b\"\\n\")\n320:     if stage == \"normalized\":\nFILE pyproject.toml\n1: [build-system]\n2: requires = [\"hatchling\"]\n3: build-backend = \"hatchling.build\"\n4: \n5: [project]\n6: name = \"ovcaq\"\n7: version = \"0.1.0.dev0\"\n8: description = \"Orchestration, Visibility, and Control for Agent Queues\"\n9: readme = \"README.md\"\n10: license = \"MIT\"\n11: license-files = [\"LICENSE\"]\n12: requires-python = \">=3.12\"\n13: dependencies = [\n14:     \"rich\",\n15:     \"textual\",\n16: ]\n17: \n18: [project.scripts]\n19: ovcaq = \"ovcaq.cli:main\"\n20: \n21: [dependency-groups]\n22: dev = [\n23:     \"hatchling\",\n24:     \"mypy\",\n25:     \"packaging\",\n26:     \"pytest\",\n27:     \"ruff\",\n28: ]\n29: \n30: [tool.hatch.build.targets.sdist]\n31: include = [\n32:     \"/CHANGELOG.md\",\n33:     \"/LICENSE\",\n34:     \"/README.md\",\n35:     \"/docs\",\n36:     \"/pyproject.toml\",\n37:     \"/src/ovcaq\",\n38:     \"/tests\",\n39:     \"/uv.lock\",\n40: ]\n41: exclude = [\n42:     \"/.cache\",\n43:     \"/.git\",\n44:     \"/.github\",\n45:     \"/.hg\",\n46:     \"/.mypy_cache\",\n47:     \"/.pytest_cache\",\n48:     \"/.ruff_cache\",\n49:     \"/.svn\",\n50:     \"/.tox\",\n51:     \"/.venv\",\n52:     \"/build\",\n53:     \"/dist\",\n54:     \"/docs/dev\",\n55:     \"**/__pycache__\",\n56:     \"**/*.py[co]\",\n57: ]\n58: \n59: [tool.hatch.build.targets.wheel]\n60: packages = [\"src/ovcaq\"]\n61: \n62: [tool.pytest.ini_options]\n63: addopts = [\"--import-mode=importlib\"]\n64: pythonpath = [\"tests/packaging\", \"tests/state\", \"tests/workflow\"]\n65: \n66: [tool.ruff]\n67: target-version = \"py312\"\n68: src = [\"src\"]\n69: extend-exclude = [\"docs/dev/project-management\"]\n70: \n71: [tool.mypy]\n72: python_version = \"3.12\"\n73: strict = true\n74: files = [\"src/ovcaq\"]\nFILE /Users/bob/.agents/skills/python-patterns/SKILL.md\n1: ---\n2: name: python-patterns\n3: description: Use when writing, reviewing, or refactoring Python code. Covers idioms, naming, traps, toolchain, and security. Triggers on Python file edits, \"pythonic\", \"PEP 8\", \"python best practices\", \"python idioms\", \"bandit\".\n4: compatibility: \"Portable standalone compatibility copy of the strunk plugin skill for agents without that plugin; Claude Code uses the namespaced plugin skill.\"\n5: ---\n6: \n7: # Python Patterns\n8: \n9: Pick a side. These are the rulings, not a tutorial.\n10: \n11: ## Idioms that earn their place\n12: \n13: | Rule | Why |\n14: |------|-----|\n15: | `X \\| Y`, not `Union[X, Y]` | 3.10+ runtime syntax; clearer. On 3.9 it parses only under `from __future__ import annotations` and still breaks `get_type_hints`/`isinstance` — keep `Optional`/`Union` if you support 3.9. |\n16: | `Protocol`, not `ABC`, for duck typing | Structural typing; no inheritance you don't control. |\n17: | `@dataclass(frozen=True)` for immutable records, plain `dataclass` only when you must mutate, `NamedTuple` for lightweight immutable rows | Pydantic only when you need validation. |\n18: | `raise New(...) from e` | Marks the explicit cause. A bare `raise New()` still chains implicitly (\"During handling...\"); use `from None` to suppress. |\n19: | `@functools.wraps` on every decorator | Without it the wrapper loses `__name__`, `__doc__`, signature. |\n20: | `pathlib.Path`, not `os.path` | One object, no string surgery. |\n21: \n22: ## Naming (PEP 8)\n23: \n24: `snake_case` for modules, functions, variables. `CapWords` for classes. `UPPER_SNAKE_CASE` for constants. Leading `_` for internal names.\n25: \n26: **Never name a `.py` file in kebab-case.** `my-script.py` is not importable (`import my-script` is a `SyntaxError`). Kebab-case belongs only in the `pyproject.toml` distribution name and the CLI command, both of which map to a `snake_case` module.\n27: \n28: ## Traps\n29: \n30: ```python\n31: # Mutable default argument — shared across calls\n32: def bad(items=[]): ...\n33: def good(items=None):\n34:     items = [] if items is None else items\n35: \n36: # Bare except — swallows SystemExit, KeyboardInterrupt\n37: try: ...\n38: except Exception as e: ...        # name the exception\n39: \n40: # __slots__ kills __dict__ and dynamic attributes — use only on fixed,\n41: # memory-sensitive classes you won't extend.\n42: \n43: # __double_leading is name-mangled to _Class__double_leading.\n44: # Surprises you in subclasses, pickling, and monkey-patching.\n45: \n46: if value is None: ...             # never == None\n47: ```\n48: \n49: Avoid `from module import *`. Use `isinstance`, never `type(x) ==`.\n50: \n51: ## Toolchain\n52: \n53: **black** to format, **isort** for imports, **ruff** to lint. Type annotations on every function signature — no exceptions for \"obvious\" returns.\n54: \n55: ## Resources and laziness\n56: \n57: Context managers (`with`) for anything holding a resource. Generators for lazy iteration over anything you would otherwise materialize into a list.\n58: \n59: ## Security\n60: \n61: - Read secrets with `os.environ[\"API_KEY\"]`, never `.get()` — a missing secret must raise `KeyError` at startup, not surface as `None` at request time.\n62: - `python-dotenv` loads a local `.env` in development only. Never commit one.\n63: - `bandit -r src/` for static security analysis.\nFILE /Users/bob/.agents/skills/python-testing/SKILL.md\n1: ---\n2: name: python-testing\n3: description: Use when writing, fixing, or reviewing Python tests with pytest. Covers TDD, fixtures, mocking, parametrization, coverage. Triggers on \"pytest\", \"python test\", \"conftest\", \"pytest.mark\", \"parametrize\", \"pytest fixture\", \"python mock\".\n4: compatibility: \"Portable standalone compatibility copy of the strunk plugin skill for agents without that plugin; Claude Code uses the namespaced plugin skill.\"\n5: ---\n6: \n7: # Python Testing\n8: \n9: TDD: write the failing test (RED), make it pass (GREEN), refactor. One behavior per test. No logic in tests. Coverage target 80%, higher on critical paths.\n10: \n11: ## Rulings\n12: \n13: **Mocking**\n14: - Patch where the name is *used*, not where it's defined: `@patch(\"myapp.service.requests\")`, not `@patch(\"requests\")`.\n15: - `autospec=True` so the mock rejects calls the real API would reject.\n16: - Mock at the boundary (I/O, network, clock). Never mock the thing under test.\n17: - Async: assert with `assert_awaited_once()`, not `assert_called_once()`.\n18: \n19: **Fixtures**\n20: - `yield` for teardown; the line after `yield` is the cleanup.\n21: - Default to function scope. Widen to `module`/`session` only for genuinely expensive resources.\n22: - `autouse` hides dependencies — use sparingly; prefer explicit injection.\n23: - `tmp_path` for temp files (auto-cleanup, `Path` API), not `tempfile`.\n24: \n25: **Parametrize**\n26: - `@pytest.mark.parametrize` over loops — distinct test IDs, filterable with `-k`.\n27: - Pass `ids=[...]` when params are objects or tuples; pytest already auto-names plain str/int/bool readably.\n28: \n29: **Config**\n30: - One config in `pyproject.toml` (`[tool.pytest.ini_options]`), not a separate `pytest.ini`.\n31: - `--strict-markers` so a typo'd marker fails instead of silently passing.\n32: - Register custom markers — e.g. `slow`, `@pytest.mark.unit`, `@pytest.mark.integration` — so `--strict-markers` catches a typo.\n33: - Coverage locally: `pytest --cov=src --cov-report=term-missing` — the missing-line report is the point; a bare percentage is not actionable.\n34: \n35: **Async (pytest-asyncio)**\n36: - Default mode is `strict`: an async test with no `@pytest.mark.asyncio` is silently not collected. Set `asyncio_mode = \"auto\"` in `[tool.pytest.ini_options]` to drop the per-test marker.\n37: - Use `@pytest_asyncio.fixture` for async fixtures in strict mode.\n","exit_code":0,"duration":{"secs":0,"nanos":1833}},"started_at_ms":1791625381612,"completed_at_ms":1791625381612}}
