"\n                f\"Path({str(sentinel)!r}).write_text('normal exit')\\n\"\n            )\n        )\n    ]\n    signals_while_child_alive: list[int] = []\n    real_signal_group = OwnedProcess.signal_group\n\n    def signal_group(process: OwnedProcess, signal_number: int) -> bool:\n        if not stopped(int(pid_file.read_text())):\n            signals_while_child_alive.append(signal_number)\n        return real_signal_group(process, signal_number)\n\n    monkeypatch.setattr(OwnedProcess, \"signal_group\", signal_group)\n    result = h.supervisor().run_once()\n\n    assert sentinel.read_text() == \"normal exit\"\n    assert signals_while_child_alive == []\n    assert result.summary.success\n    assert result.summary.failure_class is None\n    assert result.summary.failure_detail is None\n    assert result.state_error is None\n    (request,) = h.driver.requests\n    assert result.summary.session_id == request.session_dir.name\n    usage = summary_record(result.summary)[\"usage\"]\n    assert usage[\"input_tokens\"] == 3\n    assert usage[\"output_tokens\"] == 2\n    assert (\n        request.session_dir / \"raw.jsonl\"\n    ).read_bytes() == unsafe_wire + healthy_wire\n    observations = tuple(\n        observation_from_record(json.loads(line))\n        for line in (request.session_dir / \"normalized.jsonl\").read_bytes().splitlines()\n    )\n    assert [item.type for item in observations[:3]] == [ObservationType.RAW_UNKNOWN] * 3\n    assert {item.type for item in observations[3:]} >= {\n        ObservationType.SESSION_STARTED,\n        ObservationType.USAGE_UPDATED,\n        ObservationType.SESSION_COMPLETED,\n    }\n    assert all(\n        item.type is not ObservationType.RAW_UNKNOWN for item in observations[3:]\n    )\n    assert all(item.session_id == request.session_dir.name for item in observations)\n    summary = json.loads((request.session_dir / \"summary.json\").read_bytes())\n    assert summary[\"returncode\"] == 0\n    assert summary[\"signal\"] is None\n    assert summary[\"timed_out\"] is False\n    assert summary[\"detail\"] is None\n\n\ndef test_normalized_gap_writer_error_propagates_and_cleans_up_live_child(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    h = harness(tmp_path, monkeypatch, \"codex\")\n    sentinel = tmp_path / \"normal-exit\"\n    pid_file = tmp_path / \"child-pid\"\n    unsafe_wire = (\n        json.dumps(\n            {\n                \"type\": \"thread.started\",\n                \"thread_id\": \"poisoned-parent\",\n                \"vendor\": \"\\ud800\",\n            }\n        ).encode()\n        + b\"\\n\"\n    )\n    h.driver.steps = [\n        Step(\n            code=(\n                \"import os, sys, time\\nfrom pathlib import Path\\n\"\n                f\"Path({str(pid_file)!r}).write_text(str(os.getpid()))\\n\"\n                f\"sys.stdout.buffer.write({unsafe_wire!r})\\n\"\n                \"sys.stdout.buffer.flush()\\ntime.sleep(1)\\n\"\n                f\"Path({str(sentinel)!r}).write_text('normal exit')\\n\"\n            )\n        )\n    ]\n    failure = OSError(errno.EIO, \"injected normalized writer failure\")\n    live_at_failure: list[int] = []\n    real_write = NormalizedEventWriter.write\n\n    def fail_gap_write(writer: NormalizedEventWriter, observation: Observation) -> int:\n        if observation.type is ObservationType.RAW_UNKNOWN:\n            pid = int(pid_file.read_text())\n            os.kill(pid, 0)\n            assert not sentinel.exists()\n            live_at_failure.append(pid)\n            raise failure\n        return real_write(writer, observation)\n\n    monkeypatch.setattr(NormalizedEventWriter, \"write\", fail_gap_write)\n    try:\n        with pytest.raises(\n            OSError, match=\"injected normalized writer failure\"\n        ) as caught:\n            h.supervisor().run_once()\n        assert caught.value is failure\n        assert live_at_failure == [int(pid_file.read_text())]\n        assert stopped(live_at_failure[0])\n        assert not sentinel.exists()\n        (request,) = h.driver.requests\n        assert (request.session_dir / \"raw.jsonl\").read_bytes() == unsafe_wire\n        assert (request.session_dir / \"normalized.jsonl\").read_bytes() == b\"\"\n        summary = json.loads((request.session_dir / \"summary.json\").read_bytes())\n        assert summary[\"detail\"] == str(failure)\n        assert summary[\"timed_out\"] is False\n    finally:\n        if pid_file.exists() and not stopped(int(pid_file.read_text())):\n            os.kill(int(pid_file.read_text()), signal.SIGKILL)\n\n/Users/bob/.agents/skills/python-patterns/SKILL.md\n---\nname: python-patterns\ndescription: Use when writing, reviewing, or refactoring Python code. Covers idioms, naming, traps, toolchain, and security. Triggers on Python file edits, \"pythonic\", \"PEP 8\", \"python best practices\", \"python idioms\", \"bandit\".\ncompatibility: \"Portable standalone compatibility copy of the strunk plugin skill for agents without that plugin; Claude Code uses the namespaced plugin skill.\"\n---\n\n# Python Patterns\n\nPick a side. These are the rulings, not a tutorial.\n\n## Idioms that earn their place\n\n| Rule | Why |\n|------|-----|\n| `X \\| Y`, not `Union[X, Y]` | 3.10+ runtime syntax; clearer. On 3.9 it parses only under `from __future__ import annotations` and still breaks `get_type_hints`/`isinstance` — keep `Optional`/`Union` if you support 3.9. |\n| `Protocol`, not `ABC`, for duck typing | Structural typing; no inheritance you don't control. |\n| `@dataclass(frozen=True)` for immutable records, plain `dataclass` only when you must mutate, `NamedTuple` for lightweight immutable rows | Pydantic only when you need validation. |\n| `raise New(...) from e` | Marks the explicit cause. A bare `raise New()` still chains implicitly (\"During handling...\"); use `from None` to suppress. |\n| `@functools.wraps` on every decorator | Without it the wrapper loses `__name__`, `__doc__`, signature. |\n| `pathlib.Path`, not `os.path` | One object, no string surgery. |\n\n## Naming (PEP 8)\n\n`snake_case` for modules, functions, variables. `CapWords` for classes. `UPPER_SNAKE_CASE` for constants. Leading `_` for internal names.\n\n**Never name a `.py` file in kebab-case.** `my-script.py` is not importable (`import my-script` is a `SyntaxError`). Kebab-case belongs only in the `pyproject.toml` distribution name and the CLI command, both of which map to a `snake_case` module.\n\n## Traps\n\n```python\n# Mutable default argument — shared across calls\ndef bad(items=[]): ...\ndef good(items=None):\n    items = [] if items is None else items\n\n# Bare except — swallows SystemExit, KeyboardInterrupt\ntry: ...\nexcept Exception as e: ...        # name the exception\n\n# __slots__ kills __dict__ and dynamic attributes — use only on fixed,\n# memory-sensitive classes you won't extend.\n\n# __double_leading is name-mangled to _Class__double_leading.\n# Surprises you in subclasses, pickling, and monkey-patching.\n\nif value is None: ...             # never == None\n```\n\nAvoid `from module import *`. Use `isinstance`, never `type(x) ==`.\n\n## Toolchain\n\n**black** to format, **isort** for imports, **ruff** to lint. Type annotations on every function signature — no exceptions for \"obvious\" returns.\n\n## Resources and laziness\n\nContext managers (`with`) for anything holding a resource. Generators for lazy iteration over anything you would otherwise materialize into a list.\n\n## Security\n\n- Read secrets with `os.environ[\"API_KEY\"]`, never `.get()` — a missing secret must raise `KeyError` at startup, not surface as `None` at request time.\n- `python-dotenv` loads a local `.env` in development only. Never commit one.\n- `bandit -r src/` for static security analysis.\n\n/Users/bob/.agents/skills/python-testing/SKILL.md\n---\nname: python-testing\ndescription: Use when writing, fixing, or reviewing Python tests with pytest. Covers TDD, fixtures, mocking, parametrization, c