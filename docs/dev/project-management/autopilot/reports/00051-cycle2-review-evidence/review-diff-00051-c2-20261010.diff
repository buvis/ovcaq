+{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c \\\"from pathlib import Path; p=Path('tests/events/test_unicode_safety.py'); print(p.read_text() if p.exists() else 'Tests pending')\\\" \"","aggregated_output":"\"\"\"Unicode scalar contracts for shared observations, independent of drivers.\"\"\"\n\nimport json\nfrom datetime import UTC, datetime\n\nimport pytest\n\nfrom ovcaq.events import (\n    FailureClass,\n    Observation,\n    ObservationType,\n    SessionSummary,\n    observation_from_record,\n    observation_record,\n    sanitize_json,\n    summary_record,\n)\n\nNOW = datetime(2026, 9, 26, 12, 30, 15, 123456, tzinfo=UTC)\nINVALID_SCALARS = (\"\\ud800\", \"\\udfff\")\n\n\ndef make_observation(**changes):\n    fields = {\n        \"protocol_version\": 1,\n        \"timestamp\": NOW,\n        \"provider\": \"test-driver\",\n        \"run_id\": \"run-1\",\n        \"session_id\": \"session-1\",\n        \"lane_id\": \"lane-1\",\n        \"type\": ObservationType.ACTIVITY_MESSAGE,\n        \"payload\": {\"message\": \"working\"},\n    }\n    fields.update(changes)\n    return Observation(**fields)\n\n\ndef make_summary(**changes):\n    fields = {\n        \"success\": False,\n        \"session_id\": \"session-1\",\n        \"failure_class\": FailureClass.AGENT,\n        \"failure_detail\": \"request failed\",\n        \"rate_limit_reset_at\": None,\n        \"usage\": None,\n    }\n    fields.update(changes)\n    return SessionSummary(**fields)\n\n\ndef assert_scalar_json(value):\n    if isinstance(value, dict):\n        for key, child in value.items():\n            key.encode(\"utf-8\", errors=\"strict\")\n            assert_scalar_json(child)\n    elif isinstance(value, list):\n        for child in value:\n            assert_scalar_json(child)\n    elif isinstance(value, str):\n        value.encode(\"utf-8\", errors=\"strict\")\n\n\ndef replace_record_string(value, original, replacement):\n    if isinstance(value, dict):\n        return {\n            replacement if key == original else key: replace_record_string(\n                child, original, replacement\n            )\n            for key, child in value.items()\n        }\n    if isinstance(value, list):\n        return [replace_record_string(child, original, replacement) for child in value]\n    return replacement if value == original else value\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\"field\", [\"provider\", \"run_id\", \"session_id\", \"lane_id\"])\ndef test_observation_rejects_invalid_scalar_identifiers(field, scalar):\n    with pytest.raises(Exception):\n        make_observation(**{field: f\"prefix{scalar}suffix\"})\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\"location\", [\"value\", \"nested_value\", \"nested_key\", \"secret\"])\ndef test_observation_rejects_invalid_scalars_recursively_in_payload(location, scalar):\n    payloads = {\n        \"value\": {\"message\": scalar},\n        \"nested_value\": {\"message\": [\"valid\", {\"nested\": scalar}]},\n        \"nested_key\": {\"message\": [\"valid\", {scalar: \"valid\"}]},\n        \"secret\": {\"message\": \"valid\", \"password\": scalar},\n    }\n    with pytest.raises(Exception):\n        make_observation(payload=payloads[location])\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\"field\", [\"session_id\", \"failure_detail\"])\ndef test_summary_rejects_invalid_scalar_strings(field, scalar):\n    with pytest.raises(Exception):\n        make_summary(**{field: f\"prefix{scalar}suffix\"})\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\"location\", [\"root\", \"list\", \"value\", \"nested_key\", \"secret\"])\ndef test_sanitize_json_rejects_invalid_scalars_before_redaction(location, scalar):\n    values = {\n        \"root\": scalar,\n        \"list\": [\"valid\", scalar],\n        \"value\": {\"message\": [\"valid\", {\"nested\": scalar}]},\n        \"nested_key\": {\"message\": [\"valid\", {scalar: \"valid\"}]},\n        \"secret\": {\"password\": scalar},\n    }\n    with pytest.raises(Exception):\n        sanitize_json(values[location])\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=[\"high\", \"low\"])\n@pytest.mark.parametrize(\n    \"original\", [\"test-driver\", \"run-1\", \"session-1\", \"lane-1\", \"marker\", \"nested\"]\n)\ndef test_observation_record_decoder_rejects_invalid_scalars(original, scalar):\n    valid = make_observation(payload={\"message\": [\"marker\", {\"nested\": \"valid\"}]})\n    record = replace_record_string(observation_record(valid), original, scalar)\n    decoded_record = json.loads(json.dumps(record, ensure_ascii=True))\n\n    with pytest.raises(Exception):\n        observation_from_record(decoded_record)\n\n\n@pytest.mark.parametrize(\n    \"text\", [\"\", \"Žluťoučký 日本語\", \"\\ud7ff\\ue000\", \"\\U00010000\\U0010ffff\"]\n)\ndef test_shared_models_and_serializers_preserve_valid_unicode_scalars(text):\n    payload = {\"message\": [text, {text: text}, None]}\n    observation = make_observation(payload=payload)\n    summary = make_summary(session_id=text or None, failure_detail=text)\n\n    assert sanitize_json(payload) == payload\n    assert sanitize_json(None) is None\n    assert sanitize_json(text) == text\n    assert observation.payload == payload\n    record = observation_record(observation)\n    restored = observation_from_record(json.loads(json.dumps(record, ensure_ascii=False)))\n    assert restored.payload == payload\n    assert restored.session_id == observation.session_id\n    assert summary.failure_detail == text\n    assert_scalar_json(record)\n    assert_scalar_json(summary_record(summary))\n\n\ndef test_valid_escaped_surrogate_pair_decodes_to_supported_scalar():\n    scalar = json.loads(r'\"\\ud83d\\ude80\"')\n    assert scalar == \"\\U0001f680\"\n    observation = make_observation(\n        provider=scalar,\n        run_id=scalar,\n        session_id=scalar,\n        lane_id=scalar,\n        payload={\"message\": [scalar, {scalar: scalar}]},\n    )\n    summary = make_summary(session_id=scalar, failure_detail=scalar)\n\n    assert sanitize_json({scalar: scalar}) == {scalar: scalar}\n    record = observation_record(observation)\n    restored = observation_from_record(json.loads(json.dumps(record, ensure_ascii=True)))\n    assert restored == observation\n    assert restored.provider == scalar\n    assert restored.payload == {\"message\": [scalar, {scalar: scalar}]}\n    assert summary.session_id == scalar\n    assert summary.failure_detail == scalar\n    assert_scalar_json(record)\n    assert_scalar_json(summary_record(summary))\n\n","exit_code":0,"status":"completed"}}
