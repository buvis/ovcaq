ED = \"lane.started\"\n    LANE_PROGRESS = \"lane.progress\"\n    LANE_COMPLETED = \"lane.completed\"\n    LANE_FAILED = \"lane.failed\"\n    USAGE_UPDATED = \"usage.updated\"\n    RATE_LIMIT_STARTED = \"rate_limit.started\"\n    RATE_LIMIT_CLEARED = \"rate_limit.cleared\"\n    SESSION_COMPLETED = \"session.completed\"\n    SESSION_FAILED = \"session.failed\"\n    RAW_UNKNOWN = \"raw.unknown\"\n\n\nclass FailureClass(StrEnum):\n    RATE_LIMIT = \"rate_limit\"\n    CONNECTIVITY = \"connectivity\"\n    PERMISSION = \"permission\"\n    AUTHENTICATION = \"authentication\"\n    TIMEOUT = \"timeout\"\n    AGENT = \"agent\"\n    UNKNOWN = \"unknown\"\n\n\ndef sanitize_text(text: str) -> str:\n    \"\"\"Redact credential assignments while retaining ordinary prose.\"\"\"\n    sanitized = _CREDENTIAL.sub(lambda match: match[\"prefix\"] + \"[REDACTED]\", text)\n    return _LIKELY_SECRET.sub(\n        lambda match: (match[\"bearer\"] or \"\") + \"[REDACTED]\", sanitized\n    )\n\n\ndef has_invalid_unicode_scalar(value: object) -> bool:\n    \"\"\"Inspect JSON-like text without changing or redacting its contents.\"\"\"\n    pending: list[object] = [value]\n    while pending:\n        current = pending.pop()\n        if isinstance(current, str):\n            if any(0xD800 <= ord(character) <= 0xDFFF for character in current):\n                return True\n        elif isinstance(current, Mapping):\n            for key, child in current.items():\n                pending.extend((key, child))\n        elif isinstance(current, (list, tuple)):\n            pending.extend(current)\n    return False\n\n\ndef sanitize_json(value: object) -> JSONValue:\n    \"\"\"Copy scalar-safe JSON values, redacting sensitive data.\"\"\"\n    if has_invalid_unicode_scalar(value):\n        raise ValueError(\"Strings must contain only Unicode scalar values\")\n    return _sanitize_json(value)\n\n\ndef _sanitize_json(value: object) -> JSONValue:\n    if isinstance(value, str):\n        return sanitize_text(str(value))\n    if value is None or isinstance(value, bool):\n        return value\n    if isinstance(value, int):\n        return int(value)\n    if isinstance(value, float):\n        if not math.isfinite(value):\n            raise ValueError(\"JSON numbers must be finite\")\n        return float(value)\n    if isinstance(value, Mapping):\n        result: dict[str, JSONValue] = {}\n        for key, child in value.items():\n            if not isinstance(key, str):\n                raise TypeError(\"JSON object keys must be strings\")\n            result[str(key)] = (\n                \"[REDACTED]\" if _SENSITIVE_KEY.search(key) else _sanitize_json(child)\n            )\n        return result\n    if isinstance(value, (list, tuple)):\n        return [_sanitize_json(child) for child in value]\n    raise TypeError(\"Expected a JSON value\")\n\n\ndef _freeze(value: JSONValue) -> JSONValue:\n    if isinstance(value, Mapping):\n        return MappingProxyType({key: _freeze(child) for key, child in value.items()})\n    if isinstance(value, (list, tuple)):\n        return tuple(_freeze(child) for child in value)\n    return value\n\n\ndef _identifier(value: object, *, optional: bool = False) -> None:\n    if value is None and optional:\n        return\n    if not isinstance(value, str) or not value:\n        raise ValueError(\"Identifiers must be nonempty strings\")\n    if has_invalid_unicode_scalar(value):\n        raise ValueError(\"Strings must contain only Unicode scalar values\")\n\n\ndef _utc(value: datetime) -> datetime:\n    if not isinstance(value, datetime) or value.utcoffset() != timedelta(0):\n        raise ValueError(\"Expected an aware UTC datetime\")\n    return value\n\n\ndef _parse_utc(value: object) -> datetime:\n    if not isinstance(value, str) or not _UTC_TEXT.fullmatch(value):\n        raise ValueError(\"Expected an RFC 3339 UTC timestamp\")\n    return _utc(datetime.fromisoformat(value))\n\n\ndef _timestamp(value: datetime) -> str:\n    return _utc(value).astimezone(UTC).isoformat().replace(\"+00:00\", \"Z\")\n\n\n@dataclass(frozen=True, slots=True)\nclass Usage:\n    input_tokens: int | None = None\n    output_tokens: int | None = None\n    cache_creation_input_tokens: int | None = None\n    cache_read_input_tokens: int | None = None\n    tool_uses: int | None = None\n    cost_usd: float | None = None\n    estimated: bool = False\n\n    def __post_init__(self) -> None:\n        for name in (\n            \"input_tokens\",\n            \"output_tokens\",\n            \"cache_creation_input_tokens\",\n            \"cache_read_input_tokens\",\n            \"tool_uses\",\n        ):\n            value = getattr(self, name)\n            if value is not None and (type(value) is not int or value < 0):\n                raise ValueError(\"Usage counters must be nonnegative integers or null\")\n        if self.cost_usd is not None and (\n            type(self.cost_usd) is not float\n            or not math.isfinite(self.cost_usd)\n            or self.cost_usd < 0\n        ):\n            raise ValueError(\"Cost must be a finite nonnegative float or null\")\n        if type(self.estimated) is not bool:\n            raise TypeError(\"estimated must be a boolean\")\n\n\ndef _usage_payload(\n    kind: ObservationType, payload: Mapping[str, JSONValue]\n) -> dict[str, JSONValue]:\n    usage = payload[\"usage\"]\n    if not isinstance(usage, Mapping) or set(usage) != {f.name for f in fields(Usage)}:\n        raise ValueError(\"Expected complete serialized Usage\")\n    validated = Usage(**dict(usage))  # type: ignore[arg-type]\n    if kind == ObservationType.SESSION_COMPLETED:\n        sanitized = sanitize_json(\n            {key: value for key, value in payload.items() if key != \"usage\"}\n        )\n        assert isinstance(sanitized, dict)\n        sanitized[\"usage\"] = asdict(validated)\n        return sanitized\n    identity = payload[\"identity\"]\n    if identity is not None and not isinstance(identity, str):\n        raise TypeError(\"Usage identity must be a string or null\")\n    # Token counters are schema fields, not credential-bearing keys.\n    return {\"usage\": asdict(validated), \"identity\": sanitize_json(identity)}\n\n\ndef _check_rate_limit(payload: Mapping[str, JSONValue]) -> None:\n    if payload[\"reset_at\"] is not None:\n        _parse_utc(payload[\"reset_at\"])\n    if payload[\"window\"] is not None and not isinstance(payload[\"window\"], str):\n        raise TypeError(\"Rate-limit window must be text or null\")\n    if not isinstance(payload[\"detail\"], str):\n        raise TypeError(\"Rate-limit detail must be text\")\n\n\ndef _payload(\n    kind: ObservationType, payload: Mapping[str, JSONValue]\n) -> dict[str, JSONValue]:\n    if not isinstance(payload, Mapping):\n        raise TypeError(\"Payload must be a mapping\")\n    if has_invalid_unicode_scalar(payload):\n        raise ValueError(\"Strings must contain only Unicode scalar values\")\n    shapes = {\n        ObservationType.USAGE_UPDATED: {\"usage\", \"identity\"},\n        ObservationType.SESSION_FAILED: {\"failure_class\", \"detail\"},\n        ObservationType.RATE_LIMIT_STARTED: {\"reset_at\", \"window\", \"detail\"},\n        ObservationType.RAW_UNKNOWN: {\"reason\", \"raw_sha256\", \"preview\"},\n    }\n    if kind in shapes and set(payload) != shapes[kind]:\n        raise ValueError(\"Invalid payload keys\")\n    if kind == ObservationType.USAGE_UPDATED or (\n        kind == ObservationType.SESSION_COMPLETED and \"usage\" in payload\n    ):\n        return _usage_payload(kind, payload)\n    if kind == ObservationType.SESSION_FAILED:\n        failure_class = payload[\"failure_class\"]\n        if not isinstance(failure_class, str):\n            raise TypeError(\"Failure class must be text\")\n        FailureClass(failure_class)\n        if not isinstance(payload[\"detail\"], str):\n            raise TypeError(\"Failure detail must be text\")\n    if kind == ObservationType.RATE_LIMIT_STARTED:\n        _check_rate_limit(payload)\n    if kind == ObservationType.RAW_UNKNOWN:\n        if not all(isinstance(payload[key], str) for key in shapes[kind]):\n            raise TypeError(\"Unknown observation fields must be strings\")\n        if not re.fullmatch(r\"[0-9a-f]{64}\", str(payload[\"raw_sha256\"])):\n            raise ValueError(\"Expected lowercase SHA-256 digest\")\n    sanitized = sanitize_json(payload)\n    assert isinstance(sanitized, dict)\n    if kind in (\n        ObservationType.LANE_STARTED,\n        ObservationType.LANE_PROGRESS,\n        ObservationType.LANE_COMPLETED,\n        ObservationType.LANE_FAILED,\n    ):\n        # This schema counter is not a credential-bearing key.\n        total_tokens = payload.get(\"total_tokens\")\n        if type(total_tokens) is int and total_tokens >= 0:\n            sanitized[\"total_tokens\"] = total_tokens\n    if kind == ObservationType.RAW_UNKNOWN:\n        sanitized[\"preview\"] = str(sanitized[\"preview\"])[:512]\n    return sanitized\n\n\n@dataclass(frozen=True, slots=True)\nclass Observation:\n    protocol_version: int\n    timestamp: datetime\n    provider: str\n    run_id: str\n    session_id: str | None\n    lane_id: str | None\n    type: ObservationType\n    payload: Mapping[str, JSONValue]\n\n    def __post_init__(self) -> None:\n        if (\n            type(self.protocol_version) is not int\n            or self.protocol_version != PROTOCOL_VERSION\n        ):\n            raise ValueError(\"Unsupported observation protocol version\")\n        _utc(self.timestamp)\n        _identifier(self.provider)\n        _identifier(self.run_id)\n        _identifier(self.session_id, optional=True)\n        _identifier(self.lane_id, optional=True)\n        kind = ObservationType(self.type)\n        object.__setattr__(self, \"type\", kind)\n        object.__setattr__(self, \"payload\", _freeze(_payload(kind, self.payload)))\n\n\n@dataclass(frozen=True, slots=True)\nclass SessionSummary:\n    success: bool\n    session_id: str | None\n    failure_class: FailureClass | None\n    failure_detail: str | None\n    rate_limit_reset_at: datetime | None\n    usage: Usage | None\n\n    def __post_init__(self) -> None:\n        if type(self.success) is not bool:\n            raise TypeError(\"success must be a boolean\")\n        _identifier(self.session_id, optional=True)\n        if self.failure_class is not None:\n            object.__setattr__(self, \"failure_class\", FailureClass(self.failure_class))\n        if self.failure_detail is not None:\n            if not isinstance(self.failure_detail, str):\n                raise TypeError(\"Failure detail must be text or null\")\n            if has_invalid_unicode_scalar(self.failure_detail):\n                raise ValueError(\"Strings must contain only Unicode scalar values\")\n            object.__setattr__(\n                self, \"failure_detail\", sanitize_text(self.failure_detail)[:4096]\n            )\n        if self.rate_limit_reset_at is not None:\n            _utc(self.rate_limit_reset_at)\n        if self.usage is not None and not isinstance(self.usage, Usage):\n            raise TypeError(\"usage must be Usage or null\")\n\n\ndef observation_record(observation: Observation) -> dict[str, JSONValue]:\n    \"\"\"Return a fresh, sanitized JSON record.\"\"\"\n    return {\n        \"protocol_version\": observation.protocol_version,\n        \"timestamp\": _timestamp(observation.timestamp),\n        \"provider\": observation.provider,\n        \"run_id\": observation.run_id,\n        \"session_id\": observation.session_id,\n        \"lane_id\": observation.lane_id,\n        \"type\": observation.type.value,\n        \"payload\": _payload(observation.type, observation.payload),\n    }\n\n\ndef observation_from_record(record: Mapping[str, JSONValue]) -> Observation:\n    \"\"\"Validate and reconstruct a serialized version-one observation.\"\"\"\n    values = dict(record)\n    timestamp = _parse_utc(values.pop(\"timestamp\"))\n    return Observation(timestamp=timestamp, **values)  # type: ignore[arg-type]\n\n\ndef summary_record(summary: SessionSummary) -> dict[str, JSONValue]:\n    \"\"\"Return the complete session summary as ordinary JSON containers.\"\"\"\n    return {\n        \"success\": summary.success,\n        \"session_id\": summary.session_id,\n        \"failure_class\": summary.failure_class.value\n        if summary.failure_class is not None\n        else None,\n        \"failure_detail\": (\n            sanitize_text(summary.failure_detail)[:4096]\n            if summary.failure_detail is not None\n            else None\n        ),\n        \"rate_limit_reset_at\": (\n            _timestamp(summary.rate_limit_reset_at)\n            if summary.rate_limit_reset_at is not None\n            else None\n        ),\n        \"usage\": asdict(summary.usage) if summary.usage is not None else None,\n    }\n\n\"\"\"Persist raw evidence before decoding bounded newline-delimited frames.\"\"\"\n\nimport hashlib\nimport json\nimport os\nimport stat\nfrom collections.abc import Callable, Mapping\nfrom dataclasses import dataclass, replace\nfrom datetime import UTC, datetime\nfrom pathlib import Path\nfrom typing import Literal, cast\n\nfrom ovcaq.drivers.base import AgentDriver\nfrom ovcaq.events import (\n    PROTOCOL_VERSION,\n    Observation,\n    ObservationType,\n    observation_record,\n    sanitize_text,\n)\nfrom ovcaq.events.model import has_invalid_unicode_scalar\nfrom ovcaq.runtime.session import SessionEvidenceWriter\nfrom ovcaq.state.schema import MAX_STATE_BYTES, JSONValue\n\n_PREVIEW_WINDOW_BYTES = 4096\n\n\nclass NormalizedEventWriter:\n    \"\"\"Write sanitized observations as private, bounded JSONL evidence.\"\"\"\n\n    def __init__(self, path: Path, *, max_bytes: int, min_free_bytes: int) -> None:\n        self._writer = SessionEvidenceWriter(\n            path, max_bytes=max_bytes, min_free_bytes=min_free_bytes\n        )\n\n    def write(self, observation: Observation) -> int:\n        payload = json.dumps(\n            observation_record(observation), ensure_ascii=False, allow_nan=False\n        )\n        return self._writer.write((payload + \"\\n\").encode(\"utf-8\"))\n\n    def flush(self) -> None:\n        self._writer.flush()\n\n    def close(self) -> None:\n        self._writer.close()\n\n\nclass RawFirstDecoder:\n    \"\"\"Frame only durable raw bytes, retaining bounded previews on decode failure.\"\"\"\n\n    def __init__(\n        self,\n        *,\n        raw: SessionEvidenceWriter,\n        normalized: NormalizedEventWriter,\n        driver: AgentDriver,\n        run_id: str,\n        session_id: str | None = None,\n        max_frame_bytes: int = 1024 * 1024,\n    ) -> None:\n        self._raw = raw\n        self._normalized = normalized\n        self._driver = driver\n        self._run_id = run_id\n        self._session_id = session_id\n        self._bind_identity = session_id is not None\n        self._max_frame_bytes = max_frame_bytes\n        self._buffer = bytearray()\n        self._length = 0\n        self._digest = hashlib.sha256()\n        self._last = b\"\"\n\n    def feed(self, chunk: bytes) -> tuple[Observation, ...]:\n        self._raw.write(chunk)\n        self._raw.flush()\n        emitted: list[Observation] = []\n        offset = 0\n        view = memoryview(chunk)\n        while offset < len(chunk):\n            newline = chunk.find(b\"\\n\", offset)\n            end = len(chunk) if newline < 0 else newline\n            segment = view[offset:end]\n            if segment:\n                # Defer the last byte so CRLF framing excludes its CR from the\n                # digest, even when the CR and LF arrive in separate chunks.\n                self._digest.update(self._last)\n                self._digest.update(segment[:-1])\n                self._last = bytes(segment[-1:])\n                self._length += len(segment)\n                capacity = max(self._max_frame_bytes + 1, 512) - len(self._buffer)\n                self._buffer.extend(segment[:capacity])\n            if newline < 0:\n                break\n            emitted.extend(self._complete(terminated=True))\n            offset = newline + 1\n        return tuple(emitted)\n\n    def finish(self) -> tuple[Observation, ...]:\n        self._raw.flush()\n        return self._complete(terminated=False) if self._length else ()\n\n    def _complete(self, *, terminated: bool) -> tuple[Observation, ...]:\n        trim_cr = terminated and self._last == b\"\\r\"\n        length = self._length - int(trim_cr)\n        if not trim_cr:\n            self._digest.update(self._last)\n        reason = \"frame exceeds byte limit\"\n        observations: tuple[Observation, ...] | None = None\n        if length <= self._max_frame_bytes:\n            try:\n                frame = self._buffer[:length].decode(\"utf-8\")\n            except UnicodeDecodeError:\n                reason = \"frame contains invalid UTF-8\"\n            else:\n                try:\n                    try:\n                        record = json.loads(frame)\n                    except (ValueError, RecursionError):\n                        record = None\n                    if has_invalid_unicode_scalar(record):\n                        reason = \"frame contains invalid Unicode scalar value\"\n                    else:\n                        # Consume lazy iterables before publishing any part of a frame.\n                        observations = tuple(self._driver.decode(frame))\n                except Exception:  # noqa: BLE001 - provider failures become observations\n                    reason = \"driver failed to decode frame\"\n        if observations is None:\n            observations = (self._unknown_observation(reason=reason, length=length),)\n        observations = self._bind_observations(observations)\n        self._buffer.clear()\n        self._length = 0\n        self._digest = hashlib.sha256()\n        self._last = b\"\"\n        for observation in observations:\n            self._normalized.write(observation)\n            if observation.session_id is not None:\n                self._session_id = observation.session_id\n        return observations\n\n    def _unknown_observation(self, *, reason: str, length: int) -> Observation:\n        return Observation(\n            protocol_version=PROTOCOL_VERSION,\n            timestamp=datetime.now(UTC),\n            provider=self._driver.name,\n            run_id=self._run_id,\n            session_id=self._session_id,\n            lane_id=None,\n            type=ObservationType.RAW_UNKNOWN,\n            payload={\n                \"reason\": reason,\n                \"raw_sha256\": self._digest.hexdigest(),\n                \"preview\": self._preview(length),\n            },\n        )\n\n    def _bind_observations(\n        self, observations: tuple[Observation, ...]\n    ) -> tuple[Observation, ...]:\n        if not self._bind_identity:\n            return observations\n        return tuple(\n            replace(\n                observation,\n                run_id=self._run_id,\n                session_id=self._session_id,\n                payload=(\n                    dict(observation.payload)\n                    | {\"source_session_id\": observation.session_id}\n                    if…9051 tokens truncated…date_head>` (the third arg is git's old-value guard — the CAS; `<current-branch>` from\n       `git rev-parse --abbrev-ref HEAD`). Then `git reset --hard` (the ref already points at the test\n       commit, so this only cleans the worktree). `<test_commit_sha>` is this task's own test commit,\n       captured in-session right after step 2.85 (or the step-2.9 strengthen commit, whichever\n       is the last test commit) — never a prior task's commit.\n     - the CAS fails (HEAD moved — a foreign commit raced in), OR either guard failed (foreign\n       uncommitted files, or a foreign commit already in `<test_commit_sha>..<candidate_head>`) → do\n       NOT reset; escalate fix-forward instead (dispatch the higher rung against the current tree +\n       failing tests, no reset) and log the deviation on the attempt. Never discard commits or files\n       this task did not create (memory: feedback_subagents_vs_live_worktree,\n       project_autopilot_head_moves_midreview). Fix-forward is the safe default whenever the reset is\n       not provably this-task-only AND atomic.\n  2. Stamp the LOWER rung's entry: `outcome:\"escalated\"`, `diagnosis:<verdict>` (+\n     `qwen_gate_failed:true` if that rung's implementor was qwen, + `repair_used:true` if a repair\n     ran at that rung). **If the task's `state.tasks[i]` entry carries a review-flag escalation\n     (`escalation_reason:\"review_flag\"` + `escalated_from`, set by /autopilot:run-autopilot Phase 6 when this\n     rung IS the review-flagged rework rung), copy both onto THIS lower-rung entry now** — Phase 6\n     escalated INTO this rung, so the `review_flag` reason belongs here; capturing it before step 3\n     clears it is what keeps the review-flag source recorded when a review-flagged task ALSO escalates\n     in-loop (otherwise the reason would be lost on this entry and mis-stamped on the higher rung).\n  3. `task-set-meta <task-id> <meta-json-file>` with the payload\n     `{\"model\": \"<new tier>\", \"escalation_reason\": null, \"escalated_from\": null}` — one call, one\n     payload file, three keys. The `model` key writes `state.tasks[i].model` directly in one locked\n     write, so there is no separate mirroring step. Run it BEFORE the dispatch below, so the\n     **Per-task model dispatch** rule picks up the escalated tier for Ivan and every downstream\n     read this task (step 5.6, step 5.7's tier gate). The two `null` values\n     **clear any `escalation_reason`/`escalated_from` from `state.tasks[i]` here** (`task-set-meta`\n     deletes a key whose value is JSON `null`) — point 2 already copied a\n     review-flag reason onto the lower-rung