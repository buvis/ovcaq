vcaq/drivers/codex.py').read_text()[:8000])\\\\\\\"\\\"\",\"aggregated_output\":\"\\\"\\\"\\\"Persist raw evidence before decoding bounded newline-delimited frames.\\\"\\\"\\\"\\n\\nimport hashlib\\nimport json\\nimport os\\nimport stat\\nfrom collections.abc import Callable, Mapping\\nfrom dataclasses import dataclass, replace\\nfrom datetime import UTC, datetime\\nfrom pathlib import Path\\nfrom typing import Literal, cast\\n\\nfrom ovcaq.drivers.base import AgentDriver\\nfrom ovcaq.events import (\\n    PROTOCOL_VERSION,\\n    Observation,\\n    ObservationType,\\n    observation_record,\\n    sanitize_text,\\n)\\nfrom ovcaq.runtime.session import SessionEvidenceWriter\\nfrom ovcaq.state.schema import MAX_STATE_BYTES, JSONValue\\n\\n_PREVIEW_WINDOW_BYTES = 4096\\n\\n\\nclass NormalizedEventWriter:\\n    \\\"\\\"\\\"Write sanitized observations as private, bounded JSONL evidence.\\\"\\\"\\\"\\n\\n    def __init__(self, path: Path, *, max_bytes: int, min_free_bytes: int) -> None:\\n        self._writer = SessionEvidenceWriter(\\n            path, max_bytes=max_bytes, min_free_bytes=min_free_bytes\\n        )\\n\\n    def write(self, observation: Observation) -> int:\\n        payload = json.dumps(\\n            observation_record(observation), ensure_ascii=False, allow_nan=False\\n        )\\n        return self._writer.write((payload + \\\"\\\\n\\\").encode(\\\"utf-8\\\"))\\n\\n    def flush(self) -> None:\\n        self._writer.flush()\\n\\n    def close(self) -> None:\\n        self._writer.close()\\n\\n\\nclass RawFirstDecoder:\\n    \\\"\\\"\\\"Frame only durable raw bytes, retaining bounded previews on decode failure.\\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        *,\\n        raw: SessionEvidenceWriter,\\n        normalized: NormalizedEventWriter,\\n        driver: AgentDriver,\\n        run_id: str,\\n        session_id: str | None = None,\\n        max_frame_bytes: int = 1024 * 1024,\\n    ) -> None:\\n        self._raw = raw\\n        self._normalized = normalized\\n        self._driver = driver\\n        self._run_id = run_id\\n        self._session_id = session_id\\n        self._bind_identity = session_id is not None\\n        self._max_frame_bytes = max_frame_bytes\\n        self._buffer = bytearray()\\n        self._length = 0\\n        self._digest = hashlib.sha256()\\n        self._last = b\\\"\\\"\\n\\n    def feed(self, chunk: bytes) -> tuple[Observation, ...]:\\n        self._raw.write(chunk)\\n        self._raw.flush()\\n        emitted: list[Observation] = []\\n        offset = 0\\n        view = memoryview(chunk)\\n        while offset < len(chunk):\\n            newline = chunk.find(b\\\"\\\\n\\\", offset)\\n            end = len(chunk) if newline < 0 else newline\\n            segment = view[offset:end]\\n            if segment:\\n                # Defer the last byte so CRLF framing excludes its CR from the\\n                # digest, even when the CR and LF arrive in separate chunks.\\n                self._digest.update(self._last)\\n                self._digest.update(segment[:-1])\\n                self._last = bytes(segment[-1:])\\n                self._length += len(segment)\\n                capacity = max(self._max_frame_bytes + 1, 512) - len(self._buffer)\\n                self._buffer.extend(segment[:capacity])\\n            if newline < 0:\\n                break\\n            emitted.extend(self._complete(terminated=True))\\n            offset = newline + 1\\n        return tuple(emitted)\\n\\n    def finish(self) -> tuple[Observation, ...]:\\n        self._raw.flush()\\n        return self._complete(terminated=False) if self._length else ()\\n\\n    def _complete(self, *, terminated: bool) -> tuple[Observation, ...]:\\n        trim_cr = terminated and self._last == b\\\"\\\\r\\\"\\n        length = self._length - int(trim_cr)\\n        if not trim_cr:\\n            self._digest.update(self._last)\\n        reason = \\\"frame exceeds byte limit\\\"\\n        observations: tuple[Observation, ...] | None = None\\n        if length <= self._max_frame_bytes:\\n            try:\\n                frame = self._buffer[:length].decode(\\\"utf-8\\\")\\n            except UnicodeDecodeError:\\n                reason = \\\"frame contains invalid UTF-8\\\"\\n            else:\\n                try:\\n                    # Consume lazy iterables before publishing any part of a frame.\\n                    observations = tuple(self._driver.decode(frame))\\n                except Exception:  # noqa: BLE001 - provider failures become observations\\n                    reason = \\\"driver failed to decode frame\\\"\\n        if observations is None:\\n            observations = (\\n                Observation(\\n                    protocol_version=PROTOCOL_VERSION,\\n                    timestamp=datetime.now(UTC),\\n                    provider=self._driver.name,\\n                    run_id=self._run_id,\\n                    session_id=self._session_id,\\n                    lane_id=None,\\n                    type=ObservationType.RAW_UNKNOWN,\\n                    payload={\\n                        \\\"reason\\\": reason,\\n                        \\\"raw_sha256\\\": self._digest.hexdigest(),\\n                        \\\"preview\\\": self._preview(length),\\n                    },\\n                ),\\n            )\\n        observations = self._bind_observations(observations)\\n        self._buffer.clear()\\n        self._length = 0\\n        self._digest = hashlib.sha256()\\n        self._last = b\\\"\\\"\\n        for observation in observations:\\n            self._normalized.write(observation)\\n            if observation.session_id is not None:\\n                self._session_id = observation.session_id\\n        return observations\\n\\n    def _bind_observations(\\n        self, observations: tuple[Observation, ...]\\n    ) -> tuple[Observation, ...]:\\n        if not self._bind_identity:\\n            return observations\\n        return tuple(\\n            replace(\\n                observation,\\n                run_id=self._run_id,\\n                session_id=self._session_id,\\n                payload=(\\n                    dict(observation.payload)\\n                    | {\\\"source_session_id\\\": observation.session_id}\\n                    if observation.type == ObservationType.SESSION_STARTED\\n                    and observation.session_id is not None\\n                    else observation.payload\\n                ),\\n            )\\n            for observation in observations\\n        )\\n\\n    def _preview(self, length: int) -> str:\\n        \\\"\\\"\\\"Sanitize a bounded head of the frame, never a cut-off final token.\\\"\\\"\\\"\\n        window = bytes(self._buffer[: min(_PREVIEW_WINDOW_BYTES, length)])\\n        text = window.decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n        if len(window) < length:\\n            # The window ends mid-frame; a secret may straddle the cut.\\n            end = len(text)\\n            while end and not text[end - 1].isspace():\\n                end -= 1\\n            if not end:\\n                # Unbroken window: an `sk-` token may hide in it unredacted.\\n                end = 0 if \\\"sk-\\\" in text.lower() else len(text)\\n            text = text[:end]\\n        return sanitize_text(text)[:512]\\n\\n\\n@dataclass(frozen=True, slots=True)\\nclass TailGap:\\n    kind: Literal[\\\"missing\\\", \\\"replaced\\\", \\\"truncated\\\", \\\"malformed\\\", \\\"oversized\\\"]\\n    detail: str\\n\\n\\n@dataclass(frozen=True, slots=True)\\nclass TailBatch[T]:\\n    records: tuple[T, ...]\\n    gaps: tuple[TailGap, ...]\\n    reset: bool\\n    backlog: bool\\n    complete_history: bool\\n\\n\\nclass JsonlFollower[T]:\\n    \\\"\\\"\\\"Follow appended JSONL objects with bounded work, never writing the file.\\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        path: Path,\\n        decode: Callable[[Mapping[str, JSONValue]], T],\\n        *,\\n        max_record_bytes: int = MAX_STATE_BYTES,\\n        replay_bytes: int = 256 * 1024,\\n        max_read_bytes: int = 1024 * 1024,\\n        max_records: int = 1024,\\n    ) -> None:\\n        self._path = path\\n        self._decoder = decode\\n        self._replay_bytes = replay_bytes\\n        self._max_records = max_records\\n        self._max_read_bytes = max_read_bytes\\n        self._max_record_bytes = max_record_bytes\\n        self._fd: int | None = None\\n        self._started = False\\n        self._offset = 0\\n        self._pending = bytearray()\\n        # Skips the rest of a row cut by replay or exceeding the size limit.\\n        self._discarding = False\\n        self._complete = True\\n\\n    def close(self) -> None:\\n        if self._fd is not None:\\n            os.close(self._fd)\\n            self._fd = None\\n\\n    def read(self) -> TailBatch[T]:\\n        gaps: list[TailGap] = []\\n        try:\\n            information = os.lstat(self._path)\\n        except FileNotFoundError:\\n            return TailBatch(\\n                (), (TailGap(\\\"missing\\\", \\\"file does not exist\\\"),), False, False, False\\n            )\\n        if not stat.S_ISREG(information.st_mode):\\n            return TailBatch(\\n                (), (TailGap(\\\"missing\\\", \\\"not a regular file\\\"),), False, False, False\\n            )\\n        reset = self._reset_if_changed(information, gaps)\\n        if self._fd is None:\\n            try:\\n                self._open(information)\\n            except (OSError, ValueError) as error:\\n                gap = TailGap(\\\"missing\\\", f\\\"cannot open file: {type(error).__name__}\\\")\\n                return TailBatch((), (*gaps, gap), reset, False, False)\\n        assert self._fd is not None\\n        records: list[T] = []\\n        budget = self._max_read_bytes\\n        while budget > 0 and len(records) < self._max_records:\\n            chunk = os.pread(self._fd, min(budget, 64 * 1024), self._offset)\\n            if not chunk:\\n                break\\n            consumed = self._consume(chunk, records, gaps)\\n            self._offset += consumed\\n            budget -= consumed\\n            if consumed < len(chunk):\\n                break\\n        backlog = self._offset < os.fstat(self._fd).st_size\\n        return TailBatch(\\n            tuple(records), tuple(gaps), reset, backlog, self._complete and not backlog\\n        )\\n\\n    def _reset_if_changed(\\n        self, information: os.stat_result, gaps: list[TailGap]\\n    ) -> bool:\\n        if self._fd is None:\\n            return False\\n        held = os.fstat(self._fd)\\n        change: Literal[\\\"replaced\\\", \\\"truncated\\\"] | None = None\\n        if not os.path.samestat(held, information):\\n            change = \\\"replaced\\\"\\n        elif information.st_size < self._offset:\\n            change = \\\"truncated\\\"\\n        if change is None:\\n            return False\\n        self.close()\\n        gaps.append(TailGap(change, f\\\"file was {change}; restarting at 0\\\"))\\n        self._offset = 0\\n        self._pending.clear()\\n        self._discarding = False\\n        self._complete = True\\n        return True\\n\\n    def _open(self, information: os.stat_result) -> None:\\n        descriptor = os.open(self._path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\\n        if not os.path.samestat(information, os.fstat(descriptor)):\\n            os.close(descriptor)\\n            raise ValueError(\\\"file changed while opening\\\")\\n        self._fd = descriptor\\n        if self._started:\\n            return\\n        self._started = True\\n        size = information.st_size\\n        if size > self._replay_bytes:\\n            self._offset = size - self._replay_bytes\\n            self._complete = False\\n            self._discarding = os.pread(descriptor, 1, self._offset - 1) != b\\\"\\\\n\\\"\\n\\n    def _consume(self, chunk: bytes, records: list[T], gaps: list[TailGap]) -> int:\\n        start = 0\\n        while start < len(chunk) and len(records) < self._max_records:\\n            newline = chunk.find(b\\\"\\\\n\\\", start)\\n            end = len(chunk) if newline < 0 else newline\\n            if not self._discarding:\\n                if len(self._pending) + end - start > self._max_record_bytes:\\n                    self._pending.clear()\\n                    self._discarding = True\\n                    gaps.append(\\n                        TailGap(\\n                            \\\"oversized\\\", f\\\"row exceeds {self._max_record_bytes} bytes\\\"\\n                        )\\n                    )\\n                else:\\n                    self._pending += chunk[start:end]\\n            if newline < 0:\\n                return len(chunk)\\n            if self._discarding:\\n                self._discarding = False\\n            else:\\n                self._decode(bytes(self._pending), records, gaps)\\n                self._pending.clear()\\n            start = newline + 1\\n        return start\\n\\n    def _decode(self, line: bytes, records: list[T], gaps: list[TailGap]) -> None:\\n        try:\\n            record = json.loads(line.decode(\\\"utf-8\\\"))\\n            if not isinstance(record, dict):\\n                raise TypeError(\\\"row is not a JSON object\\\")\\n            records.append(self._decoder(cast(Mapping[str, JSONValue], record)))\\n        except Exception as error:  # noqa: BLE001 - decoder failures become gaps\\n            # JSON RecursionError and any decoder fault become gaps; signals do not.\\n            gaps.append(TailGap(\\\"malformed\\\", f\\\"row rejected: {type(error).__name__}\\\"))\\n\\n\\\"\\\"\\\"Codex-native tool projection, failure classification, and retry deadlines.\\\"\\\"\\\"\\n\\nimport json\\nimport re\\nfrom datetime import UTC, datetime, timedelta\\n\\nfrom ovcaq.events.model import (\\n    FailureClass,\\n    JSONValue,\\n    ObservationType,\\n    Usage,\\n    sanitize_json,\\n    sanitize_text,\\n)\\n\\n\\ndef item_activity(item: object) -> dict[str, JSONValue] | None:\\n    if not isinstance(item, dict):\\n        return None\\n    item_id = item.get(\\\"id\\\")\\n    item_kind = item.get(\\\"type\\\")\\n    if not isinstance(item_id, str) or not item_id:\\n        return None\\n    detail = item.get(\\\"message\\\" if item_kind == \\\"error\\\" else \\\"text\\\")\\n    if item_kind in (\\\"agent_message\\\", \\\"reasoning\\\", \\\"error\\\") and isinstance(detail, str):\\n        return {\\n            \\\"kind\\\": {\\n                \\\"agent_message\\\": \\\"text\\\",\\n                \\\"reasoning\\\": \\\"thinking\\\",\\n                \\\"error\\\": \\\"error\\\",\\n            }[item_kind],\\n            \\\"text\\\": sanitize_text(detail)[:4096],\\n            \\\"message_id\\\": sanitize_text(item_id)[:4096],\\n        }\\n    if item_kind == \\\"todo_list\\\":\\n        steps = item.get(\\\"items\\\")\\n        if isinstance(steps, list) and all(\\n            isinstance(step, dict)\\n            and isinstance(step.get(\\\"text\\\"), str)\\n            and isinstance(step.get(\\\"completed\\\"), bool)\\n            for step in steps\\n        ):\\n            return {\\n                \\\"kind\\\": \\\"plan\\\",\\n                \\\"message_id\\\": sanitize_text(item_id)[:4096],\\n                \\\"items\\\": [\\n                    {\\n                        \\\"text\\\": sanitize_text(step[\\\"text\\\"])[:4096],\\n                        \\\"completed\\\": step[\\\"completed\\\"],\\n                    }\\n                    for step in steps\\n                ],\\n            }\\n    return None\\n\\n\\ndef bounded_detail(detail: str) -> str:\\n    \\\"\\\"\\\"Redact credentials and remove terminal controls before bounding detail.\\\"\\\"\\\"\\n    return re.sub(\\n        r\\\"\\\\x1b\\\\[[0-?]*[ -/]*[@-~]|[\\\\x00-\\\\x08\\\\x0b\\\\x0c\\\\x0e-\\\\x1f\\\\x7f]\\\",\\n        \\\"\\\",\\n        sanitize_text(detail),\\n    )[:4096]\\n\\n\\ndef turn_usage(native: object) -> tuple[Usage, str | None]:\\n    \\\"\\\"\\\"Normalize cumulative counters without inventing a cache partition.\\\"\\\"\\\"\\n    if not isinstance(native, dict):\\n        return Usage(), \\\"Missing or malformed Codex usage\\\"\\n    names = (\\n        \\\"input_tokens\\\",\\n        \\\"cached_input_tokens\\\",\\n        \\\"cache_write_input_tokens\\\",\\n        \\\"output_tokens\\\",\\n        \\\"reasoning_output_tokens\\\",\\n    )\\n    counts: list[int | None] = []\\n    gap = None\\n    for name in names:\\n        value = native.get(name)\\n        if type(value) is int and value >= 0:\\n            counts.append(value)\\n        else:\\n            counts.append(None)\\n            if name in native or name in names[:3]:\\n                gap = \\\"Missing or invalid Codex usage counter\\\"\\n    if all(value == 0 for value in counts):\\n        return Usage(), \\\"Default zero Codex usage lacks telemetry\\\"\\n    inclusive, read, write, output, _reasoning = counts\\n    uncached = None\\n    estimated = write is not None and write > 0\\n    if estimated:\\n        gap = \\\"; \\\".join(\\n            reason\\n            for reason in (gap, \\\"Codex cache-write input partition is unknown\\\")\\n            if reason\\n        )\\n    elif inclusive is not None and read is not None and write == 0:\\n        if read <= inclusive:\\n            uncached = inclusive - read\\n        else:\\n            gap = \\\"; \\\".join(\\n                reason\\n                for reason in (gap, \\\"Codex cache reads exceed inclusive input\\\")\\n                if reason\\n            )\\n    return Usage(\\n        input_tokens=uncached,\\n        output_tokens=output,\\n        cache_creation_input_tokens=write,\\n        cache_read_input_tokens=read,\\n        estimated=estimated,\\n    ), gap\\n\\n\\ndef command_detail(item: dict[str, object]) -> str | None:\\n    command, output, exit_code = (\\n        item.get(\\\"command\\\"),\\n        item.get(\\\"aggregated_output\\\"),\\n        item.get(\\\"exit_code\\\"),\\n    )\\n    if not isinstance(command, str) or not isinstance(output, str):\\n        return None\\n    if exit_code is not None and type(exit_code) is not int:\\n        return None\\n    return sanitize_text(f\\\"{command}\\\\n{output}\\\")[:4096]\\n\\n\\ndef file_detail(item: dict[str, object]) -> str | None:\\n    changes = item.get(\\\"changes\\\")\\n    if not isinstance(changes, list) or not all(\\n        isinstance(change, dict)\\n        and isinstance(change.get(\\\"path\\\"), str)\\n        and change.get(\\\"kind\\\") in (\\\"add\\\", \\\"delete\\\", \\\"update\\\")\\n        for change in changes\\n    ):\\n        return None\\n    return sanitize_text(\\n        \\\"; \\\".join(f\\\"{change['kind']}: {change['path']}\\\" for change in changes)\\n    )[:4096]\\n\\n\\ndef mcp_detail(item: dict[str, object]) -> str | None:\\n    if not all(isinstance(item.get(key), str) for key in (\\\"server\\\", \\\"tool\\\")):\\n        return None\\n    result, error = item.get(\\\"result\\\"), item.get(\\\"error\\\")\\n    if result is not None and (\\n        not isinstance(result, dict) or not isinstance(result.get(\\\"content\\\"), list)\\n    ):\\n        return None\\n    if error is not None and (\\n        not isinstance(error, dict) or not isinstance(error.get(\\\"message\\\"), str)\\n    ):\\n        return None\\n    detail = {key: item.get(key) for key in (\\\"server\\\", \\\"tool\\\", \\\"result\\\", \\\"error\\\")}\\n    return json.dumps(sanitize_json(detail), ensure_ascii=False)[:4096]\\n\\n\\ndef web_detail(item: dict[str, object]) -> str | None:\\n    action = item.get(\\\"action\\\")\\n    if not isinstance(item.get(\\\"query\\\"), str) or not isinstance(action, dict):\\n        return None\\n    action_kind = action.get(\\\"type\\\")\\n    if not isinstance(action_kind, str):\\n        return None\\n    fields = {\\n        \\\"search\\\": (\\\"query\\\",),\\n        \\\"open_page\\\": (\\\"url\\\",),\\n        \\\"find_in_page\\\": (\\\"url\\\", \\\"pattern\\\"),\\n    }.get(action_kind, ())\\n    if any(\\n        action.get(key) is not None and not isinstance(action[key], str)\\n        for key in fields\\n    ):\\n        return None\\n    queries = action.get(\\\"queries\\\")\\n    if (\\n        action_kind == \\\"search\\\"\\n        and queries is not None\\n        and (\\n            not isinstance(queries, list)\\n            or not all(isinstance(query, str) for query in queries)\\n        )\\n    ):\\n        return None\\n    if \\\"results\\\" in item and not isinstance(item[\\\"results\\\"], list):\\n        return None\\n    detail = {key: item.get(key) for key in (\\\"query\\\", \\\"action\\\", \\\"results\\\")}\\n    return json.dumps(sanitize_json(detail), ensure_ascii=False)[:4096]\\n\\n\\ndef collab_detail(item: dict[str, object]) -> str | None:\\n    if item.get(\\\"tool\\\") not in (\\\"spawn_agent\\\", \\\"send_input\\\", \\\"wait\\\", \\\"close_agent\\\"):\\n        return None\\n    if not isinstance(item.get(\\\"sender_thread_id\\\"), str):\\n        return None\\n    prompt = item.get(\\\"prompt\\\")\\n    if prompt is not None and not isinstance(prompt, str):\\n        return None\\n    return sanitize_text(prompt or \\\"\\\")[:4096]\\n\\n\\ndef item_lanes(\\n    item: object,\\n    started_lanes: set[str] | None = None,\\n) -> tuple[list[tuple[str, ObservationType, dict[str, JSONValue]]], bool]:\\n    if not isinstance(item, dict) or item.get(\\\"type\\\") != \\\"collab_tool_call\\\":\\n        return [], False\\n    receivers, states = item.get(\\\"receiver_thread_ids\\\"), item.get(\\\"agents_states\\\")\\n    if not isinstance(receivers, list) or not receivers or not isinstance(states, dict):\\n        return [], True\\n    kinds = {\\n        \\\"pending_init\\\": ObservationType.LANE_PROGRESS,\\n        \\\"running\\\": ObservationType.LANE_PROGRESS,\\n        \\\"completed\\\": ObservationType.LANE_COMPLETED,\\n        \\\"errored\\\": ObservationType.LANE_FAILED,\\n    }\\n    result: list[tuple[str, ObservationType, dict[str, JSONValue]]] = []\\n    has_unknown = False\\n    for receiver in receivers:\\n        if not isinstance(receiver, str) or not receiver:\\n            has_unknown = True\\n            continue\\n        state = states.get(receiver)\\n        if not isinstance(state, dict):\\n            has_unknown = True\\n            continue\\n        status, message = state.get(\\\"status\\\"), state.get(\\\"message\\\")\\n        if (\\n            status in (\\\"interrupted\\\", \\\"shutdown\\\", \\\"not_found\\\")\\n            and started_lanes is not None\\n            and receiver in started_lanes\\n        ):\\n            status = \\\"errored\\\"\\n        if (\\n            not isinstance(status, str)\\n            or status not in kinds\\n            or (message is not None and not isinstance(message, str))\\n        ):\\n            has_unknown = True\\n            continue\\n        result.append(\\n            (\\n                receiver,\\n                kinds[status],\\n                {\\\"label\\\": \\\"Receiver\\\", \\\"detail\\\": bounded_detail(message or \\\"\\\")},\\n            )\\n        )\\n    return result, has_unknown\\n\\n\\ndef item_tool(\\n    item: object,\\n    event: str,\\n) -> tuple[ObservationType, dict[str, JSONValue]] | None:\\n    if not isinstance(item, dict):\\n        return None\\n    item_id, item_kind = item.get(\\\"id\\\"), item.get(\\\"type\\\")\\n    if not isinstance(item_id, str) or not item_id or not isinstance(item_kind, str):\\n        return None\\n    projections = {\\n        \\\"command_execution\\\": (\\\"command\\\", command_detail),\\n        \\\"file_change\\\": (\\\"file change\\\", file_detail),\\n        \\\"mcp_tool_call\\\": (\\\"remote tool\\\", mcp_detail),\\n        \\\"web_search\\\": (\\\"web search\\\",