+{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c \\\"from pathlib import Path; import ast; p=Path('src/ovcaq/events/tail.py'); print(p.read_text()); print(Path('tests/events/test_tail.py').read_text()[:13000]); print(Path('docs/dev/project-management/prds/wip/00051-triage-a-single-valid-codex-record-can-crash-th-v1.md').read_text())\\\"\"","aggregated_output":"\"\"\"Persist raw evidence before decoding bounded newline-delimited frames.\"\"\"\n\nimport hashlib\nimport json\nimport os\nimport stat\nfrom collections.abc import Callable, Mapping\nfrom dataclasses import dataclass, replace\nfrom datetime import UTC, datetime\nfrom pathlib import Path\nfrom typing import Literal, cast\n\nfrom ovcaq.drivers.base import AgentDriver\nfrom ovcaq.events import (\n    PROTOCOL_VERSION,\n    Observation,\n    ObservationType,\n    observation_record,\n    sanitize_text,\n)\nfrom ovcaq.runtime.session import SessionEvidenceWriter\nfrom ovcaq.state.schema import MAX_STATE_BYTES, JSONValue\n\n_PREVIEW_WINDOW_BYTES = 4096\n\n\nclass NormalizedEventWriter:\n    \"\"\"Write sanitized observations as private, bounded JSONL evidence.\"\"\"\n\n    def __init__(self, path: Path, *, max_bytes: int, min_free_bytes: int) -> None:\n        self._writer = SessionEvidenceWriter(\n            path, max_bytes=max_bytes, min_free_bytes=min_free_bytes\n        )\n\n    def write(self, observation: Observation) -> int:\n        payload = json.dumps(\n            observation_record(observation), ensure_ascii=False, allow_nan=False\n        )\n        return self._writer.write((payload + \"\\n\").encode(\"utf-8\"))\n\n    def flush(self) -> None:\n        self._writer.flush()\n\n    def close(self) -> None:\n        self._writer.close()\n\n\nclass RawFirstDecoder:\n    \"\"\"Frame only durable raw bytes, retaining bounded previews on decode failure.\"\"\"\n\n    def __init__(\n        self,\n        *,\n        raw: SessionEvidenceWriter,\n        normalized: NormalizedEventWriter,\n        driver: AgentDriver,\n        run_id: str,\n        session_id: str | None = None,\n        max_frame_bytes: int = 1024 * 1024,\n    ) -> None:\n        self._raw = raw\n        self._normalized = normalized\n        self._driver = driver\n        self._run_id = run_id\n        self._session_id = session_id\n        self._bind_identity = session_id is not None\n        self._max_frame_bytes = max_frame_bytes\n        self._buffer = bytearray()\n        self._length = 0\n        self._digest = hashlib.sha256()\n        self._last = b\"\"\n\n    def feed(self, chunk: bytes) -> tuple[Observation, ...]:\n        self._raw.write(chunk)\n        self._raw.flush()\n        emitted: list[Observation] = []\n        offset = 0\n        view = memoryview(chunk)\n        while offset < len(chunk):\n            newline = chunk.find(b\"\\n\", offset)\n            end = len(chunk) if newline < 0 else newline\n            segment = view[offset:end]\n            if segment:\n                # Defer the last byte so CRLF framing excludes its CR from the\n                # digest, even when the CR and LF arrive in separate chunks.\n                self._digest.update(self._last)\n                self._digest.update(segment[:-1])\n                self._last = bytes(segment[-1:])\n                self._length += len(segment)\n                capacity = max(self._max_frame_bytes + 1, 512) - len(self._buffer)\n                self._buffer.extend(segment[:capacity])\n            if newline < 0:\n                break\n            emitted.extend(self._complete(terminated=True))\n            offset = newline + 1\n        return tuple(emitted)\n\n    def finish(self) -> tuple[Observation, ...]:\n        self._raw.flush()\n        return self._complete(terminated=False) if self._length else ()\n\n    def _complete(self, *, terminated: bool) -> tuple[Observation, ...]:\n        trim_cr = terminated and self._last == b\"\\r\"\n        length = self._length - int(trim_cr)\n        if not trim_cr:\n            self._digest.update(self._last)\n        reason = \"frame exceeds byte limit\"\n        observations: tuple[Observation, ...] | None = None\n        if length <= self._max_frame_bytes:\n            try:\n                frame = self._buffer[:length].decode(\"utf-8\")\n            except UnicodeDecodeError:\n                reason = \"frame contains invalid UTF-8\"\n            else:\n                try:\n                    # Consume lazy iterables before publishing any part of a frame.\n                    observations = tuple(self._driver.decode(frame))\n                except Exception:  # noqa: BLE001 - provider failures become observations\n                    reason = \"driver failed to decode frame\"\n        if observations is None:\n            observations = (\n                Observation(\n                    protocol_version=PROTOCOL_VERSION,\n                    timestamp=datetime.now(UTC),\n                    provider=self._driver.name,\n                    run_id=self._run_id,\n                    session_id=self._session_id,\n                    lane_id=None,\n                    type=ObservationType.RAW_UNKNOWN,\n                    payload={\n                        \"reason\": reason,\n                        \"raw_sha256\": self._digest.hexdigest(),\n                        \"preview\": self._preview(length),\n                    },\n                ),\n            )\n        observations = self._bind_observations(observations)\n        self._buffer.clear()\n        self._length = 0\n        self._digest = hashlib.sha256()\n        self._last = b\"\"\n        for observation in observations:\n            self._normalized.write(observation)\n            if observation.session_id is not None:\n                self._session_id = observation.session_id\n        return observations\n\n    def _bind_observations(\n        self, observations: tuple[Observation, ...]\n    ) -> tuple[Observation, ...]:\n        if not self._bind_identity:\n            return observations\n        return tuple(\n            replace(\n                observation,\n                run_id=self._run_id,\n                session_id=self._session_id,\n                payload=(\n                    dict(observation.payload)\n                    | {\"source_session_id\": observation.session_id}\n                    if observation.type == ObservationType.SESSION_STARTED\n                    and observation.session_id is not None\n                    else observation.payload\n                ),\n            )\n            for observation in observations\n        )\n\n    def _preview(self, length: int) -> str:\n        \"\"\"Sanitize a bounded head of the frame, never a cut-off final token.\"\"\"\n        window = bytes(self._buffer[: min(_PREVIEW_WINDOW_BYTES, length)])\n        text = window.decode(\"utf-8\", errors=\"replace\")\n        if len(window) < length:\n            # The window ends mid-frame; a secret may straddle the cut.\n            end = len(text)\n            while end and not text[end - 1].isspace():\n                end -= 1\n            if not end:\n                # Unbroken window: an `sk-` token may hide in it unredacted.\n                end = 0 if \"sk-\" in text.lower() else len(text)\n            text = text[:end]\n        return sanitize_text(text)[:512]\n\n\n@dataclass(frozen=True, slots=True)\nclass TailGap:\n    kind: Literal[\"missing\", \"replaced\", \"truncated\", \"malformed\", \"oversized\"]\n    detail: str\n\n\n@dataclass(frozen=True, slots=True)\nclass TailBatch[T]:\n    records: tuple[T, ...]\n    gaps: tuple[TailGap, ...]\n    reset: bool\n    backlog: bool\n    complete_history: bool\n\n\nclass JsonlFollower[T]:\n    \"\"\"Follow appended JSONL objects with bounded work, never writing the file.\"\"\"\n\n    def __init__(\n        self,\n        path: Path,\n        decode: Callable[[Mapping[str, JSONValue]], T],\n        *,\n        max_record_bytes: int = MAX_STATE_BYTES,\n        replay_bytes: int = 256 * 1024,\n        max_read_bytes: int = 1024 * 1024,\n        max_records: int = 1024,\n    ) -> None:\n        self._path = path\n        self._decoder = decode\n        self._replay_bytes = replay_bytes\n        self._max_records = max_records\n        self._max_read_bytes = max_read_bytes\n        self._max_record_bytes = max_record_bytes\n        self._fd: int | None = None\n        self._started = False\n        self._offset = 0\n        self._pending = bytearray()\n        # Skips the rest of a row cut by replay or exceeding the size limit.\n        self._discarding = False\n        self._complete = True\n\n    def close(self) -> None:\n        if self._fd is not None:\n            os.close(self._fd)\n            self._fd = None\n\n    def read(self) -> TailBatch[T]:\n        gaps: list[TailGap] = []\n        try:\n            information = os.lstat(self._path)\n        except FileNotFoundError:\n            return TailBatch(\n                (), (TailGap(\"missing\", \"file does not exist\"),), False, False, False\n            )\n        if not stat.S_ISREG(information.st_mode):\n            return TailBatch(\n                (), (TailGap(\"missing\", \"not a regular file\"),), False, False, False\n            )\n        reset = self._reset_if_changed(information, gaps)\n        if self._fd is None:\n            try:\n                self._open(information)\n            except (OSError, ValueError) as error:\n                gap = TailGap(\"missing\", f\"cannot open file: {type(error).__name__}\")\n                return TailBatch((), (*gaps, gap), reset, False, False)\n        assert self._fd is not None\n        records: list[T] = []\n        budget = self._max_read_bytes\n        while budget > 0 and len(records) < self._max_records:\n            chunk = os.pread(self._fd, min(budget, 64 * 1024), self._offset)\n            if not chunk:\n                break\n            consumed = self._consume(chunk, records, gaps)\n            self._offset += consumed\n            budget -= consumed\n            if consumed < len(chunk):\n                break\n        backlog = self._offset < os.fstat(self._fd).st_size\n        return TailBatch(\n            tuple(records), tuple(gaps), reset, backlog, self._complete and not backlog\n        )\n\n    def _reset_if_changed(\n        self, information: os.stat_result, gaps: list[TailGap]\n    ) -> bool:\n        if self._fd is None:\n            return False\n        held = os.fstat(self._fd)\n        change: Literal[\"replaced\", \"truncated\"] | None = None\n        if not os.path.samestat(held, information):\n            change = \"replaced\"\n        elif information.st_size < self._offset:\n            change = \"truncated\"\n        if change is None:\n            return False\n        self.close()\n        gaps.append(TailGap(change, f\"file was {change}; restarting at 0\"))\n        self._offset = 0\n        self._pending.clear()\n        self._discarding = False\n        self._complete = True\n        return True\n\n    def _open(self, information: os.stat_result) -> None:\n        descriptor = os.open(self._path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n        if not os.path.samestat(information, os.fstat(descriptor)):\n            os.close(descriptor)\n            raise ValueError(\"file changed while opening\")\n        self._fd = descriptor\n        if self._started:\n            return\n        self._started = True\n        size = information.st_size\n        if size > self._replay_bytes:\n            self._offset = size - self._replay_bytes\n            self._complete = False\n            self._discarding = os.pread(descriptor, 1, self._offset - 1) != b\"\\n\"\n\n    def _consume(self, chunk: bytes, records: list[T], gaps: list[TailGap]) -> int:\n        start = 0\n        while start < len(chunk) and len(records) < self._max_records:\n            newline = chunk.find(b\"\\n\", start)\n            end = len(chunk) if newline < 0 else newline\n            if not self._discarding:\n                if len(self._pending) + end - start > self._max_record_bytes:\n                    self._pending.clear()\n                    self._discarding = True\n                    gaps.append(\n                        TailGap(\n                            \"oversized\", f\"row exceeds {self._max_record_bytes} bytes\"\n                        )\n                    )\n                else:\n                    self._pending += chunk[start:end]\n            if newline < 0:\n                return len(chunk)\n            if self._discarding:\n                self._discarding = False\n            else:\n                self._decode(bytes(self._pending), records, gaps)\n                self._pending.clear()\n            start = newline + 1\n        return start\n\n    def _decode(self, line: bytes, records: list[T], gaps: list[TailGap]) -> None:\n        try:\n            record = json.loads(line.decode(\"utf-8\"))\n            if not isinstance(record, dict):\n                raise TypeError(\"row is not a JSON object\")\n            records.append(self._decoder(cast(Mapping[str, JSONValue], record)))\n        except Exception as error:  # noqa: BLE001 - decoder failures become gaps\n            # JSON RecursionError and any decoder fault become gaps; signals do not.\n            gaps.append(TailGap(\"malformed\", f\"row rejected: {type(error).__name__}\"))\n\nfrom __future__ import annotations\n\nimport errno\nimport hashlib\nimport json\nimport os\nimport stat\nimport time\nimport tracemalloc\nfrom collections.abc import Callable, Iterable\nfrom dataclasses import replace\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport pytest\n\nfrom ovcaq.events import (\n    PROTOCOL_VERSION,\n    Observation,\n    ObservationType,\n    observation_from_record,\n    observation_record,\n)\nfrom ovcaq.events.tail import NormalizedEventWriter, RawFirstDecoder\nfrom ovcaq.runtime.session import EvidenceLimitError, SessionEvidenceWriter\n\n\ndef _observation(message: str) -> Observation:\n    return Observation(\n        protocol_version=1,\n        timestamp=datetime(2026, 1, 1, tzinfo=UTC),\n        provider=\"fake\",\n        run_id=\"run-1\",\n        session_id=None,\n        lane_id=None,\n        type=ObservationType.ACTIVITY_MESSAGE,\n        payload={\"message\": message},\n    )\n\n\ndef _read_observations(path: Path) -> tuple[Observation, ...]:\n    return tuple(\n        observation_from_record(json.loads(line))\n        for line in path.read_bytes().splitlines()\n    )\n\n\ndef _assert_unknown_evidence(\n    observation: Observation, frame: bytes, ordinary: str\n) -> None:\n    assert observation.type == ObservationType.RAW_UNKNOWN\n    assert observation.payload[\"raw_sha256\"] == hashlib.sha256(frame).hexdigest()\n    reason = observation.payload[\"reason\"]\n    assert isinstance(reason, str) and reason.strip()\n    preview = observation.payload[\"preview\"]\n    assert isinstance(preview, str)\n    assert ordinary in preview\n\n\nclass RecordingDriver:\n    name = \"fake\"\n\n    def __init__(self, before_decode: Callable[[], None] | None = None) -> None:\n        self.lines: list[str] = []\n        self.before_decode = before_decode\n\n    def decode(self, raw_line: str) -> Iterable[Observation]:\n        if self.before_decode is not None:\n            self.before_decode()\n        self.lines.append(raw_line)\n        return (_observation(raw_line), _observation(\"second observation\"))\n\n\n@pytest.fixture\ndef evidence(tmp_path: Path):\n    raw = SessionEvidenceWriter(\n        tmp_path / \"raw.jsonl\", max_bytes=4 << 20, min_free_bytes=0\n    )\n    normalized = NormalizedEventWriter(\n        tmp_path / \"normalized.jsonl\", max_bytes=4 << 20, min_free_bytes=0\n    )\n    try:\n        yield raw, normalized\n    finally:\n        normalized.close()\n        raw.close()\n\n\ndef test_normalized_lines_are_private_sanitized_and_round_trip(tmp_path: Path) -> None:\n    path = tmp_path / \"normalized.jsonl\"\n    previous_umask = os.umask(0)\n    try:\n        writer = NormalizedEventWriter(path, max_bytes=4096, min_free_bytes=0)\n    finally:\n        os.umask(previous_umask)\n    observations = (_observation(\"token=hidden-value\\nhello é\"), _observation(\"next\"))\n    try:\n        assert stat.S_ISREG(path.stat().st_mode)\n        assert stat.S_IMODE(path.stat().st_mode) == 0o600\n        previous_size = 0\n        for observation in observations:\n            accepted = writer.write(observation)\n            content = path.read_bytes()\n            assert accepted == len(content) - previous_size\n            assert content.endswith(b\"\\n\")\n            assert b\"hidden-value\" not in content\n            previous_size = len(content)\n        lines = path.read_bytes().splitlines()\n        assert len(lines) == len(observations)\n        assert [json.loads(line) for line in lines] == [\n            observation_record(observation) for observation in observations\n        ]\n        assert _read_observations(path) == observations\n    finally:\n        writer.close()\n\n\n@pytest.mark.parametrize(\n    \"obstacle\", [\"file\", \"symlink\", \"dangling\", \"directory\", \"fifo\"]\n)\ndef test_normalized_creation_preserves_existing_paths(\n    tmp_path: Path, obstacle: str\n) -> None:\n    path = tmp_path / \"normalized.jsonl\"\n    target = tmp_path / \"target\"\n    target.write_bytes(b\"preserve\")\n    if obstacle == \"file\":\n        path.write_bytes(b\"prior evidence\")\n    elif obstacle == \"symlink\":\n        path.symlink_to(target)\n    elif obstacle == \"dangling\":\n        path.symlink_to(tmp_path / \"missing\")\n    elif obstacle == \"directory\":\n        path.mkdir()\n    else:\n        os.mkfifo(path)\n    before = path.lstat()\n    with pytest.raises(OSError):\n        NormalizedEventWriter(path, max_bytes=4096, min_free_bytes=0)\n    assert os.path.samestat(before, path.lstat())\n    assert target.read_bytes() == b\"preserve\"\n    assert not (tmp_path / \"missing\").exists()\n    if obstacle == \"file\":\n        assert path.read_bytes() == b\"prior evidence\"\n\n\ndef test_normalized_ceiling_rejects_whole_record_without_damaging_prior_line(\n    tmp_path: Path,\n) -> None:\n    observation = _observation(\"bounded\")\n    reference = tmp_path / \"reference.jsonl\"\n    writer = NormalizedEventWriter(reference, max_bytes=4096, min_free_bytes=0)\n    try:\n        length = writer.write(observation)\n    finally:\n        writer.close()\n    path = tmp_path / \"normalized.jsonl\"\n    writer = NormalizedEventWriter(path, max_bytes=length, min_free_bytes=0)\n    try:\n        assert writer.write(observation) == length\n        with pytest.raises(EvidenceLimitError):\n            writer.write(observation)\n        assert path.read_bytes() == reference.read_bytes()\n        assert _read_observations(path) == (observation,)\n    finally:\n        writer.close()\n\n\n@pytest.mark.parametrize(\"obstacle\", [\"symlink\", \"world-writable\"])\ndef test_normalized_writer_rejects_unsafe_parent(tmp_path: Path, obstacle: str) -> None:\n    target = tmp_path / \"target\"\n    target.mkdir(mode=0o700)\n    parent = tmp_path / \"session\"\n    if obstacle == \"symlink\":\n        parent.symlink_to(target, target_is_directory=True)\n    else:\n        parent.mkdir(mode=0o700)\n        parent.chmod(0o777)\n    with pytest.raises(ValueError):\n        NormalizedEventWriter(\n            parent / \"normalized.jsonl\", max_bytes=4096, min_free_bytes=0\n        )\n    assert not (parent / \"normalized.jsonl\").exists()\n    assert list(target.iterdir()) == []\n\n\ndef test_normalized_records_respect_space_floor_and_finish_partial_writes(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    available = 10000\n\n    def filesystem_space(_location: object) -> os.statvfs_result:\n        return os.statvfs_result((1, 1, 10000, 10000, available, 1, 1, 1, 0, 255))\n\n    monkeypatch.setattr(os, \"statvfs\", filesystem_space)\n    monkeypatch.setattr(os, \"fstatvfs\", filesystem_space)\n    path = tmp_path / \"normalized.jsonl\"\n    writer = NormalizedEventWriter(path, max_bytes=4096, min_free_bytes=128)\n    real_write = os.write\n    calls = 0\n\n    def partial_write(descriptor: int, payload: bytes) -> int:\n        nonlocal calls\n        calls += 1\n        if calls % 3 == 1:\n            raise InterruptedError(errno.EINTR, \"interrupted\")\n        return real_write(descriptor, payload[:17])\n\n    observation = _observation(\"partial é\")\n    try:\n        with monkeypatch.context() as patch:\n            patch.setattr(os, \"write\", partial_write)\n            length = writer.write(observation)\n        assert length == len(path.read_bytes())\n        available = 128 + length - 1\n        with pytest.raises(EvidenceLimitError):\n            writer.write(observation)\n        assert _read_observations(path) == (observation,)\n        available = 128 + length\n        assert writer.write(observation) == length\n        assert _read_observations(path) == (observation, observation)\n    finally:\n        writer.close()\n\n\ndef test_normalized_write_failure_preserves_prior_line_and_partial_new_bytes(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    path = tmp_path / \"normalized.jsonl\"\n    writer = NormalizedEventWriter(path, max_bytes=4096, min_free_bytes=0)\n    observation = _observation(\"partial failure\")\n    real_write = os.write\n    accepted = False\n\n    def failing_write(descriptor: int, payload: bytes) -> int:\n        nonlocal accepted\n        if not accepted:\n            accepted = True\n            return real_write(descriptor, payload[:7])\n        raise OSError(errno.ENOSPC, \"injected disk full\")\n\n    try:\n        writer.write(observation)\n        previous = path.read_bytes()\n        with monkeypatch.context() as patch:\n            patch.setattr(os, \"write\", failing_write)\n            with pytest.raises(OSError):\n                writer.write(observation)\n        assert path.read_bytes() == previous + previous[:7]\n    finally:\n        writer.close()\n    assert path.read_bytes() == previous + previous[:7]\n\n\ndef test_normalized_close_syncs_and_closes_once(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    path = tmp_path / \"normalized.jsonl\"\n    writer = NormalizedEventWriter(path, max_bytes=4096, min_free_bytes=0)\n    observation = _observation(\"durable\")\n    writer.write(observation)\n    information = path.stat()\n    real_fsync, real_close = os.fsync, os.close\n    events: list[str] = []\n\n    def sync(descriptor: int) -> None:\n        is_evidence = os.path.samestat(information, os.fstat(descriptor))\n        real_fsync(descriptor)\n        if is_evidence:\n            events.append(\"sync\")\n\n    def close(descriptor: int) -> None:\n        is_evidence = os.path.samestat(information, os.fstat(descriptor))\n        real_close(descriptor)\n        if is_evidence:\n            events.append(\"close\")\n\n    monkeypatch.setattr(os, \"fsync\", sync)\n    monkeypatch.setattr(os, \"close\", close)\n    try:\n        writer.close()\n        writer.close()\n        assert events == [\"sync\", \"close\"]\n        with pytest.raises(ValueError):\n            writer.write(observation)\n        assert _read_observations(path) == (observation,)\n    finally:\n        writer.close()\n\n\n@pytest.mark.parametrize(\"chunk_size\", [1, 3, 4096])\ndef test_frames_decode_only_after_exact_raw_bytes_are_synced(\n    tmp_path: Path, evidence, monkeypatch: pytest.MonkeyPatch, chunk_size: int\n) -> None:\n    raw, normalized = evidence\n    path = tmp_path / \"raw.jsonl\"\n    information = path.stat()\n    real_fsync = os.fsync\n    durable = b\"\"\n    expected = b\"\"\n\n    def sync(descriptor: int) -> None:\n        nonlocal durable\n        real_fsync(descriptor)\n        if os.path.samestat(information, os.fstat(descriptor)):\n            durable = path.read_bytes()\n\n    def before_decode() -> None:\n        assert path.read_bytes() == expected\n        assert durable == expected\n\n    monkeypatch.setattr(os, \"fsync\", sync)\n    driver = RecordingDriver(before_decode)\n    decoder = RawFirstDecoder(\n        raw=raw, normalized=normalized, driver=driver, run_id=\"run-1\"\n    )\n    payload = b\"first\\r\\n\\n\\xc3\\xa9\\nlast\"\n    emitted: tuple[Observation, ...] = ()\n    assert decoder.feed(b\"\") == ()\n    for offset in range(0, len(payload), chunk_size):\n        chunk = payload[offset : offset + chunk_size]\n        expected += chunk\n        emitted += decoder.feed(chunk)\n        assert path.read_bytes() == expected\n        assert _read_observations(tmp_path / \"normalized.jsonl\") == emitted\n    assert driver.lines == [\"first\", \"\", \"é\"]\n    emitted += decoder.finish()\n    assert driver.lines == [\"first\", \"\", \"é\", \"last\"]\n    assert emitted == tuple(\n        observation\n        for line in driver.lines\n        for observation in (_observation(line), _observation(\"second observation\"))\n    )\n    assert _read_observations(tmp_path / \"normalized.jsonl\") == emitted\n\n\n@pytest.mark.parametrize(\"chunk_size\", (1, 4096))\n@pytest.mark.parametrize(\"terminated\", (False, True))\ndef test_invalid_utf8_preserves_original_bytes_and_emits_one_bounded_unknown(\n    tmp_path: Path, evidence, chunk_size: int, terminated: bool\n) -> None:\n    raw, normalized = evidence\n    driver = RecordingDriver()\n    decoder = RawFirstDecoder(\n        raw=raw, normalized=normalized, driver=driver, run_id=\"run-1\"\n    )\n    frame = b'{\"text\":\"ordinary token=hidden-value \\xff' + b\"x\" * 1000 + b'\"}'\n    stream = b\"good\\n\" + frame + (b\"\\n\" if terminated else b\"\")\n    emitted = (\n        tuple(\n            item\n            for offset in range(0, len(stream), chunk_size)\n            for item in decoder.feed(stream[offset : offset + chunk_size])\n        )\n        + decoder.finish()\n    )\n    assert len(emitted) == 3\n    assert emitted[:2] == (_observation(\"good\"), _observation(\"second observation\"))\n    unknown = emitted[-1]\n    _assert_unknown_evidence(unknown, frame, \"ordinary\")\n    assert unknown.run_id == \"run-1\"\n    assert unknown.protocol_version == PROTOCOL_VERSION\n    assert len(unknown.payload[\"preview\"]) <= 512\n    assert \"hidden-value\" not in unknown.payload[\"preview\"]\n    assert driver.lines == [\"good\"]\n    assert (tmp_path / \"raw.jsonl\").read_bytes() == stream\n    assert _read_observations(tmp_path / \"normalized.jsonl\") == emitted\n\n\ndef test_raw_decoder_requires_explicit_run_identity(evidence) -> None:\n    raw, normalized = evidence\n    with pytest.raises(TypeError, match=\"run_id\"):\n        RawFirstDecoder(raw=raw, normalized=normalized, driver=RecordingDriver())\n\n\n@pytest.mark.parametrize(\"failure\", (\"oversized\", \"driver\"))\ndef test_fallback_retains_latest_session_and_supp\n---\ncatchup: run\ndesign: run\ndefault_model: opus\nmodel_tier_rationale: new shared Unicode validation predicate and raw-first failure boundary require semantic continuity across adapters\nledger: deferred/202609062243-deferred.json\nledger_key: 8696acfef4a2\nsource_prd: 00009-codex-adapter-v1.md\nseverity: high\n---\n\n# UTF-8-safe normalized evidence\n\n## Overview\n\n### Problem Statement\nPRD 00009 cycle-2 R7: escaped lone surrogates survive decoding and crash\n`NormalizedEventWriter.write` during strict UTF-8 encoding. The raw-first decoder's\nexception boundary excludes publication, so the supervisor kills a healthy child.\nR2: `bounded_detail` redacts before removing controls and bounding; a reconstructed\ncredential fragment can escape the observation's second sanitizer at the cap.\nSources: [resolved discovery](../../discovery/00001-ovcaq-v1.md),\n[review 00009 cycle 2](../../reviews/00009-codex-adapter-v1-review-2.md), and\n[repair triage](../../autopilot/reports/repair-triage-20261007.md).\nPreserve this PRD's existing ledger metadata.\n\n### Target Users\nThe repository owner supervising fixture/fake and later real agent sessions.\n\n### Success Metrics\nThe named focused tests prove invalid Unicode degrades to `raw.unknown`, later\nvalid frames complete normally, raw bytes remain exact, and synthetic credential\nfragments never enter normalized failure/rate/lane details. No live model calls.\n\n## Functional Decomposition\n\n### Capability: Safe observations\nProvider-neutral validation prevents unserializable strings from entering shared models.\n\n#### Feature: Unicode scalar validation\n- **Description**: Reject decoded strings containing lone UTF-16 surrogate code points.\n- **Inputs**: Observation identifiers, payload values, nested mapping keys and native JSON records.\n- **Outputs**: Valid observations or a bounded normalization gap.\n- **Behavior**: Validate all strings recursively, including keys, before native-record semantic decoding and mutation. An invalid frame produces `raw.unknown` and no session/thread/lane/usage mutation; later frames see the pre-frame adapter state. Direct observation construction rejects invalid strings. Valid escaped surrogate pairs decode to their non-BMP scalar and remain supported. Preserve ordinary valid Unicode and existing malformed/non-JSON fallback behavior. Merely escaping invalid strings with `ensure_ascii=True`, replacing identifiers, or silently dropping characters does not satisfy this contract.\n\n#### Feature: Raw-first continuity\n- **Description**: Retain evidence and continue after an invalid scalar record.\n- **Inputs**: Durable raw byte chunks, a driver and normalized evidence writer.\n- **Outputs**: Exact raw evidence, valid normalized JSONL and later decoded observations.\n- **Behavior**: Preserve existing raw-before-decode ordering, frame bounds, digest/preview bounds and session binding. Reject invalid scalar frames before driver state changes; fallback must itself be UTF-8-safe and redacted. Invalid records must not emit terminal/lane/tool semantics or poison subsequent frames. Genuine raw/normalized writer failures, evidence limits and disk errors still propagate through the existing supervisor failure path; do not catch publication failures as harmless decode gaps.\n\n### Capability: Safe bounded details\nCredential redaction remains effective when terminal controls and caps interact.\n\n#### Feature: Strip, sanitize, bound\n- **Description**: Correct Codex diagnostic detail processing order.\n- **Inputs**: Native failure/rate-limit/lane detail strings with terminal controls.\n- **Outputs**: Sanitized details of at most 4096 characters.\n- **Behavior**: Remove the existing recognized ANSI/control forms, redact credentials from the resulting full string, then bound. Preserve failure classification and reset extraction from full native text. Cover ordinary split tokens and the exact synthetic cap reproducer: `'x'*4080 + ' sk-abc\\x1b[0mdefghijklmnopqrstuvwxyz0123456789ABCDEF'`; normalized output must contain neither the full reconstructed token nor `sk-abcdefghijkl`. Existing short-path whole-token second sanitization already works; this PRD does not claim a real credential exposure.\n\n## Structural Decomposition\n\n### Repository Structure\n\n```text\nsrc/ovcaq/\n  events/model.py                # scalar-safe observations and JSON values\n  events/tail.py                 # raw-first frame rejection and continuation\n  drivers/codex_events.py        # strip/sanitize/bound detail order\ntests/\n  events/test_unicode_safety.py  # new shared-model and raw-first regressions\n  drivers/test_codex_detail_safety.py # new actual detail/payload regressions\n  runtime/test_unicode_continuity.py # new real-subprocess supervisor proof\n  events/test_tail.py            # existing writer-failure preservation coverage\ndocs/driver-protocol.md          # normalization safety contract\nCHANGELOG.md                    # fixed behavior\n```\n\n### Module: events\n- **Maps to capability**: Safe observations\n- **Responsibility**: Validate strings and reject unsafe records without publishing semantic observations or losing durable evidence.\n- **Exports**: Existing `Observation`, `sanitize_json`, `observation_record`, `RawFirstDecoder` and `NormalizedEventWriter`; no new public command or provider-specific shared branch.\n\n### Module: diagnostic details\n- **Maps to capability**: Safe bounded details\n- **Responsibility**: Correct bounded diagnostic sanitization at the provider edge.\n- **Exports**: Existing `bounded_detail`; adapter classification/reset contracts unchanged.\n\n### Module: continuity evidence\n- **Maps to capability**: Safe observations and Safe bounded details\n- **Responsibility**: Headless actual-pipeline regressions, real subprocess continuity and accurate protocol documentation.\n- **Exports**: Named focused pytest files and documented behavior; no production modules.\n\n## Dependency Graph\n\n### Foundation Layer (Phase 0)\n- **events validation**: No dependencies; establishes Unicode scalar acceptance and nested-string rejection.\n\n### Core Layer (Phase 1)\n- **raw-first events**: Depends on [events validation]; rejects native invalid scalars before decoding/mutation.\n- **diagnostic details**: Depends on [events validation]; produces valid redacted bounded detail payloads.\n\n### Integration Layer (Phase 2)\n- **continuity evidence**: Depends on [raw-first events, diagnostic details, existing supervisor/fake harness]; proves real-process continuation and documents the contract.\n\n## Implementation Phases\n\n### Phase 0: Foundation\n**Goal**: Establish safe string validation without changing valid observation semantics.\n\n**Tasks**:\n- [ ] Implement shared scalar validation and direct observation regressions (no deps) - Acceptance: Re-check that direct observations accept invalid scalars before editing; if already fixed, skip production edits and report while retaining independent tests. `mise exec -- uv run pytest tests/events/test_unicode_safety.py -k scalar` passes; cases cover lone high/low surrogates in identifiers, values and nested keys, ordinary Unicode and valid escaped pairs, with explicit rejected/accepted assertions.\n\n**Exit Criteria**: Invalid scalars cannot inhabit normalized observation identifiers or payloads.\n\n### Phase 1: Core\n**Goal**: Recover malformed native frames before mutation and close the credential-cap gap.\n\n**Tasks**:\n- [ ] Integrate pre-decode invalid-scalar rejection and safe raw fallback (depends on: Phase 0) - Acceptance: Re-check R7 before edits; if already safely recovered without adapter mutation, skip production edits and report while retaining independent tests. `mise exec -- uv run pytest tests/events/test_unicode_safety.py tests/events/test_tail.py` passes; byte-exact raw, gap digest/preview, unchanged adapter identity/usage and later healthy terminal are asserted; existing genuine writer failures still raise.\n- [ ] Correct strip/sanitize/bound ordering with real failure/rate/lane payload regressions (depends on: Phase 0) - Acceptance: Re-check the exact R2 cap reproducer before edits; if already redacted, skip production edits and report while retaining independent tests. `mise exec -- uv run pytest tests/drivers/test_codex_detail_safety.py tests/drivers/test_codex_decode_terminals.py` passes; the exact cap reproducer and ANSI/NUL splits redact before truncation, preserve limits, and do not change failure class/reset semantics.\n\n**Exit Criteria**: Unsafe records yield only normalization gaps; synthetic secrets and fragments are absent from bounded normalized details.\n\n### Phase 2: Integration\n**Goal**: Prove supervised child continuity and record the final operator contract.\n\n**Tasks**:\n- [ ] Add actual subprocess supervisor continuity tests and update protocol/changelog (depends on: Phase 1) - Acceptance: `mise exec -- uv run pytest tests/runtime/test_unicode_continuity.py` passes; a temporary fake child emits unsafe native records, later valid identity/usage and terminal evidence, remains alive until its normal exit, and leaves exact raw plus reloadable normalized evidence; a forced genuine normalized writer failure still aborts through the established runtime path. Re-check that R7/R2 premises remain before edits; if already fixed, retain independent regression coverage and report rather than force churn.\n\n**Exit Criteria**: Focused acceptance passes, then final project gates pass once: `mise exec -- uv sync --all-groups`, `mise exec -- uv run pytest`, `mise exec -- uv run ruff check .`, `mise exec -- uv run ruff format --check .`, `mise exec -- uv run mypy src/ovcaq`, `mise exec -- uv build`.\n\n## Test Strategy\n\n### Critical Scenarios\n- **Happy path**: Valid Unicode, escaped surrogate pairs and ordinary native JSON → unchanged supported semantic observations and normal completion.\n- **Edge case**: Invalid scalar thread/lane ID, agent/error text or nested key → one bounded raw gap, no semantic or adapter mutation, exact raw bytes and later valid completion.\n- **Edge case**: ANSI/NUL-split synthetic credential crossing detail cap → complete redaction before bounding in actual failure/rate/lane payloads.\n- **Error case**: Raw/normalized I/O failure or evidence exhaustion → existing failure propagation, never swallowed as malformed input.\n\n## Risks\n\n- **State contamination**: Reject invalid native strings before invoking stateful decoding; assert pre/post identity and usage with subsequent frames.\n- **Weakened storage errors**: Limit tolerant handling to validation/decoding; retain existing writer-failure tests and add supervised failure evidence.\n- **Scope expansion**: No version-pin refresh, model routing, lane status, retry policy, activity UI, provider-default naming or probe ownership changes; those have separate dispositions.\n\n","exit_code":0,"status":"completed"}}
