d_scalars(\n257\t    original: str, scalar: str\n258\t) -> None:\n259\t    valid = make_observation(payload={\"message\": [\"marker\", {\"nested\": \"valid\"}]})\n260\t    record = replace_record_string(observation_record(valid), original, scalar)\n261\t    decoded_record = invalid_native_record(record, scalar)\n262\t\n263\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n264\t        observation_from_record(decoded_record)\n265\t\n266\t\n267\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n268\tdef test_usage_observation_rejects_invalid_scalar_identity(scalar: str) -> None:\n269\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n270\t        make_observation(\n271\t            type=ObservationType.USAGE_UPDATED,\n272\t            payload={\"usage\": USAGE_DATA, \"identity\": f\"request-{scalar}\"},\n273\t        )\n274\t\n275\t\n276\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n277\tdef test_usage_record_decoder_rejects_invalid_scalar_identity(scalar: str) -> None:\n278\t    valid = make_observation(\n279\t        type=ObservationType.USAGE_UPDATED,\n280\t        payload={\"usage\": USAGE_DATA, \"identity\": \"request-1\"},\n281\t    )\n282\t    record = observation_record(valid)\n283\t    record[\"payload\"] = {\"usage\": USAGE_DATA, \"identity\": f\"request-{scalar}\"}\n284\t    decoded_record = invalid_native_record(record, scalar)\n285\t\n286\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n287\t        observation_from_record(decoded_record)\n288\t\n289\t\n290\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n291\t@pytest.mark.parametrize(\"location\", [\"secret_value\", \"secret_key\"])\n292\tdef test_record_decoder_rejects_invalid_scalar_before_secret_redaction(\n293\t    scalar: str,\n294\t    location: str,\n295\t) -> None:\n296\t    record = observation_record(make_observation())\n297\t    secret = (\n298\t        {\"password\": scalar}\n299\t        if location == \"secret_value\"\n300\t        else {f\"password{scalar}\": \"valid\"}\n301\t    )\n302\t    record[\"payload\"] = {\"message\": \"valid\", **secret}\n303\t    decoded_record = invalid_native_record(record, scalar)\n304\t\n305\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n306\t        observation_from_record(decoded_record)\n307\t\n308\t\n309\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n310\t@pytest.mark.parametrize(\"location\", [\"value\", \"nested_key\", \"secret\"])\n311\tdef test_completion_observation_rejects_invalid_scalars_before_redaction(\n312\t    location: str, scalar: str\n313\t) -> None:\n314\t    additions = {\n315\t        \"value\": {\"extra\": {\"nested\": scalar}},\n316\t        \"nested_key\": {\"extra\": {scalar: \"valid\"}},\n317\t        \"secret\": {\"password\": scalar},\n318\t    }\n319\t    payload = {\"usage\": USAGE_DATA, \"message\": \"done\", **additions[location]}\n320\t\n321\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n322\t        make_observation(type=ObservationType.SESSION_COMPLETED, payload=payload)\n323\t\n324\t\n325\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n326\t@pytest.mark.parametrize(\"location\", [\"value\", \"nested_key\", \"secret\"])\n327\tdef test_completion_record_decoder_rejects_invalid_scalars_before_redaction(\n328\t    location: str, scalar: str\n329\t) -> None:\n330\t    valid = make_observation(\n331\t        type=ObservationType.SESSION_COMPLETED,\n332\t        payload={\"usage\": USAGE_DATA, \"message\": \"done\"},\n333\t    )\n334\t    additions = {\n335\t        \"value\": {\"extra\": {\"nested\": scalar}},\n336\t        \"nested_key\": {\"extra\": {scalar: \"valid\"}},\n337\t        \"secret\": {\"password\": scalar},\n338\t    }\n339\t    record = observation_record(valid)\n340\t    record[\"payload\"] = {\"usage\": USAGE_DATA, \"message\": \"done\", **additions[location]}\n341\t    decoded_record = invalid_native_record(record, scalar)\n342\t\n343\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n344\t        observation_from_record(decoded_record)\n345\t\n346\t\n347\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n348\t@pytest.mark.parametrize(\"event_type\", list(ObservationType))\n349\t@pytest.mark.parametrize(\"location\", [\"value\", \"key\"])\n350\tdef test_every_observation_type_rejects_invalid_scalar_payloads(\n351\t    event_type: ObservationType, location: str, scalar: str\n352\t) -> None:\n353\t    valid_payload = payload_for_type(event_type)\n354\t    valid = make_observation(type=event_type, payload=valid_payload)\n355\t    valid_record = observation_record(valid)\n356\t    assert observation_from_record(valid_record) == valid\n357\t    assert valid_record[\"payload\"] == valid_payload\n358\t    if location == \"value\":\n359\t        payload = replace_record_string(valid_payload, \"valid\", scalar)\n360\t    else:\n361\t        key = next(iter(valid_payload))\n362\t        payload = {\n363\t            f\"{key}{scalar}\" if name == key else name: value\n364\t            for name, value in valid_payload.items()\n365\t        }\n366\t\n367\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n368\t        make_observation(type=event_type, payload=payload)\n369\t    valid_record[\"payload\"] = payload\n370\t    decoded = invalid_native_record(valid_record, scalar)\n371\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n372\t        observation_from_record(decoded)\n373\t\n374\t\n375\t@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n376\t@pytest.mark.parametrize(\n377\t    \"interface\",\n378\t    [\n379\t        \"root\",\n380\t        \"value\",\n381\t        \"key\",\n382\t        \"secret_key\",\n383\t        \"provider\",\n384\t        \"run_id\",\n385\t        \"session_id\",\n386\t        \"lane_id\",\n387\t        \"summary_session_id\",\n388\t        \"failure_detail\",\n389\t        \"payload_value\",\n390\t        \"payload_key\",\n391\t    ],\n392\t)\n393\tdef test_text_subclasses_reject_invalid_scalars(interface: str, scalar: str) -> None:\n394\t    text = ScalarText(scalar)\n395\t    values = {\n396\t        \"root\": text,\n397\t        \"value\": {\"value\": text},\n398\t        \"key\": {text: \"valid\"},\n399\t        \"secret_key\": {ScalarText(f\"password{scalar}\"): \"valid\"},\n400\t    }\n401\t    with pytest.raises(ValueError, match=SCALAR_ERROR):\n402\t        if interface in values:\n403\t            sanitize_json(values[interface])\n404\t        elif interface == \"summary_session_id\":\n405\t            make_summary(session_id=text)\n406\t        elif interface == \"failure_detail\":\n407\t            make_summary(failure_detail=text)\n408\t        elif interface == \"payload_value\":\n409\t            make_observation(payload={\"message\": text})\n410\t        elif interface == \"payload_key\":\n411\t            make_observation(payload={\"message\": {text: \"valid\"}})\n412\t        else:\n413\t            make_observation(**{interface: text})\n414\t\n415\t\n416\t@pytest.mark.parametrize(\"text\", [text for text in VALID_SCALARS if text])\n417\t@pytest.mark.parametrize(\n418\t    \"event_type\", [ObservationType.USAGE_UPDATED, ObservationType.SESSION_COMPLETED]\n419\t)\n420\tdef test_usage_and_completion_preserve_valid_unicode_scalars(\n421\t    event_type: ObservationType, text: str\n422\t) -> None:\n423\t    payload = (\n424\t        {\"usage\": USAGE_DATA, \"identity\": text}\n425\t        if event_type is ObservationType.USAGE_UPDATED\n426\t        else {\"usage\": USAGE_DATA, \"message\": text, \"extra\": {text: text}}\n427\t    )\n428\t    observation = make_observation(type=event_type, payload=payload)\n429\t    record = observation_record(observation)\n430\t    restored = observation_from_record(\n431\t        json.loads(json.dumps(record, ensure_ascii=True))\n432\t    )\n433\t\n434\t    assert record[\"payload\"] == payload\n435\t    assert restored.type is event_type\n436\t    assert observation_record(restored)[\"payload\"] == payload\n437\t\n438\t\n439\t@pytest.mark.parametrize(\"text\", VALID_SCALARS)\n440\tdef test_shared_models_and_serializers_preserve_valid_unicode_scalars(\n441\t    text: str,\n442\t) -> None:\n443\t    payload = {\"message\": [text, {text: text}, None]}\n444\t    observation = make_observation(\n445\t        provider=text or \"test-driver\",\n446\t        run_id=text or \"run-1\",\n447\t        session_id=text or None,\n448\t        lane_id=text or None,\n449\t        payload=payload,\n450\t    )\n451\t    summary = make_summary(session_id=text or None, failure_detail=text)\n452\t\n453\t    assert sanitize_json(payload) == payload\n454\t    assert sanitize_json(None) is None\n455\t    assert sanitize_json(text) == text\n456\t    record = observation_record(observation)\n457\t    assert record[\"payload\"] == payload\n458\t    for field in (\"provider\", \"run_id\", \"session_id\", \"lane_id\"):\n459\t        assert record[field] == getattr(observation, field)\n460\t    restored = observation_from_record(\n461\t        json.loads(json.dumps(record, ensure_ascii=False))\n462\t    )\n463\t    assert observation_record(restored)[\"payload\"] == payload\n464\t    assert restored.session_id == observation.session_id\n465\t    assert restored == observation\n466\t    assert summary.failure_detail == text\n467\t    assert summary_record(summary)[\"session_id\"] == (text or None)\n468\t    assert summary_record(summary)[\"failure_detail\"] == text\n469\t    assert_scalar_json(record)\n470\t    assert_scalar_json(summary_record(summary))\n471\t\n472\t\n473\tdef test_valid_escaped_surrogate_pair_decodes_to_supported_scalar() -> None:\n474\t    scalar = json.loads(r'\"\\ud83d\\ude80\"')\n475\t    assert scalar == \"\\U0001f680\"\n476\t    observation = make_observation(\n477\t        provider=scalar,\n478\t        run_id=scalar,\n479\t        session_id=scalar,\n480\t        lane_id=scalar,\n481\t        payload={\"message\": [scalar, {scalar: scalar}]},\n482\t    )\n483\t    summary = make_summary(session_id=scalar, failure_detail=scalar)\n484\t\n485\t    assert sanitize_json({scalar: scalar}) == {scalar: scalar}\n486\t    record = observation_record(observation)\n487\t    restored = observation_from_record(\n488\t        json.loads(json.dumps(record, ensure_ascii=True))\n489\t    )\n490\t    assert restored == observation\n491\t    assert restored.provider == scalar\n492\t    assert observation_record(restored)[\"payload\"] == {\n493\t        \"message\": [scalar, {scalar: scalar}]\n494\t    }\n495\t    assert summary.session_id == scalar\n496\t    assert summary.failure_detail == scalar\n497\t    assert summary_record(summary)[\"session_id\"] == scalar\n498\t    assert summary_record(summary)[\"failure_detail\"] == scalar\n499\t    assert_scalar_json(record)\n500\t    assert_scalar_json(summary_record(summary))\n501\t"}]},"parent_tool_use_id":null,"session_id":"1a3c0b3f-796d-46ef-a146-a96b9508aedd","uuid":"9abdad43-dfa2-4c3c-816b-a226f77b0e29","timestamp":"2026-10-10T09:17:17.973Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/bob/git/src/github.com/buvis/ovcaq/tests/events/test_unicode_safety.py","content":"\"\"\"Unicode scalar contracts for shared observations, independent of drivers.\"\"\"\n\nimport json\nfrom datetime import UTC, datetime\nfrom typing import Any\n\nimport pytest\n\nfrom ovcaq.events import (\n    FailureClass,\n    Observation,\n    ObservationType,\n    SessionSummary,\n    observation_from_record,\n    observation_record,\n    sanitize_json,\n    summary_record,\n)\n\nNOW = datetime(2026, 9, 26, 12, 30, 15, 123456, tzinfo=UTC)\nINVALID_SCALARS = (\n    \"\\ud800\",\n    \"\\ud801\",\n    \"\\udbff\",\n    \"\\udc00\",\n    \"\\udc01\",\n    \"\\udfff\",\n    \"\\ud83d\\ude80\",\n)\nSCALAR_IDS = [\n    \"high-start\",\n    \"high-interior\",\n    \"high-end\",\n    \"low-start\",\n    \"low-interior\",\n    \"low-end\",\n    \"uncombined-pair\",\n]\nVALID_SCALARS = (\n    \"\",\n    \"Žluťoučký 日本語\",\n    \"é\",\n    \"العربية हिन्दी 한국어\",\n    \"e\\u0301\",\n    \"\\x00\\t\\n\\x1f\\x7f\",\n    \"\\ud7ff\\ue000\",\n    \"\\U00010000\\U0010ffff\",\n    \"\\U0001f680\",\n)\nSCALAR_ERROR = r\"^Strings must contain only Unicode scalar values$\"\nUSAGE_DATA = {\n    \"input_tokens\": 1,\n    \"output_tokens\": 2,\n    \"cache_creation_input_tokens\": None,\n    \"cache_read_input_tokens\": None,\n    \"tool_uses\": None,\n    \"cost_usd\": None,\n    \"estimated\": False,\n}\n\n\ndef make_observation(**changes: Any) -> Observation:\n    fields = {\n        \"protocol_version\": 1,\n        \"timestamp\": NOW,\n        \"provider\": \"test-driver\",\n        \"run_id\": \"run-1\",\n        \"session_id\": \"session-1\",\n        \"lane_id\": \"lane-1\",\n        \"type\": ObservationType.ACTIVITY_MESSAGE,\n        \"payload\": {\"message\": \"working\"},\n    }\n    fields.update(changes)\n    return Observation(**fields)\n\n\ndef make_summary(**changes: Any) -> SessionSummary:\n    fields = {\n        \"success\": False,\n        \"session_id\": \"session-1\",\n        \"failure_class\": FailureClass.AGENT,\n        \"failure_detail\": \"request failed\",\n        \"rate_limit_reset_at\": None,\n        \"usage\": None,\n    }\n    fields.update(changes)\n    return SessionSummary(**fields)\n\n\ndef assert_scalar_json(value: object) -> None:\n    if isinstance(value, dict):\n        for key, child in value.items():\n            key.encode(\"utf-8\", errors=\"strict\")\n            assert_scalar_json(child)\n    elif isinstance(value, list):\n        for child in value:\n            assert_scalar_json(child)\n    elif isinstance(value, str):\n        value.encode(\"utf-8\", errors=\"strict\")\n\n\ndef replace_record_string(value: Any, original: str, replacement: str) -> Any:\n    if isinstance(value, dict):\n        return {\n            replacement if key == original else key: replace_record_string(\n                child, original, replacement\n            )\n            for key, child in value.items()\n        }\n    if isinstance(value, list):\n        return [replace_record_string(child, original, replacement) for child in value]\n    return replacement if value == original else value\n\n\ndef positioned_scalar(scalar: str, position: str) -> str:\n    if position == \"middle\":\n        return f\"prefix{scalar}suffix\"\n    if position == \"long_prefix\":\n        return f\"{'a' * 96}{scalar}suffix\"\n    return scalar\n\n\ndef invalid_native_record(record: dict[str, Any], scalar: str) -> dict[str, Any]:\n    # JSON decoding combines adjacent high/low escapes into a valid scalar.\n    # A caller-supplied Python record still must reject uncombined code units.\n    if scalar == \"\\ud83d\\ude80\":\n        return record\n    return json.loads(json.dumps(record, ensure_ascii=True))\n\n\ndef nested_json(value: Any, depth: int) -> Any:\n    for index in range(depth):\n        if index % 3 == 0:\n            value = {\"nested\": value}\n        elif index % 3 == 1:\n            value = [value]\n        else:\n            value = (value,)\n    return value\n\n\ndef payload_for_type(event_type: ObservationType) -> dict[str, Any]:\n    if event_type is ObservationType.USAGE_UPDATED:\n        return {\"usage\": USAGE_DATA, \"identity\": \"valid\"}\n    if event_type is ObservationType.SESSION_COMPLETED:\n        return {\"usage\": USAGE_DATA, \"message\": \"valid\"}\n    if event_type is ObservationType.SESSION_FAILED:\n        return {\"failure_class\": FailureClass.AGENT.value, \"detail\": \"valid\"}\n    if event_type is ObservationType.RATE_LIMIT_STARTED:\n        return {\"reset_at\": None, \"window\": None, \"detail\": \"valid\"}\n    if event_type is ObservationType.RAW_UNKNOWN:\n        return {\"reason\": \"valid\", \"raw_sha256\": \"0\" * 64, \"preview\": \"valid\"}\n    return {\"message\": \"valid\"}\n\n\nclass ScalarText(str):\n    \"\"\"An ordinary string subclass accepted by the public text interfaces.\"\"\"\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n@pytest.mark.parametrize(\"field\", [\"provider\", \"run_id\", \"session_id\", \"lane_id\"])\n@pytest.mark.parametrize(\"position\", [\"start\", \"middle\", \"long_prefix\"])\ndef test_observation_rejects_invalid_scalar_identifiers(\n    field: str, scalar: str, position: str\n) -> None:\n    with pytest.raises(ValueError, match=SCALAR_ERROR):\n        make_observation(**{field: positioned_scalar(scalar, position)})\n\n\n@pytest.mark.parametrize(\"scalar\", INVALID_SCALARS, ids=SCALAR_IDS)\n@pytest.mark.parametrize(\n    \"location\",\n    [\n        \"value\",\n        \"nested_value\",\n        \"nested_key\",\n        \"tuple\",\n        \"tuple_key\",\n        \"secret\",\n        \"secret_key\",\n        \"deep_value\",\n        \"deep_key\",\n    ],\n)\n@pytest.mark.parametrize(\"position\", [\"start\", \"middle\", \"long_prefix\"])\ndef test_observation_rejects_invalid_scalars_recursively_in_payload(\n    location: str, scalar: str, position: str\n) -> None:\n    scalar = positioned_scalar(scalar, position)\n    payloads = {\n        \"value\": {\"message\": scalar},\n        \"nested_value\": {\"message\": [\"valid\", {\"nested\": scalar}]},\n        \"nested_key\": {\"message\": [\"valid\", {scalar: \"valid\"}]},\n        \"tuple\": {\"message\": (\"valid\", {\"nested\": scalar})},\n        \"tuple_key\": {\"message\": (\"valid\", {scalar: \"valid\"})},\n        \"secret\": {\"message\": \"valid\", \"password\": scalar},\n        \"secret_key\": {\"message\": \"valid\", f\"password{scalar}\": \"valid\"},\n        \"deep_value\": {\"message\": nested_json(scalar, 12)},\n        \"deep_key\": {\"message\": nested_json({scalar: \"valid\"}, 12)},\n    }\n    with pytest.raises(ValueError, match=SCALAR_ERROR):\n        make_observation(payload=payloads[location])\n\n\n@pytest.mark.parametrize(\"