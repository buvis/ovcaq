"X-Secret: another-value\", \"X-Secret: [REDACTED]\"),\n    (\"PASSWORD=Z8n4p2\", \"PASSWORD=[REDACTED]\"),\n    (\"api_key: key-73_B\", \"api_key: [REDACTED]\"),\n    (\"cookie=session-29\", \"cookie=[REDACTED]\"),\n    (\"client_credential: c6D_8f\", \"client_credential: [REDACTED]\"),\n]\n\n\ndef make_observation(**changes):\n    fields = {\n        \"protocol_version\": 1,\n        \"timestamp\": NOW,\n        \"provider\": \"test-driver\",\n        \"run_id\": \"run-1\",\n        \"session_id\": \"session-1\",\n        \"lane_id\": \"lane-1\",\n        \"type\": ObservationType(\"activity.message\"),\n        \"payload\": {\"message\": \"working\"},\n    }\n    fields.update(changes)\n    return Observation(**fields)\n\n\ndef make_summary(**changes):\n    fields = {\n        \"success\": False,\n        \"session_id\": \"session-1\",\n        \"failure_class\": FailureClass(\"agent\"),\n        \"failure_detail\": \"request failed\",\n        \"rate_limit_reset_at\": None,\n        \"usage\": None,\n    }\n    fields.update(changes)\n    return SessionSummary(**fields)\n\n\ndef assert_ordinary_json(value):\n    if type(value) is dict:\n        assert all(type(key) is str for key in value)\n        for child in value.values():\n            assert_ordinary_json(child)\n    elif type(value) is list:\n        for child in value:\n            assert_ordinary_json(child)\n    else:\n        assert type(value) in (str, int, float, bool, type(None))\n\n\ndef test_protocol_and_enums_expose_exact_version_one_values():\n    assert type(PROTOCOL_VERSION) is int\n    assert PROTOCOL_VERSION == 1\n    assert issubclass(ObservationType, StrEnum)\n    assert issubclass(FailureClass, StrEnum)\n    assert {member.value for member in ObservationType} == {\n        \"session.started\",\n        \"activity.message\",\n        \"tool.started\",\n        \"tool.completed\",\n        \"tool.failed\",\n        \"lane.started\",\n        \"lane.progress\",\n        \"lane.completed\",\n        \"lane.failed\",\n        \"usage.updated\",\n        \"rate_limit.started\",\n        \"rate_limit.cleared\",\n        \"session.completed\",\n        \"session.failed\",\n        \"raw.unknown\",\n    }\n    assert {member.value for member in FailureClass} == {\n        \"rate_limit\",\n        \"connectivity\",\n        \"permission\",\n        \"authentication\",\n        \"tim\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n[project]\nname = \"ovcaq\"\nversion = \"0.1.0.dev0\"\ndescription = \"Orchestration, Visibility, and Control for Agent Queues\"\nreadme = \"README.md\"\nlicense = \"MIT\"\nlicense-files = [\"LICENSE\"]\nrequires-python = \">=3.12\"\ndependencies = [\n    \"rich\",\n    \"textual\",\n]\n\n[project.scripts]\novcaq = \"ovcaq.cli:main\"\n\n[dependency-groups]\ndev = [\n    \"hatchling\",\n    \"mypy\",\n    \"packaging\",\n    \"pytest\",\n    \"ruff\",\n]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\n    \"/CHANGELOG.md\",\n    \"/LICENSE\",\n    \"/README.md\",\n    \"/docs\",\n    \"/pyproject.toml\",\n    \"/src/ovcaq\",\n    \"/tests\",\n    \"/uv.lock\",\n]\nexclude = [\n    \"/.cache\",\n    \"/.git\",\n    \"/.github\",\n    \"/.hg\",\n    \"/.mypy_cache\",\n    \"/.pytest_cache\",\n    \"/.ruff_cache\",\n    \"/.svn\",\n    \"/.tox\",\n    \"/.venv\",\n    \"/build\",\n    \"/dist\",\n    \"/docs/dev\",\n    \"**/__pycache__\",\n    \"**/*.py[co]\",\n]\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/ovcaq\"]\n\n[tool.pytest.ini_options]\naddopts = [\"--import-mode=importlib\"]\npythonpath = [\"tests/packaging\", \"tests/state\", \"tests/workflow\"]\n\n[tool.ruff]\ntarget-version = \"py312\"\nsrc = [\"src\"]\nextend-exclude = [\"docs/dev/project-management\"]\n\n[tool.mypy]\npython_version = \"3.12\"\nstrict = true\nfiles = [\"src/ovcaq\"]\n\n# Project Capsule: OVCAQ\n\nGenerated: 2026-10-09T19:25:49Z\nCatchup HEAD: `e4d765c42d1be7b42c27312e8a5f474d61178b52` (`master`)\n\n## Key Invariants\n\n- `StateStore.transaction()` is the only durable `state.json` writer; commands and later workflow/runtime services share it.\n- State plus a normalized session result decides lifecycle progress. Agent prose and observational logs never do.\n- The clean v1 state is a one-way cutover: no legacy importer, dual writer, compatibility shim, or permanent `autoclaude`/`autopilot`/`tracon`/`statectl` aliases.\n- Provider-specific argv, environment, event, model, and rate-limit logic remains at driver edges; provider-neutral state/runtime/TUI modules must not parse native events.\n- Raw session evidence survives normalization, and configured commands are always argv arrays spawned without shell evaluation.\n- PRD sequencing follows `docs/dev/project-management/plans/implementation-plan.md`: state first, then workflow, runtime, adapters, TUI, and provisioning.\n\n## Architecture Decisions\n\n- OVCAQ is one Python 3.12+ installable package with an `ovcaq` console command and a small runtime dependency set (Rich/Textual plus stdlib-first internals).\n- State, workflow, runtime, events, both native adapters, supervisor, and TUI are implemented through PRD 00009. Codex includes native decoding, cumulative usage, lane/tool projection, state-only default prompts and fake-supervisor conformance. Provisioning and real launcher/plugin smoke remain later-phase work.\n- State v1 groups ownership under `batch`, `work`, `tasks`, `review`, `control`, and `recovery`,\n","exit_code":0,"status":"completed"}}
