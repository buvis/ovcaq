+{"type":"item.completed","item":{"id":"item_112","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c 'from pathlib import Path; print(Path(\\\"tests/runtime/test_supervisor_process.py\\\").read_text()[:14500]); print(Path(\\\"tests/runtime/test_supervisor_adapters.py\\\").read_text()[:15000])'\"","aggregated_output":"from __future__ import annotations\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom collections.abc import Callable, Iterable\nfrom dataclasses import dataclass, field\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport pytest\n\nfrom ovcaq.config import (\n    AgentSettings,\n    PhaseSettings,\n    RuntimeSettings,\n    SupervisorSettings,\n)\nfrom ovcaq.drivers.base import LaunchRequest, LaunchSpec\nfrom ovcaq.drivers.claude import ClaudeDriver\nfrom ovcaq.drivers.codex import CodexDriver\nfrom ovcaq.events.model import Observation, SessionSummary\nfrom ovcaq.paths import RuntimePaths, ensure_runtime_layout, resolve_runtime_paths\nfrom ovcaq.runtime.decision import DecisionKind, SupervisorPolicy\nfrom ovcaq.runtime.registry import (\n    DuplicateRunError,\n    FleetRegistry,\n    ProcessIdentity,\n    RunLock,\n    process_identity,\n    process_matches,\n)\nfrom ovcaq.runtime.session import reconcile_metrics\nfrom ovcaq.runtime.supervisor import Supervisor\nfrom ovcaq.state.schema import new_state\nfrom ovcaq.state.store import StateStore\n\n\n@dataclass\nclass Step:\n    code: str\n\n\n@dataclass\nclass ProcessDriver:\n    name: str = \"claude\"\n    environment: dict[str, str] = field(default_factory=dict)\n    adapter: ClaudeDriver | CodexDriver | None = None\n    steps: list[Step] = field(default_factory=list)\n    requests: list[LaunchRequest] = field(default_factory=list)\n    on_line: Callable[[str], None] | None = None\n\n    def default_prompt(self, phase: str) -> str:\n        assert self.adapter is not None\n        return self.adapter.default_prompt(phase)\n\n    def probe(self) -> object:\n        raise AssertionError(\"a configured process fixture needs no network probe\")\n\n    def build_launch(self, request: LaunchRequest) -> LaunchSpec:\n        assert len(self.requests) < len(self.steps), \"unexpected extra launch\"\n        code = self.steps[len(self.requests)].code\n        self.requests.append(request)\n        driver_type = ClaudeDriver if self.name == \"claude\" else CodexDriver\n        self.adapter = driver_type(\n            AgentSettings(\n                name=self.name,\n                command=(sys.executable, \"-c\", code),\n                tiers={\n                    \"sonnet\": \"model-s\",\n                    \"opus\": \"model-o\",\n                    \"model-s\": \"model-s\",\n                    \"model-o\": \"model-o\",\n                },\n                environment=self.environment,\n                options={\"permission_mode\": \"auto\"} if self.name == \"claude\" else {},\n            ),\n            run_id=\"process-conformance\",\n        )\n        return self.adapter.build_launch(request)\n\n    def decode(self, raw_line: str) -> Iterable[Observation]:\n        if self.on_line is not None:\n            self.on_line(raw_line)\n        assert self.adapter is not None\n        return self.adapter.decode(raw_line)\n\n    def summarize(\n        self, observations: Iterable[Observation], exit_code: int\n    ) -> SessionSummary:\n        assert self.adapter is not None\n        return self.adapter.summarize(observations, exit_code)\n\n\nclass ProcessClock:\n    def now(self) -> datetime:\n        return datetime.now(UTC)\n\n    def monotonic(self) -> float:\n        return time.monotonic()\n\n    def wait(self, event: threading.Event, timeout: float) -> bool:\n        return event.wait(timeout)\n\n\n@dataclass\nclass Harness:\n    root: Path\n    paths: RuntimePaths\n    store: StateStore\n    driver: ProcessDriver\n    settings: SupervisorSettings\n\n    def supervisor(self) -> Supervisor:\n        def unexpected_capability(entry: object) -> object:\n            raise AssertionError(\"process fixture has no capabilities\")\n\n        return Supervisor(\n            self.root,\n            store=self.store,\n            driver=self.driver,\n            settings=self.settings,\n            capability_runner=unexpected_capability,\n            clock=ProcessClock(),\n            sleeper=time.sleep,\n        )\n\n\ndef process_driver(tmp_path: Path, adapter: str) -> ProcessDriver:\n    return ProcessDriver(\n        name=adapter,\n        environment={\n            \"HOME\": str(tmp_path / \"home\"),\n            \"XDG_CONFIG_HOME\": str(tmp_path / \"user-config\"),\n            \"XDG_STATE_HOME\": str(tmp_path / \"state-home\"),\n        },\n        adapter=(ClaudeDriver if adapter == \"claude\" else CodexDriver)(\n            AgentSettings(\n                name=adapter,\n                command=(sys.executable,),\n                tiers={},\n                environment={},\n                options={\"permission_mode\": \"auto\"} if adapter == \"claude\" else {},\n            ),\n            run_id=\"process-conformance\",\n        ),\n    )\n\n\ndef harness(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, adapter: str) -> Harness:\n    monkeypatch.setenv(\"XDG_CONFIG_HOME\", str(tmp_path / \"user-config\"))\n    root = tmp_path / \"repo\"\n    root.mkdir()\n    (root / \"ovcaq.toml\").write_text(\n        f'agent = \"{adapter}\"\\n[agents.{adapter}]\\ncommand = [\"runner\"]\\n'\n        'tiers = { sonnet = \"model-s\", opus = \"model-o\" }\\n'\n        \"[phases.build]\\ntimeout_seconds = 3\\n\"\n    )\n    paths = ensure_runtime_layout(\n        resolve_runtime_paths(\n            root, runtime_root=root / \"runtime\", xdg_state_home=tmp_path / \"state-home\"\n        )\n    )\n    store = StateStore(paths.state_file)\n    state = new_state(repo_root=root)\n    state[\"batch\"].update(id=\"batch-1\", status=\"running\")\n    state[\"work\"].update(phase=\"build\", next_phase=\"build\")\n    store.initialize(state)\n    settings = SupervisorSettings(\n        RuntimeSettings(paths, 0.05, 1_000_000, 10_000_000, 0),\n        SupervisorPolicy(1, 2, 2, 0.25, 5.0, 3),\n        {\n            phase: PhaseSettings(tier, \"high\", 3)\n            for phase, tier in (\n                (\"build\", \"sonnet\"),\n                (\"review\", \"opus\"),\n                (\"done\", \"sonnet\"),\n            )\n        },\n    )\n    return Harness(\n        root,\n        paths,\n        store,\n        process_driver(tmp_path, adapter),\n        settings,\n    )\n\n\n@pytest.fixture(params=[\"claude\", \"codex\"])\ndef adapter(request: pytest.FixtureRequest) -> str:\n    return request.param\n\n\n@pytest.fixture(autouse=True)\ndef unrelated_process(tmp_path: Path):\n    sentinel = subprocess.Popen(\n        [sys.executable, \"-c\", \"import time; time.sleep(60)\"],\n        stdin=subprocess.DEVNULL,\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n        start_new_session=True,\n        env={\"HOME\": str(tmp_path / \"sentinel-home\")},\n    )\n    try:\n        yield sentinel\n        assert sentinel.poll() is None\n    finally:\n        sentinel.terminate()\n        sentinel.wait(timeout=5)\n\n\ndef rows(path: Path) -> list[dict[str, object]]:\n    return [json.loads(line) for line in path.read_text().splitlines()]\n\n\nGROUP_CODE = \"\"\"\nimport json, os, signal, time\nsignal.signal(signal.SIGTERM, signal.SIG_IGN)\nchild = os.fork()\nif child == 0:\n    time.sleep(15)\n    os._exit(0)\nprint(json.dumps({'parent': os.getpid(), 'child': child}), flush=True)\ntime.sleep(15)\n\"\"\"\n\n\ndef stopped(pid: int) -> bool:\n    result = subprocess.run(\n        [\"ps\", \"-o\", \"stat=\", \"-p\", str(pid)],\n        capture_output=True,\n        check=False,\n        timeout=2,\n    )\n    assert result.returncode in (0, 1)\n    return not result.stdout.strip() or result.stdout.strip().startswith(b\"Z\")\n\n\ndef assert_stopped(identities: list[ProcessIdentity]) -> None:\n    assert len(identities) == 2\n    deadline = time.monotonic() + 3\n    while time.monotonic() < deadline:\n        if all(stopped(identity.pid) for identity in identities):\n            return\n        time.sleep(0.02)\n    assert all(stopped(identity.pid) for identity in identities)\n\n\ndef clean_survivors(identities: list[ProcessIdentity]) -> None:\n    for identity in identities:\n        if process_matches(identity):\n            try:\n                os.kill(identity.pid, signal.SIGKILL)\n            except ProcessLookupError:\n                pass\n\n\ndef capture_ownership(h: Harness, identities: list[ProcessIdentity], line: str) -> None:\n    for pid in json.loads(line).values():\n        identity = process_identity(pid)\n        assert identity is not None\n        identities.append(identity)\n    assert h.paths.run_metadata.is_file()\n    registry = FleetRegistry(h.paths.fleet_root).snapshot()\n    assert len(registry.live) == 1\n    assert not registry.malformed and not registry.stale\n\n\ndef assert_fleet_empty(h: Harness) -> None:\n    registry = FleetRegistry(h.paths.fleet_root).snapshot()\n    assert not registry.live\n    assert not registry.malformed\n    assert not registry.stale\n\n\ndef test_watchdog_times_out_and_kills_the_whole_owned_group(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n    adapter: str,\n) -> None:\n    h = harness(tmp_path, monkeypatch, adapter)\n    h.driver.steps = [Step(code=GROUP_CODE), Step(code=GROUP_CODE)]\n    identities: list[ProcessIdentity] = []\n    h.driver.on_line = lambda line: capture_ownership(h, identities, line)\n    started = time.monotonic()\n    try:\n        outcome = h.supervisor().run()\n        assert outcome.exit_code == 1 and outcome.decision.kind == DecisionKind.HALT\n        assert time.monotonic() - started < 12\n        assert_stopped(identities[:2])\n        if len(identities) == 4:\n            assert_stopped(identities[2:])\n        assert 1 <= outcome.sessions_attempted <= 2\n        for request in h.driver.requests:\n            summary = json.loads((request.session_dir / \"summary.json\").read_text())\n            assert summary[\"timed_out\"] is True\n            assert summary[\"signal\"] == signal.SIGKILL\n            assert summary[\"returncode\"] == -signal.SIGKILL\n            assert summary[\"detail\"] == \"session timed out\"\n        assert len(reconcile_metrics(h.paths)) == outcome.sessions_attempted\n        assert not h.paths.run_metadata.exists()\n        assert_fleet_empty(h)\n    finally:\n        clean_survivors(identities)\n\n\n@pytest.mark.parametrize(\"number\", [signal.SIGINT, signal.SIGTERM, signal.SIGHUP])\ndef test_signal_returns_shell_exit_and_finalizes_evidence_after_group_cleanup(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n    adapter: str,\n    number: signal.Signals,\n) -> None:\n    h = harness(tmp_path, monkeypatch, adapter)\n    h.driver.steps = [Step(code=GROUP_CODE)]\n    identities: list[ProcessIdentity] = []\n    timers: list[threading.Timer] = []\n\n    def observed(line: str) -> None:\n        capture_ownership(h, identities, line)\n        timer = threading.Timer(0.05, os.kill, args=(os.getpid(), number))\n        timers.append(timer)\n        timer.start()\n\n    h.driver.on_line = observed\n    try:\n        outcome = h.supervisor().run()\n        assert outcome.exit_code == 128 + number and outcome.sessions_attempted == 1\n        assert_stopped(identities)\n        (request,) = h.driver.requests\n        assert rows(request.session_dir / \"raw.jsonl\")\n        summary = json.loads((request.session_dir / \"summary.json\").read_text())\n        assert summary[\"timed_out\"] is False\n        assert summary[\"signal\"] == signal.SIGKILL\n        assert summary[\"returncode\"] == -signal.SIGKILL\n        assert summary[\"detail\"] == \"supervisor signal\"\n        (metric,) = reconcile_metrics(h.paths)\n        assert metric.finished_at is not None and metric.decision is not None\n        assert not h.paths.run_metadata.exists()\n        assert_fleet_empty(h)\n    finally:\n        for timer in timers:\n            timer.cancel()\n            timer.join(timeout=1)\n        clean_survivors(identities)\n\n\ndef test_duplicate_run_ownership_is_refused_without_launch_or_owner_removal(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n    adapter: str,\n) -> None:\n    h = harness(tmp_path, monkeypatch, adapter)\n    with RunLock.acquire(h.paths.run_lock):\n        with pytest.raises(DuplicateRunError):\n            h.supervisor().run()\n        assert h.driver.requests == []\n        assert not h.paths.run_metadata.exists()\n        assert_fleet_empty(h)\n        with pytest.raises(DuplicateRunError), RunLock.acquire(h.paths.run_lock):\n            pytest.fail(\"duplicate run released another owner's lock\")\n    with RunLock.acquire(h.paths.run_lock):\n        assert h.driver.requests == []\n\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom dataclasses import replace\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport pytest\nfrom tests.runtime.test_supervisor import Harness, add_capability, harness, rows\n\nfrom ovcaq.config import AgentSettings\nfrom ovcaq.drivers.claude import ClaudeDriver\nfrom ovcaq.drivers.codex import CodexDriver\nfrom ovcaq.paths import state_path\nfrom ovcaq.runtime.decision import DecisionKind\nfrom ovcaq.runtime.session import reconcile_metrics\nfrom ovcaq.runtime.supervisor import Supervisor\nfrom ovcaq.state.schema import State\nfrom ovcaq.state.store import StateStore\n\n\ndef adapter_harness(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Harness:\n    h = harness(tmp_path, monkeypatch)\n    monkeypatch.setattr(h.clock, \"now\", lambda: datetime.now(UTC))\n    committed = h.store.read()\n    canonical = state_path(h.root)\n    canonical.parent.mkdir(parents=True, exist_ok=True)\n    h.store = StateStore(canonical)\n    h.store.initialize(committed)\n    h.paths = replace(h.paths, state_file=canonical)\n    h.settings = replace(h.settings, runtime=replace(h.settings.runtime, paths=h.paths))\n    home = tmp_path / \"home\"\n    home.mkdir()\n    monkeypatch.setenv(\"HOME\", str(home))\n    monkeypatch.setenv(\"XDG_STATE_HOME\", str(tmp_path / \"state-home\"))\n    return h\n\n\ndef workflow_agent(h: Harness, tmp_path: Path, provider: str) -> AgentSettings:\n    fixtures = Path(__file__).parents[1] / \"fixtures\"\n    fake = fixtures / \"codex/v1/fake_codex.py\"\n    if provider == \"claude\":\n        fake = tmp_path / \"fake_claude_workflow.py\"\n        fake.write_text(\n            \"import runpy\\n\"\n            f\"edge = runpy.run_path({str(fixtures / 'codex/v1/fake_codex.py')!r})\\n\"\n            f\"edge['workflow'].__globals__['__file__'] = {str(fixtures / 'claude/v1/fake_claude.py')!r}\\n\"\n            \"raise SystemExit(edge['workflow']())\\n\"\n        )\n    command = [sys.executable, str(fake)]\n    environment = {\n        \"OVCAQ_FAKE_SCENARIO\": \"workflow\",\n        \"OVCAQ_FAKE_CLI\": str(Path(sys.executable).with_name(\"ovcaq\")),\n    }\n    (h.root / \"ovcaq.toml\").write_text(\n        f\"agent = {json.dumps(provider)}\\n\"\n        f\"[agents.{provider}]\\ncommand = {json.dumps(command)}\\n\"\n        'tiers = { sonnet = \"model-s\", opus = \"model-o\" }\\n'\n        \"[workflow]\\nruntime_root = 'runtime'\\n\"\n        f\"state_file = {json.dumps(str(h.paths.state_file))}\\n\"\n    )\n    options: dict[str, object] = {\"allow_explicit_model\": True}\n    if provider == \"claude\":\n        options[\"permission_mode\"] = \"auto\"\n    return AgentSettings(\n        provider,\n        tuple(command),\n        {\"sonnet\": \"model-s\", \"opus\": \"model-o\"},\n        environment,\n        options,\n    )\n\n\ndef prepare_workflow(h: Harness) -> tuple[str, dict[str, object], State]:\n    backlog = h.root / \"docs/dev/project-management/prds/backlog\"\n    backlog.mkdir(parents=True)\n    name = \"00001-fixture.md\"\n    (backlog / name).write_text(\"# Fixture PRD\\n\")\n    historical = {\n        \"filename\": \"00000-prior.md\",\n        \"cycles\": 1,\n        \"autonomous_decisions\": 0,\n        \"escalated_decisions\": 0,\n        \"tasks_completed\": 1,\n        \"tasks_total\": 1,\n    }\n\n    def prepare(state: State) -> None:\n        state[\"work\"][\"prd\"] = name\n        state[\"batch\"][\"completed_prds\"].append(historical.copy())\n        add_capability(state)\n\n    initial = h.store.transaction(prepare)\n    return name, historical, initial\n\n\ndef assert_handoff(\n    session: Path, phase: str, target: str, historical: dict[str, object], name: str\n) -> int:\n    raw = rows(session / \"raw.jsonl\")\n    commands = [row for row in raw if row.get(\"type\") == \"fake_workflow_command\"]\n    handoffs = [row for row in raw if row.get(\"type\") == \"fake_workflow_handoff\"]\n    assert len(handoffs) == 1 and handoffs[0][\"phase\"] == phase\n    assert handoffs[0][\"result\"] == {\"phase\": target or \"done\", \"next_phase\": target}\n    verbs = [row[\"argv\"][4:6] for row in commands]\n    assert (\n        verbs\n        == {\n            \"build\": [\n                [\"state\", \"show\"],\n                [\"workflow\", \"select\"],\n                [\"state\", \"show\"],\n                [\"workflow\", \"phase-complete\"],\n            ],\n            \"review\": [[\"state\", \"show\"], [\"workflow\", \"phase-complete\"]],\n            \"done\": [\n                [\"state\", \"show\"],\n                [\"workflow\", \"complete-prd\"],\n                [\"state\", \"show\"],\n                [\"workflow\", \"phase-complete\"],\n            ],\n        }[phase]\n    )\n    # Only the launched phase runs: the sole handoff is the last CLI call.\n    before_handoff = commands[-2][\"result\"]\n    assert before_handoff[\"work\"][\"phase\"] == phase\n    assert commands[-1][\"argv\"][-1] == str(before_handoff[\"revision\"])\n    assert handoffs[0][\"revision\"] == before_handoff[\"revision\"] + 1\n    if phase == \"done\":\n        assert commands[0][\"result\"][\"batch\"][\"completed_prds\"] == [historical]\n        assert commands[1][\"result\"][\"result\"][\"filename\"] == name\n        assert before_handoff[\"revision\"] == commands[0][\"result\"][\"revision\"] + 1\n        assert [\n            item[\"filename\"] for item in before_handoff[\"batch\"][\"completed_prds\"]\n        ] == [historical[\"filename\"], name]\n    return handoffs[0][\"revision\"]\n\n\ndef assert_retained_evidence(\n    session: Path, phase: str, target: str, provider: str\n) -> None:\n    assert rows(session / \"normalized.jsonl\")\n    summary = json.loads((session / \"summary.json\").read_text())\n    assert summary[\"returncode\"] == 0 and summary[\"timed_out\"] is False\n    (retained_metric,) = rows(session / \"metrics.jsonl\")\n    assert retained_metric[\"phase_launched\"] == phase\n    assert retained_metric[\"phase_end\"] == (target or \"done\")\n    assert retained_metric[\"finished_at\"] is not None\n    assert json.loads((session / \"meta.json\").read_text())[\"agent\"] == provider\n\n\ndef assert_completed_results(final: dict, historical: dict, name: str) -> None:\n    assert final[\"work\"][\"phase\"] == \"done\" and final[\"work\"][\"next_phase\"] == \"\"\n    assert final[\"batch\"][\"completed_prds\"][0] == historical\n    assert [item[\"filename\"] for item in final[\"batch\"][\"completed_prds\"]] == [\n        historical[\"filename\"],\n        name,\n    ]\n    assert final[\"batch\"][\"capabilities\"][\"audit\"][\"status\"] == \"succeeded\"\n\n\n@pytest.mark.parametrize(\"provider\", [\"claude\", \"codex\"])\ndef test_builtin_fake_command_handoffs_drain_and_retain_completed_results(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n    provider: str,\n) -> None:\n    h = adapter_harness(tmp_path, monkeypatch)\n    agent = workflow_agent(h, tmp_path, provider)\n    name, historical, initial = prepare_workflow(h)\n    driver = (\n        ClaudeDriver(agent, run_id=\"fake-drain\")\n        if provider == \"claude\"\n        else CodexDriver(agent, run_id=\"fake-drain\")\n    )\n    supervisor = Supervisor(\n        h.root,\n        store=h.store,\n        driver=driver,\n        settings=h.settings,\n        capability_runner=lambda _: h.runner,\n        clock=h.clock,\n        sleeper=h.waits.append,\n    )\n    outcome = supervisor.run()\n    assert outcome.exit_code == 0 and outcome.decision.kind == DecisionKind.COMPLETE\n    assert outcome.sessions_attempted == 3 and len(h.runner.requests) == 1\n    metrics = reconcile_metrics(h.paths)\n    assert [metric.kind for metric in metrics] == [\"phase\"] * 3 + [\"capability\"]\n    assert [metric.phase_launched for metric in metrics[:3]] == [\n        \"build\",\n        \"review\",\n        \"done\",\n    ]\n    assert len({metric.session_id for metric in metrics}) == 4\n    assert all(metric.finished_at is not None for metric in metrics)\n    revisions = []\n    for metric, phase, target in zip(\n        metrics[:3],\n        (\"build\", \"review\", \"done\"),\n        (\"review\", \"done\", \"\"),\n        strict=True,\n    ):\n        session = h.paths.sessions / metric.session_id\n        revisions.append(assert_handoff(session, phase, target, historical, name))\n        assert_retained_evidence(session, phase, target, provider)\n    assert initial[\"revision\"] < revisions[0] < revisions[1] < revisions[2]\n    final = h.store.read()\n    assert_completed_results(final, historical, name)\n    assert (\n        json.loads((h.paths.reports / \"batch-1-state-final.json\").read_text()) == final\n    )\n\n","exit_code":0,"status":"completed"}}
