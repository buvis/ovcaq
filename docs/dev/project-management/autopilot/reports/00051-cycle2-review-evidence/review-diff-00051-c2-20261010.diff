n48:\\n49:def make_summary(**changes: Any) -> SessionSummary:\\n50:    fields = {\\n51:        \\\"success\\\": False,\\n52:        \\\"session_id\\\": \\\"session-1\\\",\\n53:        \\\"failure_class\\\": FailureClass.AGENT,\\n54:        \\\"failure_detail\\\": \\\"request failed\\\",\\n55:        \\\"rate_limit_reset_at\\\": None,\\n56:        \\\"usage\\\": None,\\n57:    }\\n58:    fields.update(changes)\\n59:    return SessionSummary(**fields)\\n60:\\n61:\\n62:def assert_scalar_json(value: object) -> None:\\n63:    if isinstance(value, dict):\\n64:        for key, child in value.items():\\n65:            key.encode(\\\"utf-8\\\", errors=\\\"strict\\\")\\n66:            assert_scalar_json(child)\\n67:    elif isinstance(value, list):\\n68:        for child in value:\\n69:            assert_scalar_json(child)\\n70:    elif isinstance(value, str):\\n71:        value.encode(\\\"utf-8\\\", errors=\\\"strict\\\")\\n72:\\n73:\\n74:def replace_record_string(value: Any, original: str, replacement: str) -> Any:\\n75:    if isinstance(value, dict):\\n76:        return {\\n77:            replacement if key == original else key: replace_record_string(\\n78:                child, original, replacement\\n79:            )\\n80:            for key, child in value.items()\\n81:        }\\n82:    if isinstance(value, list):\\n83:        return [replace_record_string(child, original, replacement) for child in value]\\n84:    return replacement if value == original else value\\n85:\\n86:\\n87:@pytest.mark.parametrize(\\\"scalar\\\", INVALID_SCALARS, ids=[\\\"high\\\", \\\"low\\\"])\\n88:@pytest.mark.parametrize(\\\"field\\\", [\\\"provider\\\", \\\"run_id\\\", \\\"session_id\\\", \\\"lane_id\\\"])\\n89:def test_observation_rejects_invalid_scalar_identifiers(field: str, scalar: str) -> None:\\n90:    with pytest.raises(ValueError, match=SCALAR_ERROR):\\n91:        make_observation(**{field: f\\\"prefix{scalar}suffix\\\"})\\n92:\\n93:\\n94:@pytest.mark.parametrize(\\\"scalar\\\", INVALID_SCALARS, ids=[\\\"high\\\", \\\"low\\\"])\\n95:@pytest.mark.parametrize(\\n96:    \\\"location\\\", [\\\"value\\\", \\\"nested_value\\\", \\\"nested_key\\\", \\\"tuple\\\", \\\"tuple_key\\\", \\\"secret\\\"]\\n97:)\\n98:def test_observation_rejects_invalid_scalars_recursively_in_payload(\\n99:    location: str, scalar: str\\n100:) -> None:\\n101:    payloads = {\\n102:        \\\"value\\\": {\\\"message\\\": scalar},\\n103:        \\\"nested_value\\\": {\\\"message\\\": [\\\"valid\\\", {\\\"nested\\\": scalar}]},\\n104:        \\\"nested_key\\\": {\\\"message\\\": [\\\"valid\\\", {scalar: \\\"valid\\\"}]},\\n105:        \\\"tuple\\\": {\\\"message\\\": (\\\"valid\\\", {\\\"nested\\\": scalar})},\\n106:        \\\"tuple_key\\\": {\\\"message\\\": (\\\"valid\\\", {scalar: \\\"valid\\\"})},\\n107:        \\\"secret\\\": {\\\"message\\\": \\\"valid\\\", \\\"password\\\": scalar},\\n108:    }\\n109:    with pytest.raises(ValueError, match=SCALAR_ERROR):\\n110:        make_observation(payload=payloads[location])\\n111:\\n112:\\n113:@pytest.mark.parametrize(\\\"scalar\\\", INVALID_SCALARS, ids=[\\\"high\\\", \\\"low\\\"])\\n114:@pytest.mark.parametrize(\\\"field\\\", [\\\"session_id\\\", \\\"failure_detail\\\"])\\n115:def test_summary_rejects_invalid_scalar_strings(field: str, scalar: str) -> None:\\n116:    with pytest.raises(ValueError, match=SCALAR_ERROR):\\n117:        make_summary(**{field: f\\\"prefix{scalar}suffix\\\"})\\n118:\\n119:\\n120:@pytest.mark.parametrize(\\\"scalar\\\", INVALID_SCALARS, ids=[\\\"high\\\", \\\"low\\\"])\\n121:@pytest.mark.parametrize(\\n122:    \\\"location\\\", [\\\"root\\\", \\\"list\\\", \\\"tuple\\\", \\\"value\\\", \\\"nested_key\\\", \\\"tuple_key\\\", \\\"secret\\\"]\\n123:)\\n124:def test_sanitize_json_rejects_invalid_scalars_before_redaction(\\n125:    location: str, scalar: str\\n126:) -> None:\\n127:    values = {\\n128:        \\\"root\\\": scalar,\\n129:        \\\"list\\\": [\\\"valid\\\", scalar],\\n130:        \\\"tupl