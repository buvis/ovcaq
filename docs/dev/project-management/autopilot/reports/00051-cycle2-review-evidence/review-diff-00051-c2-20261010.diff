"full\",\n        \"self_deslop\": \"skipped:trivial\",\n        \"style_gate\": \"clean\",\n        \"split_hygiene\": \"clean\",\n        \"devon\": \"exploit_fixed\",\n        \"devon_weak_points\": 8,\n        \"devon_exploit\": \"Finite scalar fixtures allowed partial validation across types, depths, positions and subclasses\"\n      }\n    ]\n  },\n  {\n    \"id\": \"2\",\n    \"status\": \"completed\",\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"model\": \"opus\",\n        \"actual_model\": \"gpt-6-astra\",\n        \"actual_provider\": \"openai\",\n        \"outcome\": \"completed\",\n        \"review_cycle\": null,\n        \"cause\": null,\n        \"implementor\": \"codex\",\n        \"preflight_outcome\": null,\n        \"pipeline\": \"full\",\n        \"self_deslop\": \"skipped:trivial\",\n        \"style_gate\": \"fixed:b46d9e9\",\n        \"split_hygiene\": \"clean\"\n      },\n      {\n        \"attempt\": 2,\n        \"model\": \"opus\",\n        \"actual_model\": \"gpt-6.1-sol\",\n        \"actual_provider\": \"openai\",\n        \"outcome\": \"completed\",\n        \"review_cycle\": null,\n        \"cause\": null,\n        \"implementor\": \"codex\",\n        \"pipeline\": \"full\",\n        \"self_deslop\": \"skipped:test-only\",\n        \"style_gate\": \"clean\",\n        \"split_hygiene\": \"clean\",\n        \"review\": \"skipped:test-only\"\n      }\n    ]\n  },\n  {\n    \"id\": \"3\",\n    \"status\": \"completed\",\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"model\": \"opus\",\n        \"actual_model\": \"gpt-6.1-sol\",\n        \"actual_provider\": \"openai\",\n        \"outcome\": \"completed\",\n        \"review_cycle\": null,\n        \"cause\": null,\n        \"implementor\": \"codex\",\n        \"preflight_outcome\": null,\n        \"pipeline\": \"full\",\n        \"self_deslop\": \"skipped:trivial\",\n        \"style_gate\": \"clean\",\n        \"split_hygiene\": \"clean\",\n        \"dev