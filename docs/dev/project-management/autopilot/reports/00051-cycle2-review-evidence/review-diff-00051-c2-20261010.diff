+@pytest.mark.parametrize("scalar", INVALID_SCALARS, ids=SCALAR_IDS)
+@pytest.mark.parametrize("location", ["value", "nested_key", "secret"])
+def test_completion_record_decoder_rejects_invalid_scalars_before_redaction(
