+def assert_frame_values(text: str, state: dict[str, object]) -> None:
+    work = state["work"]
+    assert re.search(rf"(?<![\w.-]){re.escape(work['prd'])}(?![\w.-])", text)
+    assert re.search(
+        rf"(?<!\d){work['tasks_completed']}\s*/\s*{work['tasks_total']}(?!\d)",
+        text,
+    )
