+@pytest.mark.parametrize("action", ["pause", "resume"])
+def test_control_commit_last_boundary_identity_replacement_rolls_back(
+    fleet: Fleet,
+    monkeypatch: pytest.MonkeyPatch,
+    action: str,
+) -> None:
