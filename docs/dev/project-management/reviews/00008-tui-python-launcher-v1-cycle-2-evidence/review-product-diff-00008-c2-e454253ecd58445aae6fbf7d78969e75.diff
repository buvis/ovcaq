+            telemetry="partial",
+            gaps=("Selected run ended; final evidence unavailable",),
+            ended=True,
+        )
+
+    def poll(self) -> ProjectView:
+        self.polls += 1
+        if self.polls > 1:
+            pytest.fail("viewer polled an ended selection again")
