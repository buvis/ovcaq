+def wait_for_reviewer_quota(result: Result, cwd: Path, deadline: float) -> bool:
+    reset = result.events.quota_reset
+    if result.ok or result.capped or result.events.api_status != 429 or reset is None:
+        return False
+    delay = reset - time.time()
+    # Do not spin on stale resets, infer timestamps from prose, or retry early.
+    if delay <= 0 or delay + 5 >= deadline - time.monotonic():
+        return False
+    target = time.monotonic() + delay + 5
+    reset_label = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(reset))
+    print(
+        f"autocodex: Claude quota exhausted; waiting until {reset_label} + 5s; raw={result.log}",
+        flush=True,
+    )
+    pause = cwd / "dev/local/autopilot/pause-requested"
+    while True:
+        if pause.exists() or time.monotonic() >= deadline:
+            return False
+        remaining = target - time.monotonic()
+        if remaining <= 0:
+            return True
+        time.sleep(min(60, remaining))
+
+
+def run_reviewer(prompt: str, output: Path, model: str, cwd: Path, binary: str) -> Result:
+    env = reviewer_env(dict(os.environ))
+    cap = float(env.get("_AUTOPILOT_SESSION_MAX_REVIEW", "10800"))
+    parent_deadline = float(env.get("AUTOCODEX_SESSION_DEADLINE", str(time.time() + cap)))
+    cap = min(cap, parent_deadline - time.time())
+    if not math.isfinite(cap) or cap <= 0:
+        raise ValueError("no reviewer session time remaining")
+    deadline = time.monotonic() + cap
+    wait_deadline = min(
+        deadline, time.monotonic() + int(env.get("_AUTOPILOT_LIMIT_WAIT_MAX", "21600"))
+    )
+    while True:
+        stem = output.parent / f"{output.stem}-{uuid.uuid4().hex}"
+        result = run_process(
+            claude_argv(binary, model),
+            prompt,
+            cwd,
+            env,
+            stem,
+            deadline - time.monotonic(),
+            provider="claude",
+        )
+        if not wait_for_reviewer_quota(result, cwd, wait_deadline):
+            return result
+        print("autocodex: Claude quota reset reached; retrying reviewer", flush=True)
+
