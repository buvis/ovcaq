+
+
+@pytest.mark.parametrize("phase", ("paused", "", "unknown", "BUILD", " build"))
+def test_claude_default_prompt_rejects_nonroutable_phases(
+    driver: ClaudeDriver, phase: str
+) -> None:
+    with pytest.raises(ValueError):
+        driver.default_prompt(phase)
