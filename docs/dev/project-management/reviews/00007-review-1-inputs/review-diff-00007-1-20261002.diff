+) -> None:
+    root, cwd, environment = _project(installed_wheel, tmp_path)
+    before = _state(root)
+    failure = _failure(_run(installed_wheel, environment, cwd, "run"))
+    assert failure["error"]["code"] == "usage" and _state(root) == before
+    paused = _success(
+        _run(installed_wheel, environment, cwd, "pause", "--reason", "maintenance")
