+from __future__ import annotations
+
+import ast
+import tomllib
+from collections import Counter
+from pathlib import Path
+
+import pytest
+
+TESTS = Path(__file__).parents[1]
+ROOT = TESTS.parent
+CHARACTERIZATION = TESTS / "characterization"
+
+
+def _load(name: str) -> dict[str, object]:
+    return tomllib.loads((CHARACTERIZATION / name).read_text())
+
+
+def _routed_ids() -> set[str]:
+    inventory = {item["id"] for item in _load("current_system.toml")["items"]}
+    routed = {
+        id_
+        for route in _load("migration.toml")["routes"]
+        if route["owner_prd"] == "00007" and route["owner_phase"] == 5
+        for id_ in route["ids"]
+    }
+    assert routed <= inventory
+    return routed
+
+
+MATRIX = _load("phase5-parity.toml")["rows"]
+
+
+def test_matrix_covers_exactly_the_phase5_routed_inventory_ids() -> None:
+    ids = Counter(row["id"] for row in MATRIX)
+    routed = _routed_ids()
+    assert len(routed) == 69
+    assert [id_ for id_, count in ids.items() if count > 1] == []
+    assert set(ids) - routed == set()
+    assert routed - set(ids) == set()
+
+
+@pytest.mark.parametrize("row", MATRIX, ids=lambda row: row["id"])
+def test_every_row_has_one_well_formed_disposition(row: dict[str, str]) -> None:
+    assert row["disposition"] in {"implemented", "retired"}
+    if row["disposition"] == "retired":
+        assert row.get("rationale", "").strip()
+        assert not {"destination", "node"} & row.keys()
+        return
+    assert (ROOT / row["destination"]).is_file()
+    path, _, name = row["node"].partition("::")
+    assert "[" not in name
+    tree = ast.parse((ROOT / path).read_text())
+    assert name in {
+        node.name for node in tree.body if isinstance(node, ast.FunctionDef)
+    }, f"{row['node']} does not exist"
