+def _state() -> State:
+    state = new_state(repo_root=Path("/tmp/decision-contract"))
+    state["batch"]["id"] = "batch-1"
+    state["batch"]["status"] = "running"
+    state["work"]["prd"] = "00001-feature.md"
+    return state
