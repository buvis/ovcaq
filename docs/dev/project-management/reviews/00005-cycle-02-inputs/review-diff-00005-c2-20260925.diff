+            sys.executable,
+            "-c",
+            (
+                "import signal, sys, time; "
+                f"signal.signal(signal.SIGTERM, {handler}); "
+                "signal.alarm(15); print('ready', flush=True); time.sleep(15)"
+            ),
+        ],
+        cwd=tmp_path,
+    )
+    assert _line(owned.stdout) == b"ready\n"
