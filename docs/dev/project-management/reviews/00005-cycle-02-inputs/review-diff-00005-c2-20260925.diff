+    _emergency(paths)
+    marker = runtime / "state-write-failed.json"
+    marker_bytes = marker.read_bytes()
+    state = runtime / "state.json"
+    state_bytes = state.read_bytes()
+    with monkeypatch.context() as boundary:
+        _deny_repeated_state_read(state, boundary)
