#!/usr/bin/env python3
"""Report whether a PRD's prerequisites are met in the current project.

Prints one JSON line. Exit 0 when ready, 1 when something is missing,
2 on a usage or config error (message on stderr, nothing on stdout).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import tomllib
from pathlib import Path
from typing import NoReturn

DONE = Path("docs") / "dev" / "project-management" / "prds" / "done"
DEPENDENCIES: dict[int, tuple[int, ...]] = {
    58: (57, 62),
    59: (58, 63),
    60: (59,),
    61: (60,),
    64: (58,),
    65: (60, 61, 64),
}
# PRD -> (config table, artifact path key, required evidence tokens)
GATES: dict[int, tuple[str, str, tuple[str, ...]]] = {
    58: ("workflow", "controller_artifact", ("core", "jobs", "reviews", "records")),
    61: ("autopilot", "plugin_artifact", ("AP00017",)),
    65: ("operator", "client_artifact", ("Lantern00003",)),
}
# PRD -> config key naming a read-only precondition path in the same table
BUNDLES: dict[int, str] = {58: "contract_bundle"}
MAX_ARTIFACT_BYTES = 16 * 1024 * 1024


def refuse(message: str) -> NoReturn:
    print(f"autopilot-prerequisites: {message}", file=sys.stderr)
    sys.exit(2)


def is_done(prd: int) -> bool:
    if DONE.is_symlink() or not DONE.is_dir():
        return False
    pattern = re.compile(rf"{prd:05d}-.+\.md")
    try:
        return any(
            pattern.fullmatch(entry.name) and entry.is_file(follow_symlinks=False)
            for entry in os.scandir(DONE)
        )
    except OSError:
        return False


def load_config(config: Path, explicit: bool) -> dict[str, object]:
    """Read the config file, or refuse when it cannot be used."""
    try:
        with config.open("rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError:
        if explicit:
            refuse(f"config file not found: {config}")
        return {}
    except (OSError, ValueError, RecursionError) as error:
        refuse(f"cannot read config {config}: {error}")


def read_section(prd: int, settings: dict[str, object]) -> dict[str, object]:
    """Return the PRD's config table, empty when unset, refusing bad shapes."""
    table, key, _ = GATES[prd]
    section = settings.get(table)
    if section is None:
        return {}
    if not isinstance(section, dict):
        refuse(f"[{table}] must be a table")
    names = [key, f"{key}_sha256"]
    bundle = BUNDLES.get(prd)
    if bundle is not None:
        names.append(bundle)
    for name in names:
        value = section.get(name)
        if value is not None and not isinstance(value, str):
            refuse(f"[{table}] {name} must be a string")
    return section


def check_path(name: str, path: str) -> str | None:
    """Return a message unless path names a regular file reached without links."""
    probe = Path(path)
    try:
        if os.path.realpath(probe) != os.path.abspath(probe):
            return f"{name}: {path} must not traverse a symlink"
    except ValueError:
        return f"{name}: {path} is not a usable path"
    if not probe.is_file():
        return f"{name}: {path} is not a regular file"
    return None


def check_artifact(prd: int, section: dict[str, object]) -> str | None:
    """Return a missing-artifact message, or None when the gate is met."""
    table, key, tokens = GATES[prd]
    path, digest = section.get(key), section.get(f"{key}_sha256")
    if not isinstance(path, str) or not isinstance(digest, str):
        return f"{key}: [{table}] needs {key} and {key}_sha256"
    gap = check_path(key, path)
    if gap is not None:
        return gap
    try:
        # Hash and parse the same capped bytes, so the file cannot change in between.
        with Path(path).open("rb") as handle:
            data = handle.read(MAX_ARTIFACT_BYTES + 1)
    except OSError as error:
        return f"{key}: cannot read {path}: {error}"
    if len(data) > MAX_ARTIFACT_BYTES:
        return f"{key}: {path} exceeds 16 MiB"
    if hashlib.sha256(data).hexdigest() != digest.lower():
        return f"{key}: {path} sha256 does not match {key}_sha256"
    try:
        payload = json.loads(data)
    except (ValueError, RecursionError):
        return f"{key}: {path} is not valid JSON"
    evidence = payload.get("evidence") if isinstance(payload, dict) else None
    if not isinstance(evidence, list):
        return f"{key}: {path} has no evidence list"
    absent = [token for token in tokens if token not in evidence]
    if absent:
        return f"{key}: {path} evidence list lacks {', '.join(absent)}"
    return None


def check_bundle(prd: int, section: dict[str, object]) -> str | None:
    """Return a missing-precondition message, or None when the path is usable."""
    table, _, _ = GATES[prd]
    name = BUNDLES[prd]
    path = section.get(name)
    if not isinstance(path, str):
        return f"{name}: [{table}] needs {name}"
    return check_path(name, path)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prd", required=True, help="PRD number, e.g. 58 or 00058")
    parser.add_argument("--config", help="config file (default: ./ovcaq.toml)")
    args = parser.parse_args()
    if (
        len(args.prd) > 5
        or not re.fullmatch(r"[0-9]+", args.prd)
        or int(args.prd) not in DEPENDENCIES
    ):
        parser.error(f"unknown PRD: {args.prd!r}")
    prd = int(args.prd)
    settings = load_config(Path(args.config or "ovcaq.toml"), args.config is not None)
    section = read_section(prd, settings) if prd in GATES else {}

    missing = [
        f"PRD {dep:05d} is not in {DONE.as_posix()}"
        for dep in DEPENDENCIES[prd]
        if not is_done(dep)
    ]
    if prd in GATES:
        gaps = [check_artifact(prd, section)]
        if prd in BUNDLES:
            gaps.append(check_bundle(prd, section))
        missing.extend(gap for gap in gaps if gap is not None)

    if missing:
        print(json.dumps({"ready": False, "prd": args.prd, "missing": missing}))
        sys.exit(1)
    print(json.dumps({"ready": True, "prd": args.prd}))


if __name__ == "__main__":
    main()
